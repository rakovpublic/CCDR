# -------------------------- Round-10 v23 confirm hardening patch --------------------------
# Implements 10 additional confirm-oriented improvements on top of v22 without
# removing historical runners.  The manifest still points at v22 names; these
# wrappers override those RUNNERS keys so old test files automatically use v23.
import csv as _csv_v23
import io as _io_v23
import json as _json_v23
import math as _math_v23
import os as _os_v23
import random as _random_v23
import re as _re_v23
import statistics as _statistics_v23
import tarfile as _tarfile_v23
from pathlib import Path as _Path_v23
from typing import Any as _Any_v23, Dict as _Dict_v23, List as _List_v23, Optional as _Optional_v23, Sequence as _Sequence_v23, Tuple as _Tuple_v23

# Save v22 wrappers before overriding them with v23 versions.
_run_highz_unit_field_table_v22_for_v23 = run_highz_unit_field_table_v22
_run_p38_catalogue_nulls_v22_for_v23 = run_p38_catalogue_nulls_v22
_run_p30_maskrandom_freeze_v22_for_v23 = run_p30_maskrandom_freeze_v22
_run_nanograv_retry_cache_v22_for_v23 = run_nanograv_retry_cache_v22
_run_p33_density_bao_measured_scaffold_v22_for_v23 = run_p33_density_bao_measured_scaffold_v22
_run_p39_likelihood_gate_v22_for_v23 = run_p39_likelihood_gate_v22
_run_ringdown_strain_plan_v22_for_v23 = run_ringdown_strain_plan_v22
_run_p41_structured_cp_v22_for_v23 = run_p41_structured_cp_v22
_run_direct_detection_units_v22_for_v23 = run_direct_detection_units_v22
_run_hepdata_schema_hardened_v22_for_v23 = run_hepdata_schema_hardened_v22


def _v23_to_path(path: _Any_v23, root: _Optional_v23[_Path_v23] = None) -> _Optional_v23[_Path_v23]:
    if not path:
        return None
    s = str(path).replace('\\\\', _os_v23.sep).replace('\\', _os_v23.sep)
    p = _Path_v23(s)
    if p.exists():
        return p
    if root is None:
        root = _Path_v23.cwd()
    p2 = root / s
    return p2 if p2.exists() else None


def _v23_finite_float(x: _Any_v23) -> _Optional_v23[float]:
    try:
        v = float(x)
        return v if _math_v23.isfinite(v) else None
    except Exception:
        return None


def _v23_gate(**items: _Any_v23) -> _Dict_v23[str, _Any_v23]:
    missing = [k for k, v in items.items() if not bool(v)]
    out = {**items, 'eligible_for_confirm_like': not missing, 'missing': missing}
    return out


def _v23_strict_velocity_column(cols: _Sequence_v23[str]) -> _Optional_v23[str]:
    """Choose a rotation/velocity column while rejecting angle/position-angle columns.

    v22 allowed broad `vel` matches; this v23 filter prevents columns like VEL_PA
    (velocity-map position angle) from being counted as object-level Vrot evidence.
    """
    bad = _re_v23.compile(r'(?i)(^pa$|_pa\b|pos.?ang|angle|theta|phi|incl|ellip|sigma|disp|err|error)')
    strong = _re_v23.compile(r'(?i)(vrot|v_?rot|vmax|v_?max|vcirc|v_?circ|vflat|v_?flat|v2p2|v_?out|rotvel|rotation.?velocity)')
    weak = _re_v23.compile(r'(?i)(velocity|vel|kms|km.?s)')
    for c in cols:
        s = str(c)
        if bad.search(s):
            continue
        if strong.search(s):
            return s
    for c in cols:
        s = str(c)
        if bad.search(s):
            continue
        if weak.search(s):
            return s
    return None


def _v23_radius_column(cols: _Sequence_v23[str]) -> _Optional_v23[str]:
    bad = _re_v23.compile(r'(?i)(err|error|flag|pa|angle|ellip)')
    good = _re_v23.compile(r'(?i)(radius|r_?e\b|reff|r_eff|rhalf|r_?half|r_d\b|rd\b|rpsf|r_?kpc|size|semimajor)')
    for c in cols:
        s = str(c)
        if not bad.search(s) and good.search(s):
            return s
    return None


def _v23_redshift_column(cols: _Sequence_v23[str]) -> _Optional_v23[str]:
    for c in cols:
        if _re_v23.fullmatch(r'(?i)(z|zspec|z_spec|zphot|z_photo|redshift)', str(c)):
            return str(c)
    for c in cols:
        if _re_v23.search(r'(?i)(redshift|zspec|zphot)', str(c)):
            return str(c)
    return None


def _v23_table_to_columns_and_rows(path: _Path_v23, max_rows: int = 10000) -> _Tuple_v23[_List_v23[str], _List_v23[_Dict_v23[str, _Any_v23]], str]:
    """Read FITS/CSV/TSV/TXT into columns+row dicts with no hard dependency failures."""
    suffix = ''.join(path.suffixes).lower()
    if suffix.endswith(('.fits', '.fit')):
        try:
            from astropy.table import Table
            tab = Table.read(path)
            cols = [str(c) for c in tab.colnames]
            rows = []
            n = min(len(tab), max_rows)
            for i in range(n):
                row = {}
                for c in cols:
                    try:
                        v = tab[c][i]
                        try:
                            if hasattr(v, 'item'):
                                v = v.item()
                        except Exception:
                            pass
                        row[c] = v
                    except Exception:
                        pass
                rows.append(row)
            return cols, rows, 'fits_table'
        except Exception as e:
            return [], [], 'fits_error:' + str(e)[:120]
    try:
        txt = read_text_any(path, max_bytes=8_000_000)
    except Exception as e:
        return [], [], 'text_error:' + str(e)[:120]
    if _re_v23.search(r'(?is)<html|<!doctype|<body|<script', txt[:2000]):
        return [], [], 'html_rejected'
    lines = [ln for ln in txt.splitlines() if ln.strip() and not ln.lstrip().startswith('#')]
    if not lines:
        return [], [], 'empty_text'
    sample = '\n'.join(lines[:50])
    dialect = None
    try:
        dialect = _csv_v23.Sniffer().sniff(sample, delimiters=',\t; |')
    except Exception:
        pass
    try:
        if dialect:
            rdr = _csv_v23.DictReader(_io_v23.StringIO('\n'.join(lines)), dialect=dialect)
            rows = []
            for i, r in enumerate(rdr):
                if i >= max_rows: break
                rows.append(dict(r))
            return [str(c) for c in (rdr.fieldnames or [])], rows, 'delimited_text'
    except Exception:
        pass
    # Whitespace fallback.
    header = _re_v23.split(r'\s+', lines[0].strip())
    if len(header) >= 2 and any(_re_v23.search(r'(?i)(vrot|velocity|radius|redshift|z|kpc)', h) for h in header):
        rows = []
        for ln in lines[1:max_rows+1]:
            parts = _re_v23.split(r'\s+', ln.strip())
            if len(parts) >= len(header):
                rows.append(dict(zip(header, parts)))
        return header, rows, 'whitespace_header'
    return [], [], 'unrecognized_text_table'


def _v23_collect_candidate_paths(base: _Dict_v23[str, _Any_v23], args: argparse.Namespace, prefixes: _Sequence_v23[str] = ()) -> _List_v23[_Path_v23]:
    root = _Path_v23.cwd()
    raw = []
    for key in ('vrot_tables_v14', 'vrot_unit_audit_v16'):
        for item in base.get(key, []) or []:
            if isinstance(item, dict) and item.get('path'):
                raw.append(item.get('path'))
    gate = base.get('vrot_confirm_gate_v22') or {}
    raw.extend(gate.get('table_paths_preview') or [])
    paths = []
    seen = set()
    for r in raw:
        p = _v23_to_path(r, root)
        if p and str(p) not in seen:
            seen.add(str(p)); paths.append(p)
    return paths[:50]


def _v23_object_level_a0_audit(base: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    paths = _v23_collect_candidate_paths(base, args)
    conv = 1_000_000.0 / 3.0856775814913673e19  # (km/s)^2/kpc -> m/s^2
    table_reports = []
    all_vals = []
    table_medians = []
    false_velocity_rejections = []

    def scan_rows(label: str, cols: _List_v23[str], rows: _List_v23[_Dict_v23[str, _Any_v23]], source_type: str):
        nonlocal all_vals, table_medians, table_reports, false_velocity_rejections
        vcol = _v23_strict_velocity_column(cols)
        rcol = _v23_radius_column(cols)
        zcol = _v23_redshift_column(cols)
        # Record broad rejected velocity-like labels to make the VEL_PA issue visible.
        for c in cols:
            if _re_v23.search(r'(?i)vel|velocity', str(c)) and not vcol:
                false_velocity_rejections.append(str(c))
        vals = []
        zvals = []
        if vcol and rcol:
            for row in rows:
                vv = _v23_finite_float(row.get(vcol))
                rr = _v23_finite_float(row.get(rcol))
                zz = _v23_finite_float(row.get(zcol)) if zcol else None
                if vv is None or rr is None:
                    continue
                # Conservative astrophysical sanity gate for object-level rotation.
                if 20.0 <= abs(vv) <= 600.0 and 0.03 <= abs(rr) <= 200.0:
                    vals.append((abs(vv) * abs(vv) / abs(rr)) * conv)
                    if zz is not None and -0.01 <= zz <= 10:
                        zvals.append(zz)
        med = _statistics_v23.median(vals) if vals else None
        if vals:
            all_vals.extend(vals)
            table_medians.append(med)
        table_reports.append({
            'path': label,
            'source_type': source_type,
            'n_columns': len(cols),
            'columns_preview': [str(c) for c in cols[:40]],
            'strict_v_col': vcol,
            'r_col': rcol,
            'z_col': zcol,
            'n_object_v2_over_r': len(vals),
            'median_a_m_s2': med,
            'z_median': _statistics_v23.median(zvals) if zvals else None,
        })

    for p in paths:
        sp = str(p)
        low = sp.lower()
        if low.endswith(('.fits', '.fit', '.csv', '.tsv', '.txt', '.dat')):
            cols, rows, typ = _v23_table_to_columns_and_rows(p, max_rows=15000)
            scan_rows(sp, cols, rows, typ)
        elif low.endswith(('.tar.gz', '.tgz', '.tar')) and getattr(args, 'allow_large', False):
            # Safe bounded tar scan: small table members only, never full extraction.
            try:
                with _tarfile_v23.open(p, 'r:*') as tar:
                    n_members = 0
                    for m in tar.getmembers():
                        lname = m.name.lower()
                        if not m.isfile() or m.size > 80_000_000:
                            continue
                        if not lname.endswith(('.fits', '.fit', '.csv', '.tsv', '.txt', '.dat')):
                            continue
                        n_members += 1
                        if n_members > 6:
                            break
                        # FITS from stream is unreliable with all astropy backends; copy small member to cache temp.
                        f = tar.extractfile(m)
                        if not f:
                            continue
                        tmp = _Path_v23(args.cache_dir) / ('v23_member_' + _re_v23.sub(r'[^A-Za-z0-9_.-]+', '_', m.name)[-120:])
                        tmp.parent.mkdir(parents=True, exist_ok=True)
                        with open(tmp, 'wb') as out:
                            out.write(f.read())
                        cols, rows, typ = _v23_table_to_columns_and_rows(tmp, max_rows=15000)
                        scan_rows(sp + '::' + m.name, cols, rows, typ)
            except Exception as e:
                table_reports.append({'path': sp, 'source_type': 'tar_error', 'error': str(e)[:200]})
        else:
            table_reports.append({'path': sp, 'source_type': 'skipped_large_or_archive', 'reason': 'run with --allow-large for bounded tar member scan' if low.endswith(('.tar.gz','.tgz','.tar')) else 'unsupported'})

    local = 9.55e-11
    median = _statistics_v23.median(all_vals) if all_vals else None
    table_leave_one = []
    if len(table_medians) >= 2:
        for i in range(len(table_medians)):
            rest = table_medians[:i] + table_medians[i+1:]
            table_leave_one.append(_statistics_v23.median(rest))
    object_gate = _v23_gate(
        object_rows_ge_30=len(all_vals) >= 30,
        strict_velocity_column_found=any(r.get('strict_v_col') for r in table_reports),
        radius_column_found=any(r.get('r_col') for r in table_reports),
        median_above_local=(median is not None and median > local),
        leave_one_table_above_local=(bool(table_leave_one) and all(x > local for x in table_leave_one)),
        two_object_tables=sum(1 for r in table_reports if (r.get('n_object_v2_over_r') or 0) > 0) >= 2,
    )
    object_gate.update({
        'n_object_rows': len(all_vals),
        'median_object_a_m_s2': median,
        'local_sparc_a0_m_s2': local,
        'leave_one_table_medians': table_leave_one[:20],
        'false_velocity_rejections_preview': sorted(set(false_velocity_rejections))[:20],
        'promotion_rule': 'object-level high-z confirm requires strict Vrot column, radius column, >=30 rows, >=2 tables, median and leave-one-table medians above local SPARC a0.',
    })
    return {'table_reports': table_reports[:30], 'object_gate': object_gate}


# 1) P36: object-level V^2/R scanner + strict velocity-column audit.
def run_highz_unit_field_table_v23(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_highz_unit_field_table_v22_for_v23(meta, args)
    if getattr(args, 'quick', False) and not getattr(args, 'allow_large', False):
        base['object_level_v2r_gate_v23'] = {'quick_mode': True, 'eligible_for_confirm_like': False, 'reason': 'object-level table scan skipped in --quick mode'}
        return base
    audit = _v23_object_level_a0_audit(base, args)
    base['object_level_v2r_audit_v23'] = audit['table_reports']
    base['object_level_v2r_gate_v23'] = audit['object_gate']
    # Do not erase the v22 proxy confirmation, but expose stronger publication-grade promotion separately.
    if audit['object_gate'].get('eligible_for_confirm_like'):
        base['status'] = 'highz_a0_objectlevel_confirm_like'
    elif str(base.get('status','')).endswith('confirm_like'):
        base['claim_scope_v23'] = 'proxy_confirm_like_until_object_level_gate_passes'
    base['interpretation'] = 'P36 v23: adds strict object-level V^2/R audit and rejects broad velocity/PA columns as rotation evidence; v22 proxy confirm remains scoped unless object-level gate passes.'
    return base


# 2) P38: radius-preserving spatial/sector null when coordinate-like columns exist.
def _v23_void_spatial_null(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    rec, attempts = zenodo_record(str(meta.get('zenodo_record','7406035')), _Path_v23(args.cache_dir), args)
    if not rec:
        return {'available': False, 'reason': 'Zenodo metadata unavailable', 'attempts': attempts[:5]}
    files = rec.get('files', []) or []
    targets = []
    for f in files:
        key = str(f.get('key',''))
        if _re_v23.search(r'(?i)(holes|zobovoids|maximals|zonevoids).*\.(txt|dat|csv)$', key):
            url = (f.get('links') or {}).get('self') or (f.get('links') or {}).get('download')
            targets.append((key, url))
    reports = []
    rng = _random_v23.Random(getattr(args, 'seed', 12345))
    for key, url in targets[:6]:
        if not url:
            continue
        p, at = download_candidates([url], _Path_v23(args.cache_dir), meta.get('test_id','R10-T10') + '_v23_voidnull_' + key, args)
        attempts.extend(at)
        if not p:
            continue
        rows = sniff_table(read_text_any(p, max_bytes=12_000_000))
        if len(rows) < 50:
            reports.append({'key': key, 'path': str(p), 'n_rows': len(rows), 'available': False, 'reason': 'too_few_numeric_rows'})
            continue
        # Header-aware if possible; fallback assumes first 2-3 numeric columns are position-like and last positive column is radius-like.
        xs=[]; ys=[]; radii=[]
        for r in rows[:50000]:
            vals = [float(v) for v in r.values() if isinstance(v,(int,float)) and _math_v23.isfinite(float(v))]
            if len(vals) < 3:
                continue
            rr = vals[-1]
            # Some VAST holes have a quality/status integer at the end; choose largest positive among trailing columns as fallback radius.
            candidates = [v for v in vals[-4:] if v > 0]
            if candidates:
                rr = max(candidates)
            if rr <= 0:
                continue
            xs.append(vals[0]); ys.append(vals[1]); radii.append(rr)
        if len(radii) < 50:
            reports.append({'key': key, 'path': str(p), 'available': False, 'reason': 'no_position_radius_fallback'})
            continue
        # Sector anisotropy statistic: variance of sector median radii. Null shuffles radii over fixed angles, preserving radius distribution.
        sectors = []
        for x,y in zip(xs,ys):
            ang = _math_v23.atan2(y, x)
            sectors.append(int((ang + _math_v23.pi) / (2*_math_v23.pi) * 8) % 8)
        def sector_var(rad):
            meds=[]
            for s in range(8):
                arr=[r for r,ss in zip(rad,sectors) if ss==s]
                if len(arr)>=5: meds.append(_statistics_v23.median(arr))
            return _statistics_v23.pvariance(meds) if len(meds)>=3 else None
        obs = sector_var(radii)
        null=[]
        if obs is not None:
            for _ in range(128):
                sh = radii[:]
                rng.shuffle(sh)
                nv = sector_var(sh)
                if nv is not None: null.append(nv)
        p_high = sum(1 for x in null if x >= obs)/len(null) if null and obs is not None else None
        reports.append({'key': key, 'path': str(p), 'available': True, 'n_voids': len(radii), 'sector_radius_variance': obs, 'radius_preserving_angular_shuffle_n': len(null), 'p_high_sector_anisotropy': p_high, 'passes_not_sky_sector_driven': (p_high is not None and p_high > 0.01)})
    return {'available': bool(reports), 'attempts': attempts[:20], 'reports': reports[:10], 'any_passes_not_sky_sector_driven': any(r.get('passes_not_sky_sector_driven') for r in reports)}


def run_p38_catalogue_nulls_v23(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_p38_catalogue_nulls_v22_for_v23(meta, args)
    if getattr(args, 'quick', False) and not getattr(args, 'allow_large', False):
        base['radius_preserving_angular_null_v23'] = {'quick_mode': True, 'available': False, 'reason': 'catalogue downloads skipped in --quick mode'}
        return base
    null = _v23_void_spatial_null(meta, args)
    base['radius_preserving_angular_null_v23'] = null
    pub_gate = _v23_gate(
        independent_positive_families=bool((base.get('p38_independent_catalogue_gate_v22') or {}).get('independent_positive_families')),
        leave_one_catalogue_positive=bool((base.get('jackknife_v9') or {}).get('all_positive')),
        radius_preserving_spatial_null=bool(null.get('any_passes_not_sky_sector_driven')),
    )
    pub_gate['promotion_rule'] = 'publication-grade P38 requires independent positive families, leave-one-catalogue positivity, and radius-preserving angular/sector null not driven by sky sectors.'
    base['p38_publication_gate_v23'] = pub_gate
    if pub_gate.get('eligible_for_confirm_like'):
        base['status'] = 'void_morphology_publication_grade_confirm_like'
    base['interpretation'] = 'P38 v23: adds radius-preserving angular/sector null using coordinate-like columns when available; robust v22 confirmation remains, publication-grade gate is explicit.'
    return base


# 3) P30: explicit estimator sign-flip diagnostics and unfreeze checklist.
def run_p30_maskrandom_freeze_v23(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_p30_maskrandom_freeze_v22_for_v23(meta, args)
    rows = ((base.get('p30_mask_random_confirm_gate_v22') or {}).get('estimator_sign_rows') or [])
    conflicts = []
    for r in rows:
        vals = r.get('deltas') or []
        if vals:
            pos = sum(1 for v in vals if v > 0); neg = sum(1 for v in vals if v < 0)
            conflicts.append({'sample': r.get('sample'), 'n_positive_estimators': pos, 'n_negative_estimators': neg, 'deltas': vals, 'sign_conflict': pos > 0 and neg > 0, 'max_abs_delta': max(abs(v) for v in vals)})
    base['p30_estimator_flip_diagnosis_v23'] = {
        'n_conflicting_samples': sum(1 for c in conflicts if c['sign_conflict']),
        'conflicts': conflicts,
        'likely_failure_mode': 'density estimator / mask / edge normalization problem' if any(c['sign_conflict'] for c in conflicts) else 'no sign conflict detected',
        'required_debug_columns_next_run': ['estimator', 'density_nside_or_knn_k', 'ra_dec_bounds', 'edge_fraction', 'mask_fraction', 'density_quantile_thresholds', 'random_catalogue_density'],
        'unfreeze_rule': 'only unfreeze if HEALPix64, HEALPix128 and KNN agree in sign after explicit ACT mask + Euclid/DESI random-density normalization',
    }
    # Keep conservative frozen status unless the v22 gate already passed.
    if not (base.get('p30_mask_random_confirm_gate_v22') or {}).get('eligible_for_confirm_like'):
        base['status'] = 'density_kappa_diagnostic_only'
    return base


# 4) P8/P8c: safer large tar retry + metadata-only fallback to avoid data-limited dead end.
def run_nanograv_retry_cache_v23(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_nanograv_retry_cache_v22_for_v23(meta, args)
    if base.get('status') == 'data_limited':
        rec, attempts = zenodo_record(str(meta.get('zenodo_record','16051178')), _Path_v23(args.cache_dir), args)
        files = rec.get('files', []) if rec else []
        tar_files = []
        par_like = []
        for f in files:
            key = str(f.get('key',''))
            size = f.get('size')
            link = (f.get('links') or {}).get('self') or (f.get('links') or {}).get('download')
            if key.endswith(('.tar.gz','.tgz','.tar')):
                tar_files.append({'key': key, 'size': size, 'url': link})
            if _re_v23.search(r'(?i)(\.par$|par)', key):
                par_like.append({'key': key, 'size': size, 'url': link})
        base['nanograv_metadata_fallback_v23'] = {
            'metadata_reachable': bool(rec),
            'n_files': len(files),
            'tar_files': tar_files[:10],
            'par_like_files': par_like[:20],
            'attempts': attempts[:5],
            'preferred_next': 'download only par-like members if available; otherwise stream tar and stop after .par inventory before reading full .tim payloads',
        }
        if rec and tar_files:
            base['status'] = 'pta_sky_position_positive_ready_metadata_only'
            base['interpretation'] = 'NANOGrav v23: corrupt full tar no longer blocks the suite; Zenodo metadata identifies timing tarball(s), so the PTA coordinate route is ready for streaming/member-level retry.'
    return base


# 5) P33: covariance-aware measured-split schema and baseline recovery if v22 saw empty observables.
def run_p33_density_bao_measured_scaffold_v23(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_p33_density_bao_measured_scaffold_v22_for_v23(meta, args)
    obs = base.get('observables') or []
    if not obs and not getattr(args, 'quick', False):
        try:
            direct = run_desi_bao_likelihood(meta, args)
            obs = direct.get('observables') or []
            base['p33_v23_recovered_bao_observables'] = len(obs)
            for k in ('observables','cov_file','mean_file','best_fit','lcdm_fit','delta_chi2_lcdm_minus_best'):
                if k in direct and k not in base:
                    base[k] = direct[k]
        except Exception as e:
            base['p33_v23_recovery_error'] = str(e)
    quantities = sorted(set(str(o.get('quantity')) for o in obs if o.get('quantity')))
    z_bins = sorted(set(round(float(o.get('z')), 3) for o in obs if _v23_finite_float(o.get('z')) is not None))
    design = {
        'baseline_observables_n': len(obs),
        'redshift_bins': z_bins,
        'quantities': quantities,
        'density_split_fit_fields': ['density_bin', 'z_bin', 'observable', 'alpha_or_shift', 'sigma', 'cov_block_id'],
        'required_randoms': ['DESI/SDSS random catalogue', 'angular mask', 'radial selection n(z)'],
        'required_nulls': ['density-label shuffle', 'sky rotation/shuffle', 'redshift-bin jackknife', 'observable-type leave-one-out'],
    }
    ready = len(z_bins) >= 5 and {'DM_over_rs','DH_over_rs'}.issubset(set(quantities)) and bool(base.get('cov_file'))
    base['p33_density_split_measurement_design_v23'] = design
    gate = _v23_gate(bao_covariance_ready=bool(base.get('cov_file')), baseline_vector_ready=ready, density_randoms_available=False, measured_density_split=False, nulls_done=False)
    gate['promotion_rule'] = 'P33 confirm requires measured high-low-density BAO shift with random-catalogue density normalization and covariance-aware nulls; baseline BAO vector alone never promotes.'
    base['p33_confirm_gate_v23'] = gate
    if ready and base.get('status') in {'bao_grid_positive_ready','p33_density_bao_baseline_positive_ready'}:
        base['status'] = 'p33_density_bao_measurement_ready'
    return base


# 6) P39: add AIC/BIC penalty calculation and explicit effect-size veto.
def run_p39_likelihood_gate_v23(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_p39_likelihood_gate_v22_for_v23(meta, args)
    delta = _v23_finite_float(base.get('delta_chi2_lcdm_minus_best') or base.get('bao_delta_chi2_lcdm_minus_best'))
    nobs = len(base.get('observables') or []) or base.get('n_observables') or 0
    # Treat w0/free scale as at least one extra parameter over strict LCDM.
    extra_params = 1
    delta_aic = (2*extra_params - 2*(delta or 0.0)) if delta is not None else None
    delta_bic = (_math_v23.log(max(float(nobs), 2.0))*extra_params - 2*(delta or 0.0)) if delta is not None else None
    base['p39_model_penalty_v23'] = {
        'delta_chi2_lcdm_minus_best': delta,
        'n_observables': nobs,
        'assumed_extra_params': extra_params,
        'delta_AIC_new_minus_LCDM': delta_aic,
        'delta_BIC_new_minus_LCDM': delta_bic,
        'supports_new_model_after_penalty': bool(delta_aic is not None and delta_aic < -2 and delta_bic is not None and delta_bic < 0),
        'interpretation': 'Negative ΔAIC/ΔBIC would favor the added freedom. Current Δχ²≈1 is intentionally not enough for confirm-like promotion.',
    }
    if not base['p39_model_penalty_v23']['supports_new_model_after_penalty']:
        base['status'] = 'positive_compatible'
    return base


# 7) P32: structured strain/injection plan from ranked GWOSC candidates.
def run_ringdown_strain_plan_v23(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_ringdown_strain_plan_v22_for_v23(meta, args)
    ranked = base.get('ranked_ringdown_candidates') or (base.get('ringdown_strain_v21') or {}).get('top_candidates') or []
    top = []
    for ev in ranked[:8]:
        name = ev.get('event') or ev.get('name') or ev.get('commonName') or ev.get('id') or str(ev)[:80]
        top.append({'event': name, 'required_products': ['H1 strain', 'L1 strain', 'PSD estimate', 'posterior/metadata mass-spin'], 'nulls': ['off-source time slide', 'same-PSD damped-sinusoid injection', 'detector split H1/L1', 'leave-one-event-out']})
    gate = _v23_gate(top_event_selected=bool(top), strain_downloaded=False, injection_nulls_done=False, detector_split_done=False, leave_one_event_out_done=False)
    gate['promotion_rule'] = 'P32 confirm-like requires strain-level residual fit, injection nulls, detector split and leave-one-event-out; metadata ranking remains readiness only.'
    base['ringdown_strain_execution_plan_v23'] = {'top_events': top, 'gate': gate}
    return base


# 8) P41: CP-asymmetry null implementation scaffold using parsed rows.
def run_p41_structured_cp_v23(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_p41_structured_cp_v22_for_v23(meta, args)
    rows = []
    for key in ('structured_observable_rows_v19','structured_observable_rows_v16'):
        rows.extend(base.get(key) or [])
    rows.extend(base.get('p41_v21_structured_candidates') or [])
    cp_rows = []
    avg_rows = []
    for r in rows:
        blob = _json_v23.dumps(r, default=str)[:1000]
        if _re_v23.search(r'(?i)(A_?CP|ACP|CP\s*asym|A_?[6-9]|S_?[6-9])', blob):
            cp_rows.append(r)
        elif _re_v23.search(r"(?i)(P5|P\s*prime|S_?\d+|R_?K|q\^?2|C_?9)", blob):
            avg_rows.append(r)
    # Conservative null: only passes if CP-control rows are actually present and numerically small/error-compatible.
    numeric_cp = []
    for r in cp_rows:
        nums = r.get('numbers') if isinstance(r, dict) else None
        if not nums and isinstance(r, dict):
            nums = [v for v in r.values() if isinstance(v,(int,float))]
        for v in nums or []:
            fv = _v23_finite_float(v)
            if fv is not None and abs(fv) < 10:
                numeric_cp.append(fv)
    cp_null_pass = bool(numeric_cp) and _statistics_v23.median([abs(x) for x in numeric_cp]) < 2.0
    base['p41_cp_asymmetry_null_v23'] = {
        'n_cp_control_rows': len(cp_rows),
        'n_cp_numeric_values': len(numeric_cp),
        'median_abs_cp_value_proxy': _statistics_v23.median([abs(x) for x in numeric_cp]) if numeric_cp else None,
        'cp_asymmetry_null_pass_proxy': cp_null_pass,
        'n_cp_averaged_candidate_rows': len(avg_rows),
        'promotion_rule': 'P41 confirm-like requires structured q²/value/error rows, sign basis, and CP-control rows consistent with null; text hits alone remain positive-compatible.',
    }
    old_gate = base.get('p41_structured_cp_gate_v22') or {}
    gate = _v23_gate(structured_q2_value_error_rows=bool(old_gate.get('structured_q2_value_error_rows')), sign_basis=bool(old_gate.get('sign_basis')), cp_asymmetry_null=cp_null_pass)
    base['p41_confirm_gate_v23'] = gate
    if gate.get('eligible_for_confirm_like'):
        base['status'] = 'p41_structured_cp_confirm_like'
    return base


# 9) Direct detection: mass/limit-unit normalization gate; coverage never becomes detection.
def run_direct_detection_units_v23(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_direct_detection_units_v22_for_v23(meta, args)
    hits = base.get('direct_detection_unit_hits_v21') or base.get('schema_hits_v15') or []
    text_blob = _json_v23.dumps(hits, default=str)[:10000] + ' ' + _json_v23.dumps(base.get('hepdata_csv_downloads_v17') or [], default=str)[:10000]
    mass_unit = 'GeV' if _re_v23.search(r'(?i)\bGeV\b|mass[_\s-]*gev|mDM', text_blob) else ('TeV' if _re_v23.search(r'(?i)\bTeV\b', text_blob) else None)
    limit_unit = 'cm2' if _re_v23.search(r'(?i)cm\^?2|cm2|cross.?section|sigma|limit', text_blob) else None
    window_rows = base.get('rows_in_target_window') or base.get('n_rows_in_target_window') or (base.get('unit_column_verification_v19') or {}).get('rows_in_target_window') or 0
    try: window_rows = int(window_rows)
    except Exception: window_rows = 0
    coverage_confirmed = bool(window_rows > 0 and mass_unit and limit_unit)
    base['direct_detection_normalized_unit_gate_v23'] = {
        'mass_unit_detected': mass_unit,
        'limit_unit_detected': limit_unit,
        'rows_in_500_3000_GeV_window': window_rows,
        'coverage_confirmed': coverage_confirmed,
        'detection_claim_allowed': False,
        'promotion_rule': 'Direct-detection tests can only promote to coverage_confirmed, never detection, unless public event-level likelihood shows an excess.',
    }
    if coverage_confirmed:
        base['status'] = 'mass_window_coverage_confirmed_no_detection'
    return base


# 10) HEPData: source -> record -> table -> endpoint funnel with schema classification.
def _v23_extract_hepdata_table_links_from_json_text(txt: str) -> _List_v23[str]:
    links = []
    try:
        obj = _json_v23.loads(txt)
    except Exception:
        obj = None
    def walk(x):
        if isinstance(x, dict):
            for k,v in x.items():
                if k in {'csv','json','yaml'} and isinstance(v, str) and 'hepdata.net/download/table' in v:
                    links.append(v)
                walk(v)
        elif isinstance(x, list):
            for v in x: walk(v)
    if obj is not None:
        walk(obj)
    links.extend(_re_v23.findall(r'https?://www\.hepdata\.net/download/table/[^"\s<>]+/(?:csv|json|yaml)', txt))
    # preserve order, dedupe
    out=[]; seen=set()
    for u in links:
        u = u.replace('\\/', '/')
        if u not in seen:
            seen.add(u); out.append(u)
    return out[:30]


def run_hepdata_schema_hardened_v23(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_hepdata_schema_hardened_v22_for_v23(meta, args)
    endpoint_links = []
    for item in (base.get('hepdata_schema_gate_v22') or {}).get('valid_preview', []) or []:
        path = _v23_to_path(item.get('path'), _Path_v23.cwd())
        if path:
            txt = read_text_any(path, max_bytes=4_000_000)
            endpoint_links.extend(_v23_extract_hepdata_table_links_from_json_text(txt))
    downloaded=[]
    if endpoint_links and not getattr(args, 'quick', False):
        for u in endpoint_links[:12]:
            p, at = download_candidates([u], _Path_v23(args.cache_dir), meta.get('test_id','R10') + '_v23_endpoint', args)
            if p:
                txt = read_text_any(p, max_bytes=2_000_000)
                schema = _v22_table_schema_from_text(txt)
                downloaded.append({'url': u, 'path': str(p), 'schema': schema})
    valid = [d for d in downloaded if not d.get('schema',{}).get('looks_html_preview') and d.get('schema',{}).get('has_numeric_rows') and d.get('schema',{}).get('has_units')]
    base['hepdata_endpoint_funnel_v23'] = {
        'n_table_links_discovered': len(endpoint_links),
        'links_preview': endpoint_links[:10],
        'n_endpoint_tables_downloaded': len(downloaded),
        'n_valid_endpoint_tables': len(valid),
        'valid_endpoint_preview': valid[:5],
        'promotion_rule': 'Only direct HEPData CSV/JSON/YAML table endpoints with units and numeric rows can support physics claims; record HTML/API previews are inventory only.',
    }
    if valid and _v22_status_positive(base.get('status')):
        base['status'] = str(base.get('status')) + '_endpoint_backed' if not str(base.get('status')).endswith('_endpoint_backed') else base.get('status')
    return base


# v23 dashboard: count v23 gates separately from ordinary positive-compatible statuses.
def run_dashboard_v23(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = run_dashboard_v22(meta, args)
    out = _Path_v23.cwd() / 'outputs'
    rows = []
    if out.exists():
        for p in sorted(out.glob('test*.json')):
            try:
                rows.append(_json_v23.loads(p.read_text(encoding='utf-8')))
            except Exception:
                pass
    v23_gates = []
    for r in rows:
        gates = {k:v for k,v in r.items() if k.endswith('_v23') or '_gate_v23' in k or '_null_v23' in k or '_audit_v23' in k}
        if gates:
            v23_gates.append({'test_id': r.get('test_id'), 'prediction_id': r.get('prediction_id'), 'status': r.get('status'), 'v23_keys': sorted(gates.keys())})
    base['dashboard_v23'] = {'n_v23_instrumented_tests': len(v23_gates), 'v23_instrumented_tests': v23_gates[:60], 'claim_policy': 'confirm-like labels are separated from proxy-scope, coverage-only, and readiness-only gates'}
    base['status'] = 'dashboard_positive_summary'
    return base


# Override manifest-facing v22 runner names with v23 implementations.
RUNNERS.update({
    'highz_unit_field_table_v22': run_highz_unit_field_table_v23,
    'p38_catalogue_nulls_v22': run_p38_catalogue_nulls_v23,
    'p30_maskrandom_freeze_v22': run_p30_maskrandom_freeze_v23,
    'nanograv_retry_cache_v22': run_nanograv_retry_cache_v23,
    'p33_density_bao_measured_scaffold_v22': run_p33_density_bao_measured_scaffold_v23,
    'p39_likelihood_gate_v22': run_p39_likelihood_gate_v23,
    'ringdown_strain_plan_v22': run_ringdown_strain_plan_v23,
    'p41_structured_cp_v22': run_p41_structured_cp_v23,
    'direct_detection_units_v22': run_direct_detection_units_v23,
    'hepdata_schema_hardened_v22': run_hepdata_schema_hardened_v23,
    'dashboard_v22': run_dashboard_v23,
})

# -------------------------- Round-10 v23.1 quick-mode guard patch --------------------------
# Avoids slow network endpoints during smoke tests while preserving full v23 logic when run normally.
_run_direct_detection_units_v23_full = run_direct_detection_units_v23
_run_nanograv_retry_cache_v23_full = run_nanograv_retry_cache_v23


def run_direct_detection_units_v23(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    if getattr(args, 'quick', False) and not getattr(args, 'allow_large', False):
        return base_result(meta, 'mass_window_quantified_coverage_positive_ready',
            direct_detection_normalized_unit_gate_v23={
                'quick_mode': True,
                'mass_unit_detected': None,
                'limit_unit_detected': None,
                'coverage_confirmed': False,
                'detection_claim_allowed': False,
                'promotion_rule': 'run without --quick to download HEPData/experiment curves and verify mass/limit units; quick mode never claims detection',
            },
            interpretation='Direct detection v23.1 quick-mode guard: coverage parser implemented; unit-normalized curve scan skipped.')
    return _run_direct_detection_units_v23_full(meta, args)


def run_nanograv_retry_cache_v23(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    if getattr(args, 'quick', False) and not getattr(args, 'allow_large', False):
        return base_result(meta, 'pta_sky_position_positive_ready_metadata_only',
            nanograv_metadata_fallback_v23={
                'quick_mode': True,
                'metadata_reachable': False,
                'preferred_next': 'run without --quick and with --allow-large if full timing tar/member streaming is needed',
            },
            interpretation='NANOGrav v23.1 quick-mode guard: corrupt-tar retry and metadata fallback are implemented but not evaluated in quick mode.')
    return _run_nanograv_retry_cache_v23_full(meta, args)

RUNNERS.update({
    'direct_detection_units_v22': run_direct_detection_units_v23,
    'nanograv_retry_cache_v22': run_nanograv_retry_cache_v23,
})

# -------------------------- Round-10 v24 confirm-first hardening --------------------------
# Implements ten confirm-oriented upgrades on top of v23 while keeping old runner names stable.
# Design: add stricter gates and richer diagnostics; never promote from proxy/coverage/readiness without the new gates.

import ast as _ast_v24
from pathlib import Path as _Path_v24
from typing import Any as _Any_v24, Dict as _Dict_v24, List as _List_v24, Optional as _Optional_v24

_run_highz_unit_field_table_v23_for_v24 = run_highz_unit_field_table_v23
_run_p38_catalogue_nulls_v23_for_v24 = run_p38_catalogue_nulls_v23
_run_p30_maskrandom_freeze_v23_for_v24 = run_p30_maskrandom_freeze_v23
_run_nanograv_retry_cache_v23_for_v24 = run_nanograv_retry_cache_v23
_run_p33_density_bao_measured_scaffold_v23_for_v24 = run_p33_density_bao_measured_scaffold_v23
_run_p39_likelihood_gate_v23_for_v24 = run_p39_likelihood_gate_v23
_run_ringdown_strain_plan_v23_for_v24 = run_ringdown_strain_plan_v23
_run_p41_structured_cp_v23_for_v24 = run_p41_structured_cp_v23
_run_direct_detection_units_v23_for_v24 = run_direct_detection_units_v23
_run_hepdata_schema_hardened_v23_for_v24 = run_hepdata_schema_hardened_v23
_run_smd_constants_pack_for_v24 = run_smd_constants_pack
_run_koide_constants_for_v24 = RUNNERS.get('koide_constants')
_run_dashboard_v23_for_v24 = run_dashboard_v23


def _v24_clean_name(s: _Any_v24) -> str:
    return _re_v23.sub(r'[^a-z0-9]+', '_', str(s).lower()).strip('_')


def _v24_table_source_group(path: str) -> str:
    s = path.lower()
    for key in ['kmos3d', 'kges', 'kross', 'mosdef', 'sami', 'sparc', 'kmOS', 'zcosmos']:
        if key.lower() in s:
            return key.upper()
    # Use file stem as weak group fallback.
    try:
        return _Path_v24(path.split('::')[0]).stem[:40] or 'unknown_table'
    except Exception:
        return 'unknown_table'


def _v24_find_unit_hint(columns: _List_v23[str], target: str) -> _Optional_v24[str]:
    blob = ' '.join(str(c) for c in columns)
    if target == 'velocity' and _re_v23.search(r'(?i)(km\s*/\s*s|km\s*s-1|km/s|kms|kpc\s*/\s*Gyr)', blob):
        return 'km/s-like'
    if target == 'radius' and _re_v23.search(r'(?i)(kpc|r_?kpc|radius_?kpc|arcsec)', blob):
        return 'kpc-or-angular-like'
    return None


def _v24_highz_object_scan_from_base(base: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    """A stricter object-level scanner than v23.

    It scans candidate paths plus cached high-z files, classifies accepted/rejected velocity/radius/z columns,
    groups by source table, and adds leave-one-source stability. It is intentionally conservative: if units
    are not visible, it does not promote to publication-grade confirmation.
    """
    paths = list(_v23_collect_candidate_paths(base, args))
    cache = _Path_v24(args.cache_dir)
    if cache.exists():
        for p in cache.rglob('*'):
            low = p.name.lower()
            if p.is_file() and low.endswith(('.fits','.fit','.csv','.tsv','.txt','.dat')) and _re_v23.search(r'(?i)(kmos|kges|kross|mosdef|sami|vrot|rotation|ha|halpha|galaxy)', str(p)):
                paths.append(p)
    # Deduplicate and bound work.
    seen=set(); uniq=[]
    for p in paths:
        sp=str(p)
        if sp not in seen:
            seen.add(sp); uniq.append(p)
    paths = uniq[:120]
    conv = 1_000_000.0 / 3.0856775814913673e19
    table_reports=[]; accepted=[]; rejected_velocity=[]; rejected_radius=[]; source_to_vals={}
    for p in paths:
        cols, rows, typ = _v23_table_to_columns_and_rows(p, max_rows=50000)
        if not cols:
            table_reports.append({'path': str(p), 'source_type': typ, 'n_columns': 0, 'accepted': False, 'reason': 'no_readable_columns'})
            continue
        vcol = _v23_strict_velocity_column(cols)
        rcol = _v23_radius_column(cols)
        zcol = _v23_redshift_column(cols)
        # Explicit rejection audit for unsafe broad velocity-like columns.
        for c in cols:
            sc = str(c)
            if _re_v23.search(r'(?i)(vel|velocity|vrot|vmax|vcirc)', sc) and c != vcol:
                if _re_v23.search(r'(?i)(pa|angle|theta|phi|incl|sigma|disp|err|error|flag)', sc):
                    rejected_velocity.append({'path': str(p), 'column': sc, 'reason': 'not_rotation_velocity'})
        for c in cols:
            sc = str(c)
            if _re_v23.search(r'(?i)(rad|radius|size|r_?e|reff|kpc)', sc) and c != rcol:
                if _re_v23.search(r'(?i)(err|error|flag|angle|pa)', sc):
                    rejected_radius.append({'path': str(p), 'column': sc, 'reason': 'not_physical_radius'})
        unit_v = _v24_find_unit_hint(cols, 'velocity')
        unit_r = _v24_find_unit_hint(cols, 'radius')
        vals=[]; zs=[]
        if vcol and rcol:
            for row in rows:
                vv = _v23_finite_float(row.get(vcol)); rr = _v23_finite_float(row.get(rcol)); zz = _v23_finite_float(row.get(zcol)) if zcol else None
                if vv is None or rr is None:
                    continue
                if 20 <= abs(vv) <= 600 and 0.03 <= abs(rr) <= 250:
                    vals.append((abs(vv)**2 / abs(rr)) * conv)
                    if zz is not None and 0 <= zz <= 10: zs.append(zz)
        group = _v24_table_source_group(str(p))
        if vals:
            accepted.extend(vals)
            source_to_vals.setdefault(group, []).extend(vals)
        table_reports.append({
            'path': str(p), 'source_group': group, 'source_type': typ, 'n_columns': len(cols),
            'columns_preview': [str(c) for c in cols[:35]], 'v_col': vcol, 'r_col': rcol, 'z_col': zcol,
            'velocity_unit_hint': unit_v, 'radius_unit_hint': unit_r, 'n_object_rows': len(vals),
            'median_a_m_s2': _statistics_v23.median(vals) if vals else None,
            'median_z': _statistics_v23.median(zs) if zs else None,
            'accepted': bool(vals),
        })
    local = 9.55e-11
    source_medians = {g: _statistics_v23.median(v) for g,v in source_to_vals.items() if v}
    leave_one_source=[]
    for g in source_medians:
        vals=[]
        for gg, arr in source_to_vals.items():
            if gg != g: vals.extend(arr)
        if vals: leave_one_source.append({'held_out': g, 'median_a_m_s2': _statistics_v23.median(vals), 'above_local': _statistics_v23.median(vals) > local})
    all_unit_visible = any(r.get('velocity_unit_hint') for r in table_reports if r.get('accepted')) and any(r.get('radius_unit_hint') for r in table_reports if r.get('accepted'))
    gate = _v23_gate(
        object_rows_ge_30=len(accepted) >= 30,
        two_independent_sources=len(source_to_vals) >= 2,
        strict_vrot_and_radius_columns=any(r.get('v_col') and r.get('r_col') for r in table_reports),
        unit_hints_visible=all_unit_visible,
        median_above_local=(bool(accepted) and _statistics_v23.median(accepted) > local),
        leave_one_source_above_local=(bool(leave_one_source) and all(x.get('above_local') for x in leave_one_source)),
    )
    gate.update({
        'n_object_rows': len(accepted), 'n_sources': len(source_to_vals), 'source_medians_a_m_s2': source_medians,
        'median_object_a_m_s2': _statistics_v23.median(accepted) if accepted else None,
        'local_sparc_a0_m_s2': local, 'leave_one_source': leave_one_source[:20],
        'promotion_rule': 'v24 high-z publication confirm requires strict Vrot+radius object rows, visible units, >=30 rows, >=2 independent sources, median and leave-one-source above local SPARC a0.',
    })
    return {'gate': gate, 'reports': table_reports[:60], 'rejected_velocity_columns': rejected_velocity[:60], 'rejected_radius_columns': rejected_radius[:30]}


def run_highz_unit_field_table_v24(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_highz_unit_field_table_v23_for_v24(meta, args)
    if getattr(args, 'quick', False) and not getattr(args, 'allow_large', False):
        base['highz_objectlevel_publication_gate_v24'] = {'quick_mode': True, 'eligible_for_confirm_like': False, 'reason': 'strict object-level scan skipped in quick mode'}
        base['claim_scope_v24'] = 'proxy_confirm_like_until_object_level_publication_gate_passes'
        return base
    scan = _v24_highz_object_scan_from_base(base, args)
    base['highz_objectlevel_publication_gate_v24'] = scan['gate']
    base['highz_objectlevel_table_reports_v24'] = scan['reports']
    base['highz_rejected_columns_v24'] = {'velocity': scan['rejected_velocity_columns'], 'radius': scan['rejected_radius_columns']}
    if scan['gate'].get('eligible_for_confirm_like'):
        base['status'] = 'highz_a0_objectlevel_publication_confirm_like'
    else:
        base['claim_scope_v24'] = 'proxy_confirm_like_until_object_level_publication_gate_passes'
    return base


def run_p38_catalogue_nulls_v24(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_p38_catalogue_nulls_v23_for_v24(meta, args)
    base['p38_effect_size_publication_table_v24'] = {
        'recommended_columns': ['catalogue_family','n_voids','observed_effect','null_median','null_p05','null_p95','effect_over_null_sigma','leave_one_catalogue_delta'],
        'current_publication_gate_passed': str(base.get('status','')).endswith('confirm_like'),
        'next_required_for_claim': 'add mock-catalogue comparison and report effect size, not only p-values',
    }
    # v24 does not demote; it makes the publication claim more auditable.
    return base


def run_p30_maskrandom_freeze_v24(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_p30_maskrandom_freeze_v23_for_v24(meta, args)
    # 3/4/5: empirical mask search, random-density requirement, estimator harmonization matrix.
    listing = []
    for x in (base.get('act_extract_v16') or {}).get('kappa_alm_listing', []) or []:
        listing.append(str(x.get('name','')))
    mask_candidates = [n for n in listing if _re_v23.search(r'(?i)(mask|window|weight|hit|ivar|apod|footprint|area)', n)]
    matrix = base.get('p30_estimator_matrix_v20') or []
    harmonized=[]
    for row in matrix:
        deltas=[row.get('healpix64_delta'), row.get('healpix128_delta'), row.get('knn16_delta')]
        vals=[_v23_finite_float(x) for x in deltas if _v23_finite_float(x) is not None]
        signs=[1 if v>0 else -1 if v<0 else 0 for v in vals]
        harmonized.append({'sample': row.get('sample'), 'estimators': {'healpix64': row.get('healpix64_delta'), 'healpix128': row.get('healpix128_delta'), 'knn16': row.get('knn16_delta')}, 'same_sign': bool(signs and all(s==signs[0] for s in signs)), 'spread_abs': (max(vals)-min(vals)) if vals else None})
    base['p30_v24_mask_random_harmonization'] = {
        'official_mask_candidates_in_act_tar': mask_candidates,
        'official_mask_found': bool(mask_candidates),
        'empirical_mask_allowed_for_diagnostics_only': True,
        'random_catalogue_required_for_confirm': True,
        'density_estimators_to_run_next': ['HEALPix32','HEALPix64','HEALPix128','HEALPix256','KNN16','KNN32','KNN64'],
        'harmonized_existing_rows': harmonized,
        'all_existing_estimators_same_sign': bool(harmonized and all(r.get('same_sign') for r in harmonized)),
        'confirm_unfreeze_rule': 'explicit ACT mask or documented empirical mask + Euclid/DESI randoms + same sign in HEALPix32/64/128/256 and KNN16/32/64 + curl weaker/null',
    }
    base['status'] = 'density_kappa_diagnostic_only'
    return base


def run_p33_density_bao_measured_scaffold_v24(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_p33_density_bao_measured_scaffold_v23_for_v24(meta, args)
    obs = base.get('observables') or []
    # Compute a covariance-ready baseline alpha proxy from parsed BAO observables, but do not call it measured density split.
    zq = []
    for o in obs:
        z = _v23_finite_float(o.get('z')); val = _v23_finite_float(o.get('value'))
        if z is not None and val is not None:
            zq.append((z, o.get('quantity'), val))
    base['p33_measured_alpha_plan_v24'] = {
        'baseline_observable_rows': len(zq),
        'density_split_measured': False,
        'required_catalogues': ['DESI LSS data/randoms or SDSS/eBOSS galaxies/randoms'],
        'required_outputs': ['alpha_high_density','alpha_low_density','covariance','delta_alpha','density_label_shuffle_p','sky_shuffle_p','redshift_bin_jackknife'],
        'confirm_rule': 'promote only if covariance-aware high-low density BAO alpha shift has pre-declared CCDR sign and survives density-label, sky, and redshift-bin nulls',
    }
    if base.get('status') == 'p33_density_bao_measurement_ready':
        base['status'] = 'p33_density_bao_measurement_ready_not_confirmed'
    return base


def run_p39_likelihood_gate_v24(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_p39_likelihood_gate_v23_for_v24(meta, args)
    pen = base.get('p39_model_penalty_v23') or {}
    delta = _v23_finite_float(pen.get('delta_chi2_lcdm_minus_best'))
    base['p39_full_likelihood_requirements_v24'] = {
        'current_delta_chi2': delta,
        'minimum_delta_chi2_for_attention': 4.0,
        'minimum_delta_chi2_for_confirm_with_1_extra_param': 9.0,
        'full_covariance_required': True,
        'systematics_splits_required': ['survey','redshift','calibration','low-z anchor','observable-type'],
        'current_promotable': False,
    }
    base['status'] = 'positive_compatible'
    return base


def run_ringdown_strain_plan_v24(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_ringdown_strain_plan_v23_for_v24(meta, args)
    plan = base.get('ringdown_strain_execution_plan_v23') or {}
    top = plan.get('top_events') or []
    base['ringdown_gwosc_download_manifest_v24'] = {
        'n_top_events': len(top),
        'events': [{'event': e.get('event'), 'gwosc_open_data_steps': ['query GWOSC event JSON','download H1/L1/V1 strain around GPS time','estimate PSD from off-source segment','fit GR damped sinusoid','fit CCDR residual template','run injections and time slides']} for e in top[:10]],
        'confirm_gate': _v23_gate(strain_downloaded=False, residual_template_fit=False, injection_nulls=False, detector_split=False, leave_one_event_out=False),
        'claim_policy': 'metadata ranking is readiness only; only strain-level residual statistics can promote P32',
    }
    return base


def _v24_parse_q2_numeric_rows_from_text(txt: str) -> _List_v24[_Dict_v24[str, _Any_v24]]:
    rows=[]
    # Simple LaTeX table row parser for q^2/value/stat/syst-like patterns.
    for ln in txt.splitlines():
        s = ln.strip()
        if '&' not in s or '\\' not in s:
            continue
        parts=[_re_v23.sub(r'\\.*$','',p).strip() for p in s.split('&')]
        blob=' '.join(parts)
        if not _re_v23.search(r'(?i)(q\^?2|\$q|P_?5|R_?K|S_?\d|A_?CP|C_?9)', blob):
            continue
        nums=[]
        for m in _re_v23.finditer(r'[-+]?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?', blob):
            try: nums.append(float(m.group(0)))
            except Exception: pass
        if len(nums) >= 3:
            rows.append({'raw': s[:500], 'numbers': nums[:12], 'has_q2_like': bool(_re_v23.search(r'(?i)q\^?2|gev\^?2', blob)), 'cp_like': bool(_re_v23.search(r'(?i)A_?CP|ACP|CP', blob))})
    return rows[:500]


def run_p41_structured_cp_v24(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_p41_structured_cp_v23_for_v24(meta, args)
    candidate_paths=[]
    for key in ('downloaded','p41_v21_structured_candidates'):
        for item in base.get(key, []) or []:
            if isinstance(item, dict) and item.get('path'):
                p=_v23_to_path(item.get('path'), _Path_v23.cwd())
                if p: candidate_paths.append(p)
    qrows=[]
    for p in candidate_paths[:30]:
        try:
            txt=read_text_any(p, max_bytes=5_000_000)
            qrows.extend(_v24_parse_q2_numeric_rows_from_text(txt))
        except Exception:
            pass
    cp = [r for r in qrows if r.get('cp_like')]
    noncp = [r for r in qrows if not r.get('cp_like')]
    gate = _v23_gate(
        q2_binned_numeric_rows=len(qrows) >= 10,
        cp_control_rows=len(cp) >= 3,
        noncp_observable_rows=len(noncp) >= 5,
        full_likelihood_fit=False,
    )
    gate['promotion_rule'] = 'v24 requires q²-binned numeric rows plus CP controls; final major claim still needs a likelihood/Wilson-coefficient fit.'
    base['p41_q2_likelihood_table_audit_v24'] = {'n_q2_numeric_rows': len(qrows), 'n_cp_control_rows': len(cp), 'n_noncp_rows': len(noncp), 'rows_preview': qrows[:10], 'gate': gate}
    if not gate.get('eligible_for_confirm_like') and str(base.get('status','')).endswith('confirm_like'):
        base['claim_scope_v24'] = 'structured_proxy_confirm_like_until_full_q2_likelihood_gate_passes'
    return base


def run_direct_detection_units_v24(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_direct_detection_units_v23_for_v24(meta, args)
    gate = base.get('direct_detection_normalized_unit_gate_v23') or {}
    base['direct_detection_claim_policy_v24'] = {
        'coverage_confirmed': bool(gate.get('coverage_confirmed')),
        'detection_claim_allowed': False,
        'requires_event_level_likelihood_for_detection': True,
        'mass_window_GeV': [500, 3000],
        'required_units': ['mass in GeV or convertible TeV', 'limit/cross-section in cm^2'],
    }
    return base


def run_hepdata_schema_hardened_v24(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_hepdata_schema_hardened_v23_for_v24(meta, args)
    funnel = base.get('hepdata_endpoint_funnel_v23') or {}
    base['hepdata_endpoint_funnel_v24'] = {
        'inherits_v23': funnel,
        'source_record_table_endpoint_required': True,
        'reject_record_html_or_api_preview_as_evidence': True,
        'test_specific_schema': {
            'P5': ['eta/s or viscosity proxy','temperature/centrality','uncertainty'],
            'P9': ['mass/MET/signal region','cross-section or limit','uncertainty/CL'],
            'P41': ['q2 bin','observable','value','stat/syst error','CP label'],
        },
        'promotion_rule': 'endpoint-backed numeric rows with units are necessary; schema-specific required columns are sufficient only for positive-ready, not automatic confirm.',
    }
    return base


def run_nanograv_retry_cache_v24(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_nanograv_retry_cache_v23_for_v24(meta, args)
    base['nanograv_streaming_par_tim_plan_v24'] = {
        'stream_tar_members_without_getmembers': True,
        'cache_integrity_checks': ['content-length','gzip EOF','minimum .par count'],
        'weighted_stat_required': ['TOA count','timing baseline','red-noise amplitude','top-weight removal'],
        'claim_policy': 'sky position metadata alone is positive-ready; confirm requires weighted residual/timing statistic against κ or density maps',
    }
    return base


def run_smd_constants_pack_v24(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_smd_constants_pack_for_v24(meta, args)
    rec = base.get('constant_record') or {}
    observed = _v23_finite_float(rec.get('observed'))
    target = _v23_finite_float(rec.get('target'))
    residual = (observed-target) if observed is not None and target is not None else None
    tol = _v23_finite_float(rec.get('tol'))
    base['smd_derivation_gate_v24'] = {
        'has_ccdr_formula': False,
        'observed_minus_target': residual,
        'tolerance': tol,
        'constant_match': bool(residual is not None and tol is not None and abs(residual) <= tol),
        'derivation_confirm_like': False,
        'promotion_rule': 'SM-D constants remain consistency checks until the test outputs a CCDR-derived value, uncertainty, residual and falsification threshold.',
    }
    if str(base.get('status')) == 'confirm_like':
        base['claim_scope_v24'] = 'constant_consistency_confirm_like_not_derivation_confirm'
    return base


def run_koide_constants_v24(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    if _run_koide_constants_for_v24 is None:
        return run_smd_constants_pack_v24(meta, args)
    base = _run_koide_constants_for_v24(meta, args)
    q = _v23_finite_float(base.get('koide_Q') or (base.get('constant_record') or {}).get('Q'))
    base['smd_derivation_gate_v24'] = {
        'has_ccdr_formula': False,
        'koide_Q': q,
        'target_2_over_3': 2.0/3.0,
        'residual': (q - 2.0/3.0) if q is not None else None,
        'derivation_confirm_like': False,
        'promotion_rule': 'Koide stays a strong numerical consistency check until CCDR derives the charged-lepton mass relation with uncertainty.',
    }
    if str(base.get('status')) == 'confirm_like':
        base['claim_scope_v24'] = 'koide_constant_consistency_not_derivation_confirm'
    return base


def run_dashboard_v24(meta: _Dict_v23[str, _Any_v23], args: argparse.Namespace) -> _Dict_v23[str, _Any_v23]:
    base = _run_dashboard_v23_for_v24(meta, args)
    out = _Path_v24.cwd() / 'outputs'
    rows=[]
    if out.exists():
        for p in sorted(out.glob('test*.json')):
            try: rows.append(json.loads(p.read_text(encoding='utf-8')))
            except Exception: pass
    v24=[]
    for r in rows:
        keys=sorted([k for k in r if k.endswith('_v24') or '_v24_' in k])
        if keys:
            v24.append({'test_id': r.get('test_id'), 'prediction_id': r.get('prediction_id'), 'status': r.get('status'), 'v24_keys': keys})
    base['dashboard_v24'] = {'n_v24_instrumented_tests': len(v24), 'v24_instrumented_tests': v24[:80], 'claim_policy': 'v24 separates publication-grade/object-level/table-level gates from proxy confirm-like labels'}
    base['status'] = 'dashboard_positive_summary'
    return base


# Override existing manifest kind names so old test wrappers automatically execute v24.
RUNNERS.update({
    'highz_unit_field_table_v22': run_highz_unit_field_table_v24,
    'p38_catalogue_nulls_v22': run_p38_catalogue_nulls_v24,
    'p30_maskrandom_freeze_v22': run_p30_maskrandom_freeze_v24,
    'nanograv_retry_cache_v22': run_nanograv_retry_cache_v24,
    'p33_density_bao_measured_scaffold_v22': run_p33_density_bao_measured_scaffold_v24,
    'p39_likelihood_gate_v22': run_p39_likelihood_gate_v24,
    'ringdown_strain_plan_v22': run_ringdown_strain_plan_v24,
    'p41_structured_cp_v22': run_p41_structured_cp_v24,
    'direct_detection_units_v22': run_direct_detection_units_v24,
    'hepdata_schema_hardened_v22': run_hepdata_schema_hardened_v24,
    'smd_constants_pack': run_smd_constants_pack_v24,
    'koide_constants': run_koide_constants_v24,
    'dashboard_v22': run_dashboard_v24,
})

