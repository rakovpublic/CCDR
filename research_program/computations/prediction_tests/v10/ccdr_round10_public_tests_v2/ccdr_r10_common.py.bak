    "p33_density_bao_measured_scaffold_v22": run_p33_density_bao_measured_scaffold_v22,
    "p39_likelihood_gate_v22": run_p39_likelihood_gate_v22,
    "ringdown_strain_plan_v22": run_ringdown_strain_plan_v22,
    "p41_structured_cp_v22": run_p41_structured_cp_v22,
    "direct_detection_units_v22": run_direct_detection_units_v22,
    "hepdata_schema_hardened_v22": run_hepdata_schema_hardened_v22,
    "dashboard_v22": run_dashboard_v22,
})

# -------------------------- Round-10 v22.1 quick-mode hotfix --------------------------
# Keep all-test quick validation fast: P30 heavy ACT/Euclid reconstruction is skipped
# unless the user explicitly allows large products.
_run_p30_maskrandom_freeze_v22_heavy = run_p30_maskrandom_freeze_v22

def run_p30_maskrandom_freeze_v22(meta: Dict[str, Any], args: argparse.Namespace) -> Dict[str, Any]:
    if getattr(args, "quick", False) and not getattr(args, "allow_large", False):
        gate = _v22_confirm_gate_from_bool(
            explicit_act_mask=False,
            random_catalogue_or_mask_normalized_density=False,
            estimator_agreement=False,
            two_science_variants=False,
            curl_weaker_or_null=False,
        )
        gate.update({
            "quick_mode": True,
            "reason": "heavy ACT/Euclid reconstruction skipped in --quick mode; run without --quick and with cached/allowed large ACT products for the real statistic",
            "promotion_rule": "P30 confirm-like requires explicit ACT mask/random catalogue, estimator agreement, >=2 science variants and null curl.",
        })
        return base_result(meta, "density_kappa_diagnostic_only", p30_mask_random_confirm_gate_v22=gate,
            p30_freeze_policy_v22={"confirm_route_frozen": True, "required_to_unfreeze": gate.get("missing", [])},
            interpretation="P30 v22.1 quick-mode guard: confirms are intentionally disabled without the heavy map/mask/random-catalogue path.")
    return _run_p30_maskrandom_freeze_v22_heavy(meta, args)

RUNNERS.update({"p30_maskrandom_freeze_v22": run_p30_maskrandom_freeze_v22})

# -------------------------- Round-10 v22.2 high-z None-safe hotfix --------------------------
_run_highz_unit_field_table_v22_old = run_highz_unit_field_table_v22

def run_highz_unit_field_table_v22(meta: Dict[str, Any], args: argparse.Namespace) -> Dict[str, Any]:
    try:
        base = run_highz_unit_field_v21(meta, args)
    except TypeError as e:
        base = run_highz_vrot_confirm_guard_v20(meta, args)
        base["v21_none_guard_hotfix_v22_2"] = {"caught": type(e).__name__, "error": str(e), "fallback": "run_highz_vrot_confirm_guard_v20"}
    audits = base.get("vrot_unit_audit_v16", []) or []
    boot = base.get("vrot_bootstrap_v15") or {}
    gate21 = base.get("vrot_confirm_gate_v21", {}) or base.get("vrot_confirm_gate_v20", {}) or {}
    table_paths = sorted(set(str(a.get("path")) for a in audits if a.get("path")))
    unit_evidence = []
    for a in audits:
        blob = " ".join(str(a.get(k, "")) for k in ("path", "url", "v_col", "r_col", "z_col", "unit_assumption"))
        unit_evidence.append({"path": a.get("path"), "v_col": a.get("v_col"), "r_col": a.get("r_col"), "z_col": a.get("z_col"), "has_velocity_label": bool(_re_v22.search(r"(?i)(vrot|vmax|vcirc|velocity|vel|km.?s)", blob)), "has_radius_label": bool(_re_v22.search(r"(?i)(radius|r_e|re|rd|rhalf|size|kpc|arcsec)", blob)), "has_redshift_label": bool(_re_v22.search(r"(?i)(redshift|\bz\b)", blob))})
    bf = boot.get("fraction_bootstrap_above_sparc")
    if bf is None: bf = gate21.get("bootstrap_fraction_above_sparc")
    if bf is None: bf = 0.0
    try: bf_float = float(bf)
    except Exception: bf_float = 0.0
    units_verified = bool(gate21.get("unit_verified")) or any(x["has_velocity_label"] and x["has_radius_label"] for x in unit_evidence)
    table_split_ready = len(table_paths) >= 2 or bool(gate21.get("field_split_ready_v21")) or bool(gate21.get("leave_one_table_out_ready"))
    bootstrap_ready = bf_float >= 0.95 and (boot.get("n", 0) or 0) >= 30
    gate = _v22_confirm_gate_from_bool(units_verified=units_verified, bootstrap_ready=bootstrap_ready, table_or_field_split_ready=table_split_ready, detection_scope_is_proxy=True)
    gate.update({"n_tables": len(table_paths), "table_paths_preview": table_paths[:10], "bootstrap_fraction_above_sparc": bf_float, "bootstrap_n": boot.get("n"), "unit_evidence_preview": unit_evidence[:20], "promotion_rule": "highz_a0_vrot_confirm_like only if explicit/label-based units + >=0.95 bootstrap fraction + independent table/field split gate pass"})
    base["vrot_confirm_gate_v22"] = gate
    if gate["eligible_for_confirm_like"]:
        base["status"] = "highz_a0_vrot_confirm_like"
    elif bf_float >= 0.95:
        base["status"] = "highz_a0_vrot_confirm_like_candidate"
    else:
        base["status"] = base.get("status", "highz_a0_positive_ready")
    base["interpretation"] = "P36 v22.2: high-z a0 is None-safe and promotes only after unit, bootstrap, and table/field split gates pass."
    return base

RUNNERS.update({"highz_unit_field_table_v22": run_highz_unit_field_table_v22})

