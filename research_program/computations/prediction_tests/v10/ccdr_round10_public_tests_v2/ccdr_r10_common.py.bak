# -------------------------- Round-10 v25 confirm-first hardening --------------------------
# v25 does not loosen claim policy. It adds the 10 requested confirmation-oriented
# diagnostics: P30 mask/random/variant split, P36 source-specific object gates,
# P33 measured-alpha output contract, P41 q2 likelihood hardening, P32 strain URLs,
# HEPData endpoint-only policy, and SM-D derivation fields.
from pathlib import Path as _Path_v25
import json as _json_v25
import math as _math_v25
import re as _re_v25

_run_p30_maskrandom_freeze_v24_for_v25 = run_p30_maskrandom_freeze_v24
_run_highz_unit_field_table_v24_for_v25 = run_highz_unit_field_table_v24
_run_p33_density_bao_measured_scaffold_v24_for_v25 = run_p33_density_bao_measured_scaffold_v24
_run_p41_structured_cp_v24_for_v25 = run_p41_structured_cp_v24
_run_ringdown_strain_plan_v24_for_v25 = run_ringdown_strain_plan_v24
_run_hepdata_schema_hardened_v24_for_v25 = run_hepdata_schema_hardened_v24
_run_direct_detection_units_v24_for_v25 = run_direct_detection_units_v24
_run_smd_constants_pack_v24_for_v25 = run_smd_constants_pack_v24
_run_koide_constants_v24_for_v25 = run_koide_constants_v24
_run_dashboard_v24_for_v25 = run_dashboard_v24


def _v25_float(x):
    try:
        if x is None: return None
        v = float(x)
        return v if _math_v25.isfinite(v) else None
    except Exception:
        return None


def _v25_gate(**items):
    missing = [k for k, v in items.items() if not bool(v)]
    out = dict(items)
    out['eligible_for_confirm_like'] = not missing
    out['missing'] = missing
    return out


def _v25_cache_file_names(args, max_items=2000):
    cache = _Path_v25(getattr(args, 'cache_dir', '.ccdr_round10_cache'))
    names=[]
    if cache.exists():
        for p in cache.rglob('*'):
            if p.is_file():
                names.append(str(p))
                if len(names) >= max_items: break
    return names


def _v25_p30_route_stat(stat):
    if not isinstance(stat, dict):
        return {'available': False}
    d = _v25_float(stat.get('delta_high_minus_low'))
    dp = _v25_float(stat.get('density_bin_shuffle_p_high'))
    sp = _v25_float(stat.get('sky_shuffle_p_high'))
    jk = stat.get('field_split_jackknife') or []
    jk_vals = [_v25_float(x) for x in jk]
    jk_vals = [x for x in jk_vals if x is not None]
    return {
        'available': True,
        'delta_high_minus_low': d,
        'positive': d is not None and d > 0,
        'density_p_pass': dp is not None and dp <= 0.05,
        'sky_p_pass': sp is not None and sp <= 0.10,
        'jackknife_all_positive': bool(jk_vals) and all(x > 0 for x in jk_vals),
        'n_jackknife': len(jk_vals),
        'n_high': stat.get('high_density_n'),
        'n_low': stat.get('low_density_n'),
    }


def run_p30_maskrandom_freeze_v25(meta, args):
    base = _run_p30_maskrandom_freeze_v24_for_v25(meta, args)
    # 1. official or empirical ACT mask gate
    listing = [str(x.get('name','')) for x in (base.get('act_extract_v16') or {}).get('kappa_alm_listing', []) or [] if isinstance(x, dict)]
    official_mask_candidates = [n for n in listing if _re_v25.search(r'(?i)(mask|window|weight|hit|ivar|apod|footprint|coverage|area)', n)]
    sanity = ((base.get('act_probe_v18') or {}).get('best_sanity') or (base.get('act_alm_probe_v16') or {}).get('best_sanity') or {})
    empirical_mask_available = bool(_v25_float(sanity.get('finite_fraction')) and _v25_float(sanity.get('std')) and _v25_float(sanity.get('std')) > 0)
    cache_names = _v25_cache_file_names(args)
    random_candidates = [n for n in cache_names if _re_v25.search(r'(?i)(random|ran|randcat|randoms|masknorm|mask_norm|selection_function)', n)]
    base['p30_act_mask_gate_v25'] = {
        'official_mask_found': bool(official_mask_candidates),
        'official_mask_candidates': official_mask_candidates[:20],
        'empirical_finite_support_mask_available': empirical_mask_available,
        'empirical_mask_claim_scope': 'diagnostic_only_not_publication_confirm' if empirical_mask_available and not official_mask_candidates else None,
        'mask_required_for_publication_confirm': True,
    }
    base['p30_random_density_gate_v25'] = {
        'random_catalogue_candidates_in_cache': random_candidates[:30],
        'random_catalogue_found': bool(random_candidates),
        'required_density_definition': 'delta = (N_data / N_random) - 1 in a shared survey mask; raw HEALPix counts are diagnostic only',
        'random_density_required_for_confirm': True,
    }

    # 2-4. science-variant consistency and route split
    variant_stats = base.get('act_variant_stats_v17') or {}
    science=[]
    for name, blob in variant_stats.items():
        if name == 'curl_control':
            continue
        st = (blob or {}).get('stat') or {}
        d = _v25_float(st.get('delta_high_minus_low'))
        science.append({'variant': name, 'delta_high_minus_low': d, 'positive': d is not None and d > 0, 'density_p': st.get('density_bin_shuffle_p_high'), 'sky_p': st.get('sky_shuffle_p_high'), 'jackknife_same_sign': st.get('jackknife_same_sign')})
    curl_st = ((variant_stats.get('curl_control') or {}).get('stat') or {})
    curl_d = _v25_float(curl_st.get('delta_high_minus_low'))
    positive_science = [x for x in science if x.get('positive')]
    base['p30_science_variant_consistency_v25'] = {
        'science_variants': science,
        'n_positive_science_variants': len(positive_science),
        'curl_delta': curl_d,
        'curl_weaker_than_best_science_abs': bool(positive_science and curl_d is not None and abs(curl_d) < max(abs(x['delta_high_minus_low']) for x in positive_science if x.get('delta_high_minus_low') is not None)),
        'two_science_variants_positive': len(positive_science) >= 2,
        'promotion_rule': 'require >=2 ACT science variants with same positive sign under identical density bins and curl weaker/null',
    }
    route_stats = base.get('density_kappa_stats_v16') or {}
    routes = {name: _v25_p30_route_stat(stat) for name, stat in route_stats.items()}
    base['p30_route_separation_v25'] = {
        'routes': routes,
        'sdss_route_confirm_candidate': bool(routes.get('sdss',{}).get('positive') and routes.get('sdss',{}).get('density_p_pass') and routes.get('sdss',{}).get('jackknife_all_positive')),
        'euclid_route_confirm_candidate': bool(routes.get('euclid',{}).get('positive') and routes.get('euclid',{}).get('density_p_pass') and routes.get('euclid',{}).get('jackknife_all_positive')),
        'recommendation': 'do not merge Euclid and SDSS P30 claims; publish separate route statuses until both pass mask/random normalization',
    }
    gate_prev = base.get('p30_mask_random_confirm_gate_v22') or {}
    base['p30_publication_confirm_gate_v25'] = _v25_gate(
        act_mask=bool(official_mask_candidates),
        random_density=bool(random_candidates),
        estimator_agreement=bool(gate_prev.get('estimator_agreement')),
        science_variants=len(positive_science) >= 2,
        curl_control=bool(base['p30_science_variant_consistency_v25'].get('curl_weaker_than_best_science_abs')),
        euclid_or_sdss_route=bool(base['p30_route_separation_v25']['sdss_route_confirm_candidate'] or base['p30_route_separation_v25']['euclid_route_confirm_candidate']),
    )
    base['p30_publication_confirm_gate_v25']['claim_policy'] = 'P30 remains diagnostic until this v25 gate passes; empirical finite masks are useful diagnostics but not official-mask confirmation.'
    if base['p30_publication_confirm_gate_v25']['eligible_for_confirm_like']:
        base['status'] = 'density_kappa_publication_confirm_like'
    else:
        base['status'] = 'density_kappa_diagnostic_only'
    return base


def run_highz_unit_field_table_v25(meta, args):
    base = _run_highz_unit_field_table_v24_for_v25(meta, args)
    gate = base.get('highz_objectlevel_publication_gate_v24') or {}
    reports = base.get('highz_objectlevel_table_reports_v24') or []
    source_reports = {}
    for r in reports:
        g = r.get('source_group') or 'unknown'
        source_reports.setdefault(g, {'n_tables':0, 'n_object_rows':0, 'accepted_tables':0, 'unit_hints':[]})
        source_reports[g]['n_tables'] += 1
        source_reports[g]['n_object_rows'] += int(r.get('n_object_rows') or 0)
        if r.get('accepted'): source_reports[g]['accepted_tables'] += 1
        if r.get('velocity_unit_hint') or r.get('radius_unit_hint'):
            source_reports[g]['unit_hints'].append({'velocity': r.get('velocity_unit_hint'), 'radius': r.get('radius_unit_hint')})
    base['highz_source_specific_parser_plan_v25'] = {
        'source_groups_detected': source_reports,
        'required_source_parsers': {
            'KMOS3D/KGES': ['FITS binary table extraction','column aliases: VROT/VCIRC/VMAX + R/RD/R_E in kpc + z'],
            'KROSS': ['archive extraction','Halpha velocity table parser','disk radius parser'],
            'MOSDEF/SAMI': ['CSV/FITS table parser','unit header audit'],
        },
        'unsafe_velocity_columns_rejected': (base.get('highz_rejected_columns_v24') or {}).get('velocity', [])[:25],
        'avoid_binary_as_text': True,
    }
    base['highz_objectlevel_confirm_gate_v25'] = _v25_gate(
        object_rows_ge_30=(gate.get('n_object_rows') or 0) >= 30,
        two_sources=(gate.get('n_sources') or 0) >= 2,
        units_visible=bool(gate.get('unit_hints_visible')),
        median_above_local=bool(gate.get('median_above_local')),
        leave_one_source=bool(gate.get('leave_one_source_above_local')),
    )
    base['highz_objectlevel_confirm_gate_v25']['promotion_rule'] = 'P36 high-z major confirm requires strict object V^2/R rows, not proxy or broad velocity-column evidence.'
    if base['highz_objectlevel_confirm_gate_v25']['eligible_for_confirm_like']:
        base['status'] = 'highz_a0_objectlevel_publication_confirm_like'
    else:
        base['claim_scope_v25'] = 'proxy_confirm_like_until_object_level_V2_over_R_gate_passes'
    return base


def run_p33_density_bao_measured_scaffold_v25(meta, args):
    base = _run_p33_density_bao_measured_scaffold_v24_for_v25(meta, args)
    obs = base.get('observables') or []
    # Fill an explicit measured-alpha result schema. It will remain None until density-split catalogues/randoms are loaded.
    base['p33_density_split_alpha_result_v25'] = {
        'alpha_high_density': None,
        'alpha_low_density': None,
        'delta_alpha_high_minus_low': None,
        'covariance_ready': bool(base.get('cov_file')),
        'bao_observable_rows': len(obs),
        'random_catalogue_loaded': False,
        'density_split_catalogues_loaded': False,
        'density_label_shuffle_p': None,
        'sky_shuffle_p': None,
        'redshift_bin_jackknife': [],
        'claim_policy': 'measurement-ready only until high/low-density BAO alpha is fit using LSS data + random catalogues and covariance',
    }
    base['p33_publication_confirm_gate_v25'] = _v25_gate(
        density_split_catalogues_loaded=False,
        random_catalogue_loaded=False,
        covariance_ready=bool(base.get('cov_file')),
        alpha_high_low_measured=False,
        nulls_pass=False,
        redshift_jackknife_stable=False,
    )
    base['status'] = 'p33_density_bao_measurement_ready_not_confirmed'
    return base


def _v25_extract_q2_rows_stronger(txt):
    rows=[]
    for ln in txt.splitlines():
        s = ln.strip()
        if not s or len(s) > 5000: continue
        if '&' not in s and not _re_v25.search(r'(?i)q\^?2|gev\^?2|P_?5|R_?K|C_?9|A_?CP', s): continue
        blob = s.replace('$',' ')
        nums=[]
        for m in _re_v25.finditer(r'[-+]?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?', blob):
            try: nums.append(float(m.group(0)))
            except Exception: pass
        if len(nums) < 3: continue
        obs_match = _re_v25.search(r'(?i)(P_?5\s*\'?|R_?K\*?|F_?L|S_?\d+|A_?FB|A_?CP|C_?9|C_?10)', blob)
        q2_like = bool(_re_v25.search(r'(?i)q\^?2|gev\^?2|\[\s*\d+(?:\.\d+)?\s*,\s*\d+', blob))
        rows.append({'raw': s[:600], 'numbers': nums[:16], 'observable_hint': obs_match.group(0) if obs_match else None, 'has_q2_like': q2_like, 'cp_like': bool(_re_v25.search(r'(?i)A_?CP|ACP|CP asym', blob))})
    return rows[:1000]


def run_p41_structured_cp_v25(meta, args):
    base = _run_p41_structured_cp_v24_for_v25(meta, args)
    # Keep v24 parser, then add a stricter major-claim gate that refuses proxy-only CP confirms.
    audit = base.get('p41_q2_likelihood_table_audit_v24') or {}
    qrows = audit.get('rows_preview') or []
    # Try to parse any downloaded/supplement candidate text again with a more permissive q² parser.
    paths=[]
    for key in ('downloaded','p41_v21_structured_candidates'):
        for item in base.get(key, []) or []:
            if isinstance(item, dict) and item.get('path'):
                try:
                    p = _v23_to_path(item.get('path'), _Path_v25.cwd())
                    if p: paths.append(p)
                except Exception: pass
    extra=[]
    for p in paths[:40]:
        try:
            txt = read_text_any(p, max_bytes=6_000_000)
            extra.extend(_v25_extract_q2_rows_stronger(txt))
        except Exception:
            pass
    cp = [r for r in extra if r.get('cp_like')]
    noncp = [r for r in extra if not r.get('cp_like')]
    base['p41_q2_likelihood_major_claim_gate_v25'] = _v25_gate(
        q2_numeric_rows=len(extra) >= 20,
        cp_control_rows=len(cp) >= 3,
        noncp_observable_rows=len(noncp) >= 10,
        has_uncertainty_like_rows=any(len(r.get('numbers') or []) >= 4 for r in extra),
        wilson_coefficient_fit=False,
    )
    base['p41_q2_likelihood_major_claim_gate_v25'].update({'n_q2_rows_strong_parser': len(extra), 'n_cp_rows': len(cp), 'n_noncp_rows': len(noncp), 'rows_preview': extra[:10], 'promotion_rule': 'major P41 confirmation requires q²-binned numeric likelihood rows plus CP controls and a Wilson-coefficient/SM comparison fit'})
    if not base['p41_q2_likelihood_major_claim_gate_v25']['eligible_for_confirm_like']:
        base['claim_scope_v25'] = 'structured_proxy_confirm_like_until_q2_likelihood_major_claim_gate_passes'
    return base


def run_ringdown_strain_plan_v25(meta, args):
    base = _run_ringdown_strain_plan_v24_for_v25(meta, args)
    manifest = base.get('ringdown_gwosc_download_manifest_v24') or {}
    events = manifest.get('events') or []
    # Add explicit GWOSC query URL templates without downloading strain here.
    for e in events:
        ev = e.get('event')
        if ev:
            e['gwosc_event_json_url_template'] = f'https://www.gw-openscience.org/eventapi/json/GWTC-3-confident/{ev}/v1/'
            e['strain_download_policy'] = 'download detector strain around event GPS; cache by detector and sample rate; never promote from metadata alone'
    base['ringdown_strain_confirm_gate_v25'] = _v25_gate(
        event_json_loaded=False,
        strain_downloaded=False,
        psd_estimated=False,
        gr_ringdown_fit=False,
        ccdr_residual_template_fit=False,
        injection_nulls=False,
        detector_split=False,
        leave_one_event_out=False,
    )
    base['ringdown_strain_confirm_gate_v25']['promotion_rule'] = 'P32 confirm requires strain-level residual improvement with injection/null controls and detector/event splits.'
    return base


def run_hepdata_schema_hardened_v25(meta, args):
    base = _run_hepdata_schema_hardened_v24_for_v25(meta, args)
    base['hepdata_endpoint_only_policy_v25'] = {
        'accepted_evidence_endpoints': ['table-level CSV', 'table-level JSON', 'table-level YAML'],
        'rejected_as_claim_evidence': ['record HTML pages', 'generic API previews', 'text snippets without units'],
        'unit_columns_required': True,
        'schema_promotion_limits': {'valid_schema_rows': 'positive_ready', 'physics_statistic_with_nulls': 'confirm_like'},
    }
    return base


def run_direct_detection_units_v25(meta, args):
    base = _run_direct_detection_units_v24_for_v25(meta, args)
    base['direct_detection_detection_policy_v25'] = {
        'coverage_claim_allowed': True,
        'detection_claim_allowed': False,
        'requires': ['event-level likelihood or collaboration detection claim', 'mass unit verified', 'cross-section/limit unit verified', 'background model'],
        'mass_window_GeV': [500, 3000],
    }
    return base


def run_smd_constants_pack_v25(meta, args):
    base = _run_smd_constants_pack_v24_for_v25(meta, args)
    rec = base.get('constant_record') or {}
    observed = _v25_float(rec.get('observed'))
    target = _v25_float(rec.get('target'))
    base['smd_derivation_mode_v25'] = {
        'ccdr_predicted_value': None,
        'observed_value': observed,
        'lookup_target_value': target,
        'uncertainty': None,
        'residual_sigma': None,
        'falsification_threshold_sigma': 5,
        'derivation_confirm_like': False,
        'claim_policy': 'constant lookup consistency remains useful but is not a CCDR derivation confirmation',
    }
    base['claim_scope_v25'] = 'constant_consistency_not_derivation_confirm'
    return base


def run_koide_constants_v25(meta, args):
    base = _run_koide_constants_v24_for_v25(meta, args)
    q = _v25_float(base.get('koide_Q') or (base.get('constant_record') or {}).get('Q'))
    base['smd_derivation_mode_v25'] = {
        'ccdr_predicted_relation': None,
        'observed_Q': q,
        'lookup_target_2_over_3': 2.0/3.0,
        'uncertainty': None,
        'residual_sigma': None,
        'falsification_threshold_sigma': 5,
        'derivation_confirm_like': False,
        'claim_policy': 'Koide remains a strong numerical consistency check until CCDR derives the relation with uncertainty',
    }
    base['claim_scope_v25'] = 'koide_constant_consistency_not_derivation_confirm'
    return base


def run_dashboard_v25(meta, args):
    base = _run_dashboard_v24_for_v25(meta, args)
    out = _Path_v25.cwd() / 'outputs'
    rows=[]
    if out.exists():
        for p in sorted(out.glob('test*.json')):
            try: rows.append(_json_v25.loads(p.read_text(encoding='utf-8')))
            except Exception: pass
    v25=[]; pub=[]; proxy=[]; blocked=[]
    for r in rows:
        keys=sorted([k for k in r if k.endswith('_v25') or '_v25_' in k])
        if keys:
            v25.append({'test_id': r.get('test_id'), 'prediction_id': r.get('prediction_id'), 'status': r.get('status'), 'v25_keys': keys})
        st=str(r.get('status',''))
        if 'publication_confirm_like' in st or st in ('robust_confirm_like','void_morphology_publication_grade_confirm_like'):
            pub.append({'test_id': r.get('test_id'), 'prediction_id': r.get('prediction_id'), 'status': st})
        if 'proxy' in str(r.get('claim_scope_v25','')) or 'proxy' in st:
            proxy.append({'test_id': r.get('test_id'), 'prediction_id': r.get('prediction_id'), 'status': st, 'claim_scope_v25': r.get('claim_scope_v25')})
        for k,v in r.items():
            if isinstance(v, dict) and k.endswith('_gate_v25') and not v.get('eligible_for_confirm_like', True):
                blocked.append({'test_id': r.get('test_id'), 'prediction_id': r.get('prediction_id'), 'gate': k, 'missing': v.get('missing')})
    base['dashboard_v25'] = {
        'n_v25_instrumented_tests': len(v25),
        'v25_instrumented_tests': v25[:100],
        'publication_grade_confirm_like': pub,
        'proxy_or_candidate_claims': proxy[:50],
        'blocked_confirm_gates': blocked[:80],
        'claim_policy': 'v25 distinguishes publication-grade confirms from proxy/coverage/readiness/constant-consistency claims',
    }
    base['status'] = 'dashboard_positive_summary'
    return base


RUNNERS.update({
    'p30_maskrandom_freeze_v22': run_p30_maskrandom_freeze_v25,
    'highz_unit_field_table_v22': run_highz_unit_field_table_v25,
    'p33_density_bao_measured_scaffold_v22': run_p33_density_bao_measured_scaffold_v25,
    'p41_structured_cp_v22': run_p41_structured_cp_v25,
    'ringdown_strain_plan_v22': run_ringdown_strain_plan_v25,
    'hepdata_schema_hardened_v22': run_hepdata_schema_hardened_v25,
    'direct_detection_units_v22': run_direct_detection_units_v25,
    'smd_constants_pack': run_smd_constants_pack_v25,
    'koide_constants': run_koide_constants_v25,
    'dashboard_v22': run_dashboard_v25,
})

# -------------------------- Round-10 v26 confirm execution hardening --------------------------
# v26 implements the 10 latest confirmation improvements without loosening claim policy:
# P30 official/equivalent mask + random-density + science variants + route split,
# P36 source-specific object V^2/R extraction + image-FITS rejection,
# P33 measured density-split BAO alpha contract,
# P41 CP-control + Wilson/SM major-claim gate,
# P32 strain execution gate, and SM-D derivation gates.
from pathlib import Path as _Path_v26
import json as _json_v26
import re as _re_v26
import math as _math_v26
import csv as _csv_v26

_run_p30_v25_for_v26 = run_p30_maskrandom_freeze_v25
_run_highz_v25_for_v26 = run_highz_unit_field_table_v25
_run_p33_v25_for_v26 = run_p33_density_bao_measured_scaffold_v25
_run_p41_v25_for_v26 = run_p41_structured_cp_v25
_run_ringdown_v25_for_v26 = run_ringdown_strain_plan_v25
_run_smd_v25_for_v26 = run_smd_constants_pack_v25
_run_koide_v25_for_v26 = run_koide_constants_v25
_run_dashboard_v25_for_v26 = run_dashboard_v25


def _v26_float(x):
    try:
        if x is None:
            return None
        v = float(x)
        return v if _math_v26.isfinite(v) else None
    except Exception:
        return None


def _v26_gate(**items):
    missing = [k for k, v in items.items() if not bool(v)]
    out = dict(items)
    out['eligible_for_confirm_like'] = not missing
    out['missing'] = missing
    return out


def _v26_cache_root(args):
    return _Path_v26(getattr(args, 'cache_dir', '.ccdr_round10_cache'))


def _v26_cache_files(args, pattern=None, max_items=4000):
    root = _v26_cache_root(args)
    out = []
    if not root.exists():
        return out
    rx = _re_v26.compile(pattern, _re_v26.I) if pattern else None
    for p in root.rglob('*'):
        if not p.is_file():
            continue
        sp = str(p)
        if rx is None or rx.search(sp):
            out.append(p)
            if len(out) >= max_items:
                break
    return out


def _v26_table_columns_from_csv(path, max_bytes=2_000_000):
    try:
        txt = path.read_text(encoding='utf-8', errors='ignore')[:max_bytes]
        lines = [ln for ln in txt.splitlines() if ln.strip() and not ln.lstrip().startswith('#')]
        if not lines:
            return [], []
        sample = '\n'.join(lines[:20])
        try:
            dialect = _csv_v26.Sniffer().sniff(sample, delimiters=',\t ;|')
            delim = dialect.delimiter
        except Exception:
            delim = ',' if ',' in lines[0] else None
        if delim:
            cols = [c.strip() for c in lines[0].split(delim)]
            data = []
            for ln in lines[1:101]:
                vals = [v.strip() for v in ln.split(delim)]
                if len(vals) == len(cols):
                    data.append(dict(zip(cols, vals)))
            return cols, data
        parts = lines[0].split()
        data = []
        for ln in lines[1:101]:
            vals = ln.split()
            if len(vals) == len(parts):
                data.append(dict(zip(parts, vals)))
        return parts, data
    except Exception:
        return [], []


def _v26_fits_table_summaries(path):
    out = []
    try:
        from astropy.io import fits
        with fits.open(path, memmap=True) as hdul:
            for i, hdu in enumerate(hdul):
                cls = hdu.__class__.__name__
                cols = []
                nrows = 0
                is_image = False
                shape = None
                try:
                    shape = tuple(hdu.data.shape) if getattr(hdu, 'data', None) is not None else None
                    is_image = cls in ('PrimaryHDU', 'ImageHDU') and shape is not None
                except Exception:
                    pass
                try:
                    cols = list(hdu.columns.names or [])
                    nrows = int(len(hdu.data)) if hdu.data is not None else 0
                except Exception:
                    pass
                out.append({'hdu': i, 'class': cls, 'columns': cols, 'nrows': nrows, 'shape': shape, 'image_only': bool(is_image and not cols)})
    except Exception as e:
        out.append({'error': str(e)[:200]})
    return out


def _v26_alias_match(columns, aliases, reject=None):
    reject = reject or []
    for c in columns:
        lc = str(c).lower()
        if any(_re_v26.search(r, lc) for r in reject):
            continue
        if any(_re_v26.fullmatch(a, lc) or _re_v26.search(a, lc) for a in aliases):
            return c
    return None


def _v26_source_group(path):
    s = str(path).lower()
    if 'kmos' in s or 'kges' in s:
        return 'KMOS3D/KGES'
    if 'kross' in s:
        return 'KROSS'
    if 'mosdef' in s:
        return 'MOSDEF'
    if 'sami' in s:
        return 'SAMI'
    if 'sinfoni' in s:
        return 'SINFONI'
    return 'unknown'


def _v26_scan_highz_object_tables(args, max_files=250):
    files = _v26_cache_files(args, r'(?i)(kmos|kges|kross|mosdef|sami|sinfoni|highz|vrot|vcirc|vmax|hafits|fits|csv|tsv|txt)', max_items=max_files)
    velocity_aliases = [r'(^|_)(vrot|v_rot|vcirc|v_circ|vmax|v_max|vflat|v_flat|rotvel|vout|velocity_rot)(_|$)', r'(^|_)v2p2(_|$)']
    radius_aliases = [r'(^|_)(r|rad|radius|r_kpc|rkpc|r_e|re|r_eff|reff|rdisk|r_d|scale_radius)(_|$)']
    redshift_aliases = [r'(^|_)(z|redshift|zspec|z_spec|zphot|z_phot)(_|$)']
    bad_velocity = [r'pa$', r'position.?angle', r'angle', r'incl', r'sigma', r'err', r'error', r'disp', r'width', r'fwhm']
    reports = []
    n_obj = 0
    sources = set()
    image_rejections = []
    for p in files:
        suffix = p.suffix.lower()
        group = _v26_source_group(p)
        if suffix in ('.fits', '.fit', '.fz') or 'fits' in p.name.lower():
            summaries = _v26_fits_table_summaries(p)
            for s in summaries:
                if s.get('image_only'):
                    image_rejections.append({'path': str(p), 'hdu': s.get('hdu'), 'shape': s.get('shape'), 'reason': 'image_hdu_not_object_table'})
                    continue
                cols = s.get('columns') or []
                if not cols:
                    continue
                vcol = _v26_alias_match(cols, velocity_aliases, bad_velocity)
                rcol = _v26_alias_match(cols, radius_aliases)
                zcol = _v26_alias_match(cols, redshift_aliases)
                accepted = bool(vcol and rcol and zcol and (s.get('nrows') or 0) > 0)
                if accepted:
                    n_obj += int(s.get('nrows') or 0)
                    sources.add(group)
                reports.append({'path': str(p), 'source_group': group, 'format': 'fits', 'hdu': s.get('hdu'), 'nrows': s.get('nrows'), 'v_col': vcol, 'r_col': rcol, 'z_col': zcol, 'accepted_object_table': accepted, 'columns_preview': cols[:30]})
        elif suffix in ('.csv', '.tsv', '.txt', '.dat'):
            cols, rows = _v26_table_columns_from_csv(p)
            if not cols:
                continue
            vcol = _v26_alias_match(cols, velocity_aliases, bad_velocity)
            rcol = _v26_alias_match(cols, radius_aliases)
            zcol = _v26_alias_match(cols, redshift_aliases)
            accepted = bool(vcol and rcol and zcol and rows)
            if accepted:
                n_obj += len(rows)
                sources.add(group)
            reports.append({'path': str(p), 'source_group': group, 'format': suffix.lstrip('.'), 'nrows_sampled': len(rows), 'v_col': vcol, 'r_col': rcol, 'z_col': zcol, 'accepted_object_table': accepted, 'columns_preview': cols[:30]})
    return {'n_scanned_files': len(files), 'n_object_rows': n_obj, 'n_sources': len([s for s in sources if s != 'unknown']), 'sources': sorted(sources), 'reports': reports[:120], 'image_fits_rejections': image_rejections[:120]}


def run_p30_maskrandom_freeze_v26(meta, args):
    base = _run_p30_v25_for_v26(meta, args)
    # 1. Official/equivalent ACT mask: retain strict official gate, but expose a documented empirical-equivalent diagnostic object.
    act_probe = (base.get('act_probe_v18') or {}).get('best_sanity') or (base.get('act_alm_probe_v16') or {}).get('best_sanity') or {}
    finite_fraction = _v26_float(act_probe.get('finite_fraction'))
    n_finite = act_probe.get('n_finite_pixels')
    n_total = act_probe.get('n_total_pixels')
    official = (base.get('p30_act_mask_gate_v25') or {}).get('official_mask_candidates') or []
    empirical_equiv = bool(finite_fraction and finite_fraction > 0.95 and n_finite and n_total)
    base['p30_act_mask_or_equivalent_v26'] = {
        'official_mask_candidates': official,
        'official_mask_found': bool(official),
        'empirical_finite_support_mask': empirical_equiv,
        'finite_fraction': finite_fraction,
        'n_finite_pixels': n_finite,
        'n_total_pixels': n_total,
        'claim_scope': 'official_mask_confirm' if official else 'empirical_equivalent_diagnostic_only',
        'recommended_next': 'If ACT tarball has no explicit mask, persist the empirical finite-support mask as a named mask product and rerun all variants/randoms through it.'
    }
    # 2. Random density normalization: discover candidates and provide concrete ADQL/file templates.
    random_files = _v26_cache_files(args, r'(?i)(random|randoms|ran_|rand|masknorm|selection|mangle|window)', max_items=200)
    base['p30_random_density_normalization_v26'] = {
        'random_files_found': [str(p) for p in random_files[:50]],
        'random_density_available': bool(random_files),
        'required_overdensity_formula': 'delta = (N_data / max(N_random,1)) - 1 after applying the same ACT mask and survey selection',
        'euclid_adql_template': 'SELECT TOP {N} right_ascension AS ra, declination AS dec FROM catalogue.mer_catalogue WHERE right_ascension IS NOT NULL AND declination IS NOT NULL; then generate angular randoms in the same RA/Dec footprint and quality-mask cells',
        'sdss_random_file_patterns': ['*_random*.fits.gz', '*_ran*.fits.gz', 'random0_DR*.fits.gz'],
        'confirm_gate_requires_real_randoms': True,
    }
    # 3. Variant consistency under identical route: split baseline/euclid/science variants and curl.
    variant_rows = (base.get('p30_science_variant_consistency_v25') or {}).get('science_variants') or []
    positives = [v for v in variant_rows if v.get('positive')]
    negatives = [v for v in variant_rows if v.get('delta_high_minus_low') is not None and not v.get('positive')]
    base['p30_variant_route_matrix_v26'] = {
        'science_variants': variant_rows,
        'n_positive': len(positives),
        'n_negative': len(negatives),
        'all_positive': bool(variant_rows) and len(negatives) == 0,
        'two_or_more_positive': len(positives) >= 2,
        'same_density_bins_required': True,
        'interpretation': 'Variant agreement is only counted after all variants use the same density bins and the same ACT mask/random-normalized density field.'
    }
    # 4. Separate SDSS and Euclid claims instead of merging.
    routes = (base.get('p30_route_separation_v25') or {}).get('routes') or {}
    base['p30_independent_route_claims_v26'] = {
        'sdss': {**(routes.get('sdss') or {}), 'claim_status': 'candidate_positive_route' if (routes.get('sdss') or {}).get('positive') else 'not_positive'},
        'euclid': {**(routes.get('euclid') or {}), 'claim_status': 'candidate_positive_route' if (routes.get('euclid') or {}).get('positive') else 'not_positive_or_mixed'},
        'merge_allowed': False,
        'promotion_rule': 'Publish SDSS and Euclid routes separately until both pass the same mask/random/variant gates.'
    }
    old_gate = base.get('p30_publication_confirm_gate_v25') or {}
    base['p30_publication_confirm_gate_v26'] = _v26_gate(
        official_or_documented_equivalent_mask=bool(official),
        random_density=bool(random_files),
        estimator_agreement=bool((base.get('p30_mask_random_confirm_gate_v22') or {}).get('estimator_agreement')),
        science_variants=bool(base['p30_variant_route_matrix_v26']['two_or_more_positive'] and not negatives),
        curl_control=bool(old_gate.get('curl_control')),
        separated_positive_route=bool((routes.get('sdss') or {}).get('positive') or (routes.get('euclid') or {}).get('positive')),
    )
    base['p30_publication_confirm_gate_v26']['claim_policy'] = 'P30 remains diagnostic unless v26 mask/random/variant/curl/route gates pass. Empirical masks alone do not create publication confirm.'
    base['status'] = 'density_kappa_publication_confirm_like' if base['p30_publication_confirm_gate_v26']['eligible_for_confirm_like'] else 'density_kappa_diagnostic_only'
    return base


def run_highz_unit_field_table_v26(meta, args):
    base = _run_highz_v25_for_v26(meta, args)
    scan = _v26_scan_highz_object_tables(args)
    base['highz_source_specific_object_scan_v26'] = scan
    gate_prev = base.get('highz_objectlevel_confirm_gate_v25') or {}
    n_rows = max(int(scan.get('n_object_rows') or 0), int((base.get('highz_objectlevel_publication_gate_v24') or {}).get('n_object_rows') or 0))
    n_sources = max(int(scan.get('n_sources') or 0), int((base.get('highz_objectlevel_publication_gate_v24') or {}).get('n_sources') or 0))
    base['highz_image_fits_rejection_v26'] = {
        'n_image_fits_rejected': len(scan.get('image_fits_rejections') or []),
        'examples': (scan.get('image_fits_rejections') or [])[:20],
        'policy': 'Image FITS / velocity-field maps do not count as object-level Vrot/R/z rows unless a binary table with object rows is present.'
    }
    base['highz_objectlevel_confirm_gate_v26'] = _v26_gate(
        object_rows_ge_30=n_rows >= 30,
        two_sources=n_sources >= 2,
        units_visible=bool(gate_prev.get('units_visible') or (base.get('highz_objectlevel_publication_gate_v24') or {}).get('unit_hints_visible')),
        median_above_local=bool(gate_prev.get('median_above_local')),
        leave_one_source=bool(gate_prev.get('leave_one_source')),
        image_fits_not_counted=True,
    )
    base['highz_objectlevel_confirm_gate_v26'].update({'n_object_rows_considered': n_rows, 'n_sources_considered': n_sources, 'promotion_rule': 'Major P36 high-z confirm requires strict object-level Vrot/R/z rows from >=2 sources and stable median acceleration above local SPARC.'})
    if base['highz_objectlevel_confirm_gate_v26']['eligible_for_confirm_like']:
        base['status'] = 'highz_a0_objectlevel_publication_confirm_like'
    return base


def run_p33_density_bao_measured_scaffold_v26(meta, args):
    base = _run_p33_v25_for_v26(meta, args)
    # 7. Explicit measured-alpha contract and result slots. This refuses to promote compressed BAO-only runs.
    randoms = _v26_cache_files(args, r'(?i)(desi|sdss|boss|eboss).*(random|ran)', max_items=50)
    data_lss = _v26_cache_files(args, r'(?i)(desi|sdss|boss|eboss).*(lss|clustering|data|galaxy|catalog)', max_items=50)
    base['p33_density_split_bao_alpha_measurement_v26'] = {
        'lss_catalogue_candidates': [str(p) for p in data_lss[:20]],
        'random_catalogue_candidates': [str(p) for p in randoms[:20]],
        'density_split_catalogues_loaded': bool(data_lss),
        'random_catalogues_loaded': bool(randoms),
        'alpha_high_density': None,
        'alpha_low_density': None,
        'delta_alpha_high_minus_low': None,
        'covariance_ready': bool(base.get('cov_file')),
        'required_nulls': ['density_label_shuffle', 'sky_shuffle', 'redshift_bin_jackknife'],
        'fit_model': 'xi(s)=B^2 xi_BAO(alpha*s)+broadband separately in high/low density; compare Delta alpha with jackknife covariance',
    }
    base['p33_publication_confirm_gate_v26'] = _v26_gate(
        density_split_catalogues_loaded=bool(data_lss),
        random_catalogues_loaded=bool(randoms),
        covariance_ready=bool(base.get('cov_file')),
        alpha_high_low_measured=False,
        nulls_pass=False,
        redshift_jackknife_stable=False,
    )
    base['status'] = 'p33_density_bao_measurement_ready_not_confirmed'
    return base


def _v26_extract_p41_rows_from_text(txt, limit=2000):
    rows = []
    cp_terms = _re_v26.compile(r'(?i)(A_?CP|ACP|CP\s*asym|charge\s*asym|\bCP\b)')
    obs_terms = _re_v26.compile(r"(?i)(P_?5\s*'?|R_?K\*?|F_?L|S_?\d+|A_?FB|C_?9|C_?10|BR|branching)")
    for ln in txt.splitlines():
        s = ln.strip()
        if not s or len(s) > 5000:
            continue
        if not (obs_terms.search(s) or cp_terms.search(s) or 'q^2' in s.lower() or 'gev' in s.lower()):
            continue
        nums = []
        for m in _re_v26.finditer(r'[-+]?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?', s):
            try:
                nums.append(float(m.group(0)))
            except Exception:
                pass
        if len(nums) < 3:
            continue
        rows.append({'raw': s[:700], 'n_numbers': len(nums), 'numbers': nums[:12], 'cp_control_like': bool(cp_terms.search(s)), 'observable_hint': (obs_terms.search(s).group(0) if obs_terms.search(s) else None), 'uncertainty_like': bool(_re_v26.search(r'±|\+\s*[-+]?\d|stat|syst|err|error|unc', s, _re_v26.I))})
        if len(rows) >= limit:
            break
    return rows


def run_p41_structured_cp_v26(meta, args):
    base = _run_p41_v25_for_v26(meta, args)
    paths = []
    for item in (base.get('downloaded') or []) + (base.get('p41_v21_structured_candidates') or []):
        if isinstance(item, dict) and item.get('path'):
            try:
                p = _Path_v26(item.get('path'))
                if not p.exists():
                    p = _Path_v26.cwd() / item.get('path')
                if p.exists():
                    paths.append(p)
            except Exception:
                pass
    rows = []
    for p in paths[:60]:
        try:
            rows.extend(_v26_extract_p41_rows_from_text(read_text_any(p, max_bytes=8_000_000)))
        except Exception:
            pass
    cp_rows = [r for r in rows if r.get('cp_control_like')]
    noncp = [r for r in rows if not r.get('cp_control_like')]
    unc = [r for r in rows if r.get('uncertainty_like') or r.get('n_numbers',0) >= 4]
    base['p41_cp_control_extraction_v26'] = {
        'n_rows': len(rows),
        'n_cp_control_rows': len(cp_rows),
        'n_noncp_rows': len(noncp),
        'n_uncertainty_like_rows': len(unc),
        'cp_examples': cp_rows[:10],
        'noncp_examples': noncp[:10],
    }
    base['p41_wilson_sm_fit_gate_v26'] = _v26_gate(
        q2_numeric_rows=len(rows) >= 20,
        cp_control_rows=len(cp_rows) >= 3,
        noncp_observable_rows=len(noncp) >= 10,
        uncertainty_rows=len(unc) >= 10,
        wilson_or_sm_fit=False,
    )
    base['p41_wilson_sm_fit_gate_v26']['promotion_rule'] = 'Major P41 confirm requires numeric q²-binned likelihood plus CP controls and explicit SM/Wilson coefficient comparison.'
    if not base['p41_wilson_sm_fit_gate_v26']['eligible_for_confirm_like']:
        base['claim_scope_v26'] = 'structured_proxy_confirm_like_until_cp_control_and_wilson_fit_pass'
    return base


def run_ringdown_strain_plan_v26(meta, args):
    base = _run_ringdown_v25_for_v26(meta, args)
    events = ((base.get('ringdown_gwosc_download_manifest_v24') or {}).get('events') or [])[:10]
    base['ringdown_executable_plan_v26'] = {
        'top_events': events,
        'command_template': 'python tests/test19_p32_ringdown_high_snr_scaffold.py --allow-large --strain --events GW150914,GW190521 --detectors H1,L1,V1 --sample-rate 4096 --window-s 32',
        'steps': ['download GWOSC event JSON', 'download strain around GPS', 'estimate PSD', 'fit GR damped modes', 'fit CCDR residual template', 'injection nulls', 'detector split', 'leave-one-event-out'],
        'promotion_note': 'metadata ranking never promotes; only strain-level residual statistics can promote P32',
    }
    base['ringdown_strain_confirm_gate_v26'] = _v26_gate(
        event_json_loaded=False,
        strain_downloaded=False,
        psd_estimated=False,
        gr_ringdown_fit=False,
        ccdr_residual_template_fit=False,
        injection_nulls=False,
        detector_split=False,
        leave_one_event_out=False,
    )
    return base


def run_smd_constants_pack_v26(meta, args):
    base = _run_smd_v25_for_v26(meta, args)
    base['smd_derivation_gate_v26'] = _v26_gate(
        ccdr_predicted_value_present=False,
        uncertainty_present=False,
        residual_sigma_present=False,
        falsification_threshold_present=True,
        independent_of_lookup_target=False,
    )
    base['smd_derivation_gate_v26']['claim_policy'] = 'SM-D constant agreement is not a derivation confirm until CCDR-derived values with uncertainties are output without using lookup targets.'
    base['claim_scope_v26'] = 'constant_consistency_not_derivation_confirm'
    return base


def run_koide_constants_v26(meta, args):
    base = _run_koide_v25_for_v26(meta, args)
    base['smd_derivation_gate_v26'] = _v26_gate(
        ccdr_predicted_relation_present=False,
        uncertainty_present=False,
        residual_sigma_present=False,
        falsification_threshold_present=True,
        independent_of_lookup_target=False,
    )
    base['smd_derivation_gate_v26']['claim_policy'] = 'Koide remains a numerical consistency check until CCDR derives the 2/3 relation with uncertainty and falsification threshold.'
    base['claim_scope_v26'] = 'koide_consistency_not_derivation_confirm'
    return base


def run_dashboard_v26(meta, args):
    base = _run_dashboard_v25_for_v26(meta, args)
    out = _Path_v26.cwd() / 'outputs'
    rows = []
    if out.exists():
        for p in sorted(out.glob('test*.json')):
            try:
                rows.append(_json_v26.loads(p.read_text(encoding='utf-8')))
            except Exception:
                pass
    v26 = []
    pub = []
    blocked = []
    for r in rows:
        keys = sorted([k for k in r if k.endswith('_v26') or '_v26_' in k])
        if keys:
            v26.append({'test_id': r.get('test_id'), 'prediction_id': r.get('prediction_id'), 'status': r.get('status'), 'v26_keys': keys})
        st = str(r.get('status',''))
        if 'publication_confirm_like' in st or st in ('robust_confirm_like', 'void_morphology_publication_grade_confirm_like'):
            pub.append({'test_id': r.get('test_id'), 'prediction_id': r.get('prediction_id'), 'status': st})
        for k, v in r.items():
            if isinstance(v, dict) and k.endswith('_gate_v26') and not v.get('eligible_for_confirm_like', True):
                blocked.append({'test_id': r.get('test_id'), 'prediction_id': r.get('prediction_id'), 'gate': k, 'missing': v.get('missing')})
    base['dashboard_v26'] = {
        'n_v26_instrumented_tests': len(v26),
        'v26_instrumented_tests': v26[:120],
        'publication_grade_confirm_like': pub,
        'blocked_confirm_gates': blocked[:120],
        'claim_policy': 'v26 requires operational mask/random/object-row/q²/strain/derivation gates before major confirms.',
    }
    base['status'] = 'dashboard_positive_summary'
    return base


RUNNERS.update({
    'p30_maskrandom_freeze_v22': run_p30_maskrandom_freeze_v26,
    'highz_unit_field_table_v22': run_highz_unit_field_table_v26,
    'p33_density_bao_measured_scaffold_v22': run_p33_density_bao_measured_scaffold_v26,
    'p41_structured_cp_v22': run_p41_structured_cp_v26,
    'ringdown_strain_plan_v22': run_ringdown_strain_plan_v26,
    'smd_constants_pack': run_smd_constants_pack_v26,
    'koide_constants': run_koide_constants_v26,
    'dashboard_v22': run_dashboard_v26,
})

# -------------------------- Round-10 v27 confirm-execution patch --------------------------
# v27 implements the ten requested operational improvements on top of v26.  It still
# keeps the claim policy strict: route-specific positives may be reported, but global
# confirmation only promotes when mask/random/variant/object/q2/strain gates pass.
from pathlib import Path as _Path_v27
import json as _json_v27
import math as _math_v27
import random as _random_v27
import re as _re_v27
import csv as _csv_v27

_run_p30_v26_for_v27 = run_p30_maskrandom_freeze_v26
_run_highz_v26_for_v27 = run_highz_unit_field_table_v26
_run_p33_v26_for_v27 = run_p33_density_bao_measured_scaffold_v26
_run_p41_v26_for_v27 = run_p41_structured_cp_v26
_run_ringdown_v26_for_v27 = run_ringdown_strain_plan_v26
_run_smd_v26_for_v27 = run_smd_constants_pack_v26
_run_koide_v26_for_v27 = run_koide_constants_v26
_run_dashboard_v26_for_v27 = run_dashboard_v26


def _v27_float(x):
    try:
        if x is None:
            return None
        v = float(x)
        return v if _math_v27.isfinite(v) else None
    except Exception:
        return None


def _v27_gate(**items):
    missing = [k for k, v in items.items() if not bool(v)]
    out = dict(items)
    out['eligible_for_confirm_like'] = not missing
    out['missing'] = missing
    return out


def _v27_cache_dir(args):
    return _Path_v27(getattr(args, 'cache_dir', '.ccdr_round10_cache'))


def _v27_write_json(path, obj):
    path = _Path_v27(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(_json_v27.dumps(obj, indent=2, sort_keys=True, ensure_ascii=False), encoding='utf-8')
    return str(path)


def _v27_resolve_path(p):
    if not p:
        return None
    q = _Path_v27(str(p))
    if q.exists():
        return q
    q2 = _Path_v27.cwd() / str(p)
    if q2.exists():
        return q2
    return q


def _v27_load_coord_csv(path, max_rows=200000):
    path = _v27_resolve_path(path)
    if not path or not path.exists():
        return {'available': False, 'path': str(path) if path else None, 'reason': 'missing'}
    rows = []
    try:
        with path.open('r', encoding='utf-8', errors='ignore', newline='') as f:
            snip = f.read(4096)
            f.seek(0)
            dialect = _csv_v27.Sniffer().sniff(snip, delimiters=',;\t| ')
            rdr = _csv_v27.DictReader(f, dialect=dialect)
            if not rdr.fieldnames:
                return {'available': False, 'path': str(path), 'reason': 'no_header'}
            fields = {c.lower().strip(): c for c in rdr.fieldnames}
            ra_col = next((fields[k] for k in fields if k in ('ra','raj2000','right_ascension','alpha','ra_deg') or 'right_ascension' in k), None)
            dec_col = next((fields[k] for k in fields if k in ('dec','dej2000','declination','delta','dec_deg') or 'declination' in k), None)
            if not ra_col or not dec_col:
                return {'available': False, 'path': str(path), 'reason': 'no_ra_dec', 'fieldnames': rdr.fieldnames[:30]}
            for i, row in enumerate(rdr):
                if i >= max_rows:
                    break
                ra = _v27_float(row.get(ra_col)); dec = _v27_float(row.get(dec_col))
                if ra is not None and dec is not None and -90 <= dec <= 90:
                    rows.append((ra % 360.0, dec))
    except Exception as e:
        return {'available': False, 'path': str(path), 'reason': 'read_error', 'error': str(e)[:200]}
    if len(rows) < 10:
        return {'available': False, 'path': str(path), 'reason': 'too_few_rows', 'n_rows': len(rows)}
    ras = [r[0] for r in rows]; decs = [r[1] for r in rows]
    return {'available': True, 'path': str(path), 'rows': rows, 'n_rows': len(rows), 'ra_min': min(ras), 'ra_max': max(ras), 'dec_min': min(decs), 'dec_max': max(decs)}


def _v27_make_random_catalogue(coord_info, out_path, seed=27030, n_random=None):
    if not coord_info.get('available'):
        return {'created': False, 'reason': coord_info.get('reason'), 'source_path': coord_info.get('path')}
    rows = coord_info.get('rows') or []
    n_data = len(rows)
    n_random = int(n_random or min(max(n_data * 5, 5000), 200000))
    rng = _random_v27.Random(seed)
    ra_min, ra_max = coord_info['ra_min'], coord_info['ra_max']
    dec_min, dec_max = coord_info['dec_min'], coord_info['dec_max']
    out_path = _Path_v27(out_path)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    with out_path.open('w', encoding='utf-8', newline='') as f:
        w = _csv_v27.writer(f)
        w.writerow(['ra','dec','random_weight','mask_name','generation'])
        for _ in range(n_random):
            # uniform over the rectangle in sin(dec), sufficient for a route diagnostic random field
            ra = rng.uniform(ra_min, ra_max)
            s0 = _math_v27.sin(_math_v27.radians(dec_min)); s1 = _math_v27.sin(_math_v27.radians(dec_max))
            dec = _math_v27.degrees(_math_v27.asin(rng.uniform(min(s0,s1), max(s0,s1))))
            w.writerow([f'{ra:.8f}', f'{dec:.8f}', '1.0', 'empirical_finite_support_v27', 'v27_rectangular_sindec'])
    return {'created': True, 'path': str(out_path), 'n_data': n_data, 'n_random': n_random, 'ra_range': [ra_min, ra_max], 'dec_range': [dec_min, dec_max], 'density_definition_ready': True}


def _v27_simple_density_bins(coord_info, n_ra=12, n_dec=8):
    if not coord_info.get('available'):
        return {'available': False, 'reason': coord_info.get('reason')}
    rows = coord_info.get('rows') or []
    if not rows:
        return {'available': False, 'reason': 'empty'}
    ra_min, ra_max = coord_info['ra_min'], coord_info['ra_max']; dec_min, dec_max = coord_info['dec_min'], coord_info['dec_max']
    bins = {}
    for ra, dec in rows:
        ira = int((ra - ra_min) / max(1e-9, (ra_max-ra_min)) * n_ra); ira = max(0, min(n_ra-1, ira))
        idec = int((dec - dec_min) / max(1e-9, (dec_max-dec_min)) * n_dec); idec = max(0, min(n_dec-1, idec))
        bins[(ira, idec)] = bins.get((ira, idec), 0) + 1
    vals = list(bins.values())
    vals_sorted = sorted(vals)
    lo = vals_sorted[int(0.25*(len(vals_sorted)-1))] if vals_sorted else None
    hi = vals_sorted[int(0.75*(len(vals_sorted)-1))] if vals_sorted else None
    return {'available': True, 'n_cells_occupied': len(vals), 'n_cells_total': n_ra*n_dec, 'count_q25': lo, 'count_q75': hi, 'density_field': 'rectangular_ra_sindec_bins_diagnostic'}


def run_p30_maskrandom_freeze_v27(meta, args):
    base = _run_p30_v26_for_v27(meta, args)
    cache = _v27_cache_dir(args)
    cache.mkdir(parents=True, exist_ok=True)

    # 1. Persist empirical ACT finite-support mask definition as a named product.
    sanity = ((base.get('act_probe_v18') or {}).get('best_sanity') or (base.get('act_alm_probe_v16') or {}).get('best_sanity') or {})
    reader = (base.get('act_probe_v18') or {}).get('reader_info') or {}
    official = (base.get('p30_act_mask_or_equivalent_v26') or {}).get('official_mask_found') or (base.get('p30_act_mask_gate_v25') or {}).get('official_mask_found')
    empirical_manifest = {
        'mask_name': 'act_dr6_empirical_finite_support_mask_v27',
        'claim_scope': 'documented_empirical_diagnostic_mask_not_official_act_mask',
        'official_mask_found': bool(official),
        'nside': reader.get('nside'),
        'lmax': reader.get('lmax'),
        'finite_fraction': sanity.get('finite_fraction'),
        'n_finite_pixels': sanity.get('n_finite_pixels'),
        'n_total_pixels': sanity.get('n_total_pixels'),
        'std': sanity.get('std'),
        'construction': 'finite, non-NaN pixels of reconstructed ACT DR6 kappa map; all variants must reuse this exact manifest until an official mask is found',
    }
    mask_path = cache / 'act_dr6_empirical_finite_support_mask_v27.json'
    empirical_manifest['path'] = _v27_write_json(mask_path, empirical_manifest)
    base['p30_empirical_mask_product_v27'] = empirical_manifest

    # 2. Generate route random catalogues in the same coordinate rectangle when cached coordinates exist.
    coord_paths = {}
    euc_path = (((base.get('euclid_mer_20k_v17') or {}).get('selected') or {}).get('sample_path') or
                ((base.get('p30_quality_query_v19') or {}).get('path')))
    if euc_path:
        coord_paths['euclid'] = euc_path
    # SDSS route has no guaranteed path in old outputs; search cache for likely specobj files.
    for p in cache.rglob('*') if cache.exists() else []:
        s = str(p).lower()
        if p.is_file() and ('sdss' in s or 'specobj' in s) and 'random' not in s and len(coord_paths) < 4:
            coord_paths.setdefault('sdss', str(p))
    route_randoms = {}
    for route, path in coord_paths.items():
        ci = _v27_load_coord_csv(path)
        rc = _v27_make_random_catalogue(ci, cache / f'p30_{route}_random_catalogue_v27.csv', seed=27030 + len(route))
        dens = _v27_simple_density_bins(ci)
        route_randoms[route] = {'coord_source': {k:v for k,v in ci.items() if k != 'rows'}, 'random_catalogue': rc, 'diagnostic_density_bins': dens}
    base['p30_random_catalogues_v27'] = route_randoms
    base['p30_random_density_normalization_v27'] = {
        'route_randoms_created': {k: bool(v.get('random_catalogue',{}).get('created')) for k,v in route_randoms.items()},
        'publication_density_definition': 'delta = N_data / max(N_random, epsilon) - 1 in the shared ACT mask and survey route footprint',
        'ready_for_random_normalized_rerun': any(v.get('random_catalogue',{}).get('created') for v in route_randoms.values()),
        'note': 'v27 creates deterministic random catalogues where cached RA/Dec rows exist; a promotion run must recompute kappa statistics using these random-normalized density bins.',
    }

    # 3. Variant matrix using identical-split policy, explicit curl rule.
    variant_stats = base.get('act_variant_stats_v17') or {}
    variants=[]
    for name, blob in variant_stats.items():
        st = (blob or {}).get('stat') or {}
        d = _v27_float(st.get('delta_high_minus_low'))
        variants.append({'variant': name, 'delta_high_minus_low': d, 'positive': d is not None and d > 0, 'high_n': st.get('high_density_n'), 'low_n': st.get('low_density_n'), 'density_p': st.get('density_bin_shuffle_p_high'), 'sky_p': st.get('sky_shuffle_p_high'), 'jackknife_same_sign': st.get('jackknife_same_sign')})
    sci = [v for v in variants if v['variant'] != 'curl_control']
    curl = next((v for v in variants if v['variant'] == 'curl_control'), {})
    pos_sci = [v for v in sci if v.get('positive')]
    common_counts = len({(v.get('high_n'), v.get('low_n')) for v in sci}) <= 1 if sci else False
    curl_weaker = bool(pos_sci and curl.get('delta_high_minus_low') is not None and abs(curl['delta_high_minus_low']) < max(abs(v['delta_high_minus_low']) for v in pos_sci if v.get('delta_high_minus_low') is not None))
    base['p30_same_split_variant_matrix_v27'] = {
        'variants': variants,
        'same_high_low_counts_across_science_variants': common_counts,
        'n_positive_science_variants': len(pos_sci),
        'two_or_more_positive_science_variants': len(pos_sci) >= 2,
        'curl_weaker_than_best_positive_science_abs': curl_weaker,
        'required_for_global_p30_confirm': ['same random-normalized density split', '>=2 positive science variants', 'curl weaker/null'],
    }

    # 4-5. Route-specific claims: SDSS may be candidate, Euclid tension stays separate.
    route_claims = base.get('p30_independent_route_claims_v26') or {}
    sdss = route_claims.get('sdss') or {}
    euclid = route_claims.get('euclid') or {}
    base['p30_route_specific_claims_v27'] = {
        'sdss': {
            'status': 'route_candidate_positive_requires_random_normalized_rerun' if sdss.get('positive') and sdss.get('density_p_pass') and sdss.get('jackknife_all_positive') else 'not_confirmed',
            'delta_high_minus_low': sdss.get('delta_high_minus_low'),
            'passes_raw_route_gates': bool(sdss.get('positive') and sdss.get('density_p_pass') and sdss.get('sky_p_pass') and sdss.get('jackknife_all_positive')),
            'random_catalogue_created': bool((route_randoms.get('sdss') or {}).get('random_catalogue',{}).get('created')),
        },
        'euclid': {
            'status': 'tension_or_mixed_until_photoz_depth_randoms' if euclid.get('available') else 'not_available',
            'delta_high_minus_low': euclid.get('delta_high_minus_low'),
            'passes_raw_route_gates': bool(euclid.get('positive') and euclid.get('density_p_pass') and euclid.get('sky_p_pass') and euclid.get('jackknife_all_positive')),
            'random_catalogue_created': bool((route_randoms.get('euclid') or {}).get('random_catalogue',{}).get('created')),
            'required_repair': ['photo-z/depth/quality splits', 'field-level randoms', 'same empirical/official ACT mask as all routes'],
        },
        'merge_allowed': False,
        'global_p30_status': 'diagnostic_until_both_route_policy_and_variant_policy_pass',
    }

    base['p30_publication_confirm_gate_v27'] = _v27_gate(
        official_or_documented_equivalent_mask=bool(official),
        empirical_mask_manifest_persisted=bool(mask_path.exists()),
        random_density_rerun=bool(False),
        science_variants=bool(len(pos_sci) >= 2 and common_counts),
        curl_control=bool(curl_weaker),
        separated_positive_route=bool((base['p30_route_specific_claims_v27']['sdss']['passes_raw_route_gates']) or (base['p30_route_specific_claims_v27']['euclid']['passes_raw_route_gates'])),
    )
    base['p30_publication_confirm_gate_v27']['claim_policy'] = 'v27 implements mask/random/route artifacts but does not promote until kappa statistics are rerun with random-normalized density and variant/curl gates pass.'
    base['status'] = 'density_kappa_diagnostic_only'
    return base


def run_highz_unit_field_table_v27(meta, args):
    base = _run_highz_v26_for_v27(meta, args)
    # 6-7. Produce an explicit object-acceleration table artifact if strict rows are present; otherwise a missing-data contract.
    reports = base.get('highz_objectlevel_table_reports_v24') or []
    rows = []
    local_a0 = 9.55e-11
    for rep in reports:
        if not rep.get('accepted'):
            continue
        src = rep.get('source_group') or 'unknown'
        sample = rep.get('sample_rows') or rep.get('rows') or []
        for r in sample[:500]:
            if not isinstance(r, dict):
                continue
            v = _v27_float(r.get('vrot_km_s') or r.get('vrot') or r.get('VROT') or r.get('VCIRC') or r.get('VMAX'))
            rad = _v27_float(r.get('radius_kpc') or r.get('radius') or r.get('R_KPC') or r.get('R'))
            z = _v27_float(r.get('z') or r.get('redshift') or r.get('Z'))
            if v is not None and rad is not None and rad > 0 and z is not None:
                a = (v*1000.0)**2 / (rad * 3.085677581491367e19)
                rows.append({'source': src, 'object_id': r.get('object_id') or r.get('id') or r.get('name'), 'z': z, 'vrot_km_s': v, 'radius_kpc': rad, 'a_m_s2': a, 'above_local_reference': a > local_a0, 'unit_provenance': rep.get('unit_provenance') or rep.get('velocity_unit_hint') or 'table_header_audit'})
    out_path = _Path_v27.cwd() / 'outputs' / 'p36_highz_object_acceleration_rows_v27.json'
    table_obj = {'n_rows': len(rows), 'local_reference_a0_m_s2': local_a0, 'rows': rows[:5000], 'schema': ['source','object_id','z','vrot_km_s','radius_kpc','a_m_s2','unit_provenance']}
    _v27_write_json(out_path, table_obj)
    sources = sorted({r['source'] for r in rows if r.get('source')})
    frac_above = (sum(1 for r in rows if r.get('above_local_reference')) / len(rows)) if rows else None
    base['highz_object_acceleration_table_v27'] = {
        'path': str(out_path),
        'n_rows': len(rows),
        'n_sources': len(sources),
        'sources': sources,
        'fraction_above_local_reference': frac_above,
        'required_schema': ['source','object_id','z','vrot_km_s','radius_kpc','a_m_s2','unit_provenance'],
    }
    base['highz_source_specific_parser_contract_v27'] = {
        'KMOS3D_KGES': {'required_columns': ['object_id','z','VROT_or_VCIRC_or_VMAX','radius_kpc'], 'reject': ['SIG','SIGMA','VEL_PA','inclination_only','image_hdu']},
        'KROSS': {'required_columns': ['object_id','z','Halpha_vrot_or_vmax','disk_radius_kpc'], 'reject': ['velocity_map_image_without_table']},
        'MOSDEF_SAMI': {'required_columns': ['object_id','z','rotation_velocity','effective_or_disk_radius_kpc'], 'reject': ['dispersion_only']},
    }
    base['highz_objectlevel_confirm_gate_v27'] = _v27_gate(
        object_rows_ge_30=len(rows) >= 30,
        two_sources=len(sources) >= 2,
        units_visible=bool(rows and all(r.get('unit_provenance') for r in rows[:min(30,len(rows))])),
        median_above_local=bool(rows and sorted([r['a_m_s2'] for r in rows])[len(rows)//2] > local_a0),
        leave_one_source_stable=False if len(sources) < 2 else all((sum(1 for r in rows if r['source'] != s and r['a_m_s2'] > local_a0) / max(1, sum(1 for r in rows if r['source'] != s))) >= 0.5 for s in sources),
    )
    base['highz_objectlevel_confirm_gate_v27']['promotion_rule'] = 'Major P36 high-z claim requires the v27 object acceleration table to pass all gates.'
    if base['highz_objectlevel_confirm_gate_v27']['eligible_for_confirm_like']:
        base['status'] = 'highz_a0_objectlevel_publication_confirm_like'
    return base


def run_p33_density_bao_measured_scaffold_v27(meta, args):
    base = _run_p33_v26_for_v27(meta, args)
    # 8/10. Convert contract into a concrete output schema and ready-to-run command map.
    cache = _v27_cache_dir(args)
    candidates = []
    if cache.exists():
        for p in cache.rglob('*'):
            s = str(p).lower()
            if p.is_file() and any(k in s for k in ['desi','sdss','boss','eboss']) and any(k in s for k in ['random','lss','clustering','bao','catalog','galaxy']):
                candidates.append(str(p))
                if len(candidates) >= 80:
                    break
    alpha_schema = {
        'alpha_high_density': None,
        'alpha_low_density': None,
        'sigma_alpha_high': None,
        'sigma_alpha_low': None,
        'delta_alpha_high_minus_low': None,
        'covariance_method': None,
        'density_label_shuffle_p': None,
        'sky_shuffle_p': None,
        'redshift_jackknife_stable': None,
    }
    out_path = _Path_v27.cwd() / 'outputs' / 'p33_density_split_alpha_result_v27.json'
    _v27_write_json(out_path, {'schema': alpha_schema, 'candidate_inputs': candidates[:50], 'status': 'schema_ready_not_measured'})
    base['p33_density_split_alpha_result_v27'] = {'path': str(out_path), 'schema': alpha_schema, 'candidate_inputs': candidates[:50], 'measurement_present': False}
    base['p33_execution_plan_v27'] = {
        'commands': [
            'download DESI/SDSS LSS data + randoms',
            'construct mask/random-normalized density field',
            'split high/low density in fixed redshift bins',
            'fit BAO alpha independently using jackknife covariance',
            'run density-label shuffle, sky shuffle, and redshift-bin leave-one-out'
        ],
        'minimum_confirm_outputs': list(alpha_schema.keys()),
    }
    base['p33_publication_confirm_gate_v27'] = _v27_gate(
        density_split_catalogues_loaded=bool(any('lss' in c.lower() or 'clustering' in c.lower() or 'galaxy' in c.lower() for c in candidates)),
        random_catalogues_loaded=bool(any('random' in c.lower() for c in candidates)),
        alpha_high_low_measured=False,
        covariance_ready=False,
        nulls_pass=False,
        redshift_jackknife_stable=False,
    )
    base['status'] = 'p33_density_bao_measurement_ready_not_confirmed'
    return base


def run_p41_structured_cp_v27(meta, args):
    base = _run_p41_v26_for_v27(meta, args)
    rows = (base.get('p41_cp_control_extraction_v26') or {})
    cp_n = int(rows.get('n_cp_control_rows') or 0)
    noncp_n = int(rows.get('n_noncp_rows') or 0)
    unc_n = int(rows.get('n_uncertainty_like_rows') or 0)
    # Stronger Wilson/SM detection from downloaded text snippets and examples.
    text_blob = _json_v27.dumps(rows, ensure_ascii=False)[:500000]
    wilson_terms = sorted(set(m.group(0).upper().replace(' ', '') for m in _re_v27.finditer(r'(?i)\bC\s*_?\s*(?:7|9|10)(?:prime|\')?\b|Wilson|SM\s+fit|Standard\s+Model', text_blob)))
    q2_rows_path = _Path_v27.cwd() / 'outputs' / 'p41_q2_cp_rows_v27.json'
    _v27_write_json(q2_rows_path, {'summary': rows, 'wilson_terms_detected': wilson_terms, 'schema': ['q2_low','q2_high','observable','value','stat_err','syst_err','cp_label','source']})
    base['p41_q2_cp_rows_v27'] = {'path': str(q2_rows_path), 'n_cp_control_rows': cp_n, 'n_noncp_rows': noncp_n, 'n_uncertainty_like_rows': unc_n, 'wilson_terms_detected': wilson_terms}
    base['p41_major_claim_gate_v27'] = _v27_gate(
        q2_numeric_rows=(cp_n + noncp_n) >= 20,
        cp_control_rows=cp_n >= 3,
        noncp_observable_rows=noncp_n >= 10,
        uncertainty_rows=unc_n >= 10,
        wilson_or_sm_fit=bool(wilson_terms and len(wilson_terms) >= 2),
        likelihood_values_present=False,
    )
    base['p41_major_claim_gate_v27']['promotion_rule'] = 'Major P41 confirmation requires CP controls and a numerical q² likelihood versus SM/Wilson hypotheses, not only row detection.'
    if not base['p41_major_claim_gate_v27']['eligible_for_confirm_like']:
        base['claim_scope_v27'] = 'structured_proxy_confirm_like_until_v27_major_claim_gate_passes'
    return base


def run_ringdown_strain_plan_v27(meta, args):
    base = _run_ringdown_v26_for_v27(meta, args)
    event_manifest = (base.get('ringdown_gwosc_download_manifest_v24') or {})
    events = event_manifest.get('events') or []
    out_path = _Path_v27.cwd() / 'outputs' / 'p32_ringdown_strain_execution_manifest_v27.json'
    manifest = {
        'events': events[:20],
        'required_files_per_event': ['GWOSC event metadata JSON','H1 strain','L1 strain','V1 strain when available','PSD estimate','GR ringdown fit JSON','CCDR residual fit JSON','injection null JSON'],
        'commands': [
            'python tests/test19_p32_ringdown_high_snr_scaffold.py --allow-large --strain --events GW150914,GW190521 --detectors H1,L1,V1 --sample-rate 4096 --window-s 32',
            'python run_all.py --only P32 --allow-large --max-mb 5000 --script-timeout 2400'
        ],
    }
    _v27_write_json(out_path, manifest)
    base['ringdown_strain_execution_manifest_v27'] = {'path': str(out_path), **manifest}
    base['ringdown_strain_confirm_gate_v27'] = _v27_gate(
        event_json_loaded=False,
        strain_downloaded=False,
        psd_estimated=False,
        gr_ringdown_fit=False,
        ccdr_residual_template_fit=False,
        injection_nulls=False,
        detector_split=False,
        leave_one_event_out=False,
    )
    return base


def run_smd_constants_pack_v27(meta, args):
    base = _run_smd_v26_for_v27(meta, args)
    base['smd_derivation_output_schema_v27'] = {
        'required_fields': ['ccdr_predicted_value','ccdr_prediction_uncertainty','observed_value','residual_sigma','falsification_threshold_sigma','derivation_inputs','lookup_target_used_false'],
        'current_mode': 'constant_lookup_consistency',
        'promotion_rule': 'SM-D constants become derivation confirms only when predicted values are generated before comparing to lookup targets.'
    }
    base['smd_derivation_gate_v27'] = _v27_gate(ccdr_predicted_value_present=False, uncertainty_present=False, residual_sigma_present=False, independent_of_lookup_target=False, falsification_threshold_present=True)
    base['claim_scope_v27'] = 'constant_consistency_not_derivation_confirm'
    return base


def run_koide_constants_v27(meta, args):
    base = _run_koide_v26_for_v27(meta, args)
    base['smd_derivation_output_schema_v27'] = {
        'required_fields': ['ccdr_predicted_relation','relation_uncertainty','observed_Q','residual_sigma','falsification_threshold_sigma','derivation_inputs','lookup_target_used_false'],
        'current_mode': 'numerical_relation_consistency',
        'promotion_rule': 'Koide becomes derivation confirm only when CCDR derives Q=2/3 with uncertainty before comparing to masses.'
    }
    base['smd_derivation_gate_v27'] = _v27_gate(ccdr_predicted_relation_present=False, uncertainty_present=False, residual_sigma_present=False, independent_of_lookup_target=False, falsification_threshold_present=True)
    base['claim_scope_v27'] = 'koide_consistency_not_derivation_confirm'
    return base


def run_dashboard_v27(meta, args):
    base = _run_dashboard_v26_for_v27(meta, args)
    out = _Path_v27.cwd() / 'outputs'
    rows=[]
    if out.exists():
        for p in sorted(out.glob('test*.json')):
            try:
                rows.append(_json_v27.loads(p.read_text(encoding='utf-8')))
            except Exception:
                pass
    v27=[]; blocked=[]; pub=[]; route=[]
    for r in rows:
        keys = sorted([k for k in r if k.endswith('_v27') or '_v27_' in k])
        if keys:
            v27.append({'test_id': r.get('test_id'), 'prediction_id': r.get('prediction_id'), 'status': r.get('status'), 'v27_keys': keys})
        st=str(r.get('status',''))
        if 'publication_confirm_like' in st or st in ('robust_confirm_like','void_morphology_publication_grade_confirm_like'):
            pub.append({'test_id': r.get('test_id'), 'prediction_id': r.get('prediction_id'), 'status': st})
        if r.get('p30_route_specific_claims_v27'):
            route.append({'test_id': r.get('test_id'), 'prediction_id': r.get('prediction_id'), 'routes': r.get('p30_route_specific_claims_v27')})
        for k,v in r.items():
            if isinstance(v, dict) and k.endswith('_gate_v27') and not v.get('eligible_for_confirm_like', True):
                blocked.append({'test_id': r.get('test_id'), 'prediction_id': r.get('prediction_id'), 'gate': k, 'missing': v.get('missing')})
    base['dashboard_v27'] = {
        'n_v27_instrumented_tests': len(v27),
        'v27_instrumented_tests': v27[:120],
        'publication_grade_confirm_like': pub,
        'blocked_confirm_gates': blocked[:120],
        'route_specific_candidates': route[:30],
        'claim_policy': 'v27 creates operational artifacts for P30/P36/P33/P41/P32 but only promotes when rerun measurements satisfy the strict gates.',
    }
    base['status']='dashboard_positive_summary'
    return base


RUNNERS.update({
    'p30_maskrandom_freeze_v22': run_p30_maskrandom_freeze_v27,
    'highz_unit_field_table_v22': run_highz_unit_field_table_v27,
    'p33_density_bao_measured_scaffold_v22': run_p33_density_bao_measured_scaffold_v27,
    'p41_structured_cp_v22': run_p41_structured_cp_v27,
    'ringdown_strain_plan_v22': run_ringdown_strain_plan_v27,
    'smd_constants_pack': run_smd_constants_pack_v27,
    'koide_constants': run_koide_constants_v27,
    'dashboard_v22': run_dashboard_v27,
})


# -------------------------- Round-10 v28 measured-confirm execution patch --------------------------
# v28 turns the v27 operational artifacts into measured-rerun scaffolds where public/cache
# products are available, while preserving strict publication gates. It focuses on the
# ten remaining confirmation blockers: P30 random-normalized route reruns + same-split
# variants/curl; P30 Euclid repair; P36 source-specific object rows; P41 q2 likelihood;
# P33 measured-alpha handoff; P32 strain execution manifest.
from pathlib import Path as _Path_v28
import json as _json_v28
import math as _math_v28
import random as _random_v28
import re as _re_v28
import csv as _csv_v28

_run_p30_v27_for_v28 = run_p30_maskrandom_freeze_v27
_run_highz_v27_for_v28 = run_highz_unit_field_table_v27
_run_p33_v27_for_v28 = run_p33_density_bao_measured_scaffold_v27
_run_p41_v27_for_v28 = run_p41_structured_cp_v27
_run_ringdown_v27_for_v28 = run_ringdown_strain_plan_v27
_run_smd_v27_for_v28 = run_smd_constants_pack_v27
_run_koide_v27_for_v28 = run_koide_constants_v27
_run_dashboard_v27_for_v28 = run_dashboard_v27


def _v28_float(x):
    try:
        if x is None or x == '':
            return None
        v = float(x)
        return v if _math_v28.isfinite(v) else None
    except Exception:
        return None


def _v28_gate(**items):
    missing = [k for k, v in items.items() if not bool(v)]
    out = dict(items)
    out['eligible_for_confirm_like'] = not missing
    out['missing'] = missing
    return out


def _v28_cache_dir(args):
    return _Path_v28(getattr(args, 'cache_dir', '.ccdr_round10_cache'))


def _v28_outputs_dir():
    p = _Path_v28.cwd() / 'outputs'
    p.mkdir(parents=True, exist_ok=True)
    return p


def _v28_write_json(path, obj):
    path = _Path_v28(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(_json_v28.dumps(obj, indent=2, sort_keys=True, ensure_ascii=False), encoding='utf-8')
    return str(path)


def _v28_safe_rows_from_csv(path, max_rows=200000):
    p = _Path_v28(path)
    if not p.exists() or not p.is_file():
        return []
    try:
        with p.open('r', encoding='utf-8', errors='ignore', newline='') as f:
            snip = f.read(4096); f.seek(0)
            try:
                dialect = _csv_v28.Sniffer().sniff(snip, delimiters=',;\t| ')
            except Exception:
                dialect = _csv_v28.excel
            rdr = _csv_v28.DictReader(f, dialect=dialect)
            rows=[]
            for i,row in enumerate(rdr):
                if i >= max_rows: break
                rows.append({str(k).strip(): v for k,v in row.items() if k is not None})
            return rows
    except Exception:
        return []


def _v28_coord_rows_from_dicts(rows):
    out=[]
    for r in rows or []:
        low={str(k).lower().strip(): v for k,v in r.items()}
        ra = next((_v28_float(low[k]) for k in low if k in ('ra','raj2000','right_ascension','ra_deg','alpha') or 'right_ascension' in k), None)
        dec = next((_v28_float(low[k]) for k in low if k in ('dec','dej2000','declination','dec_deg','delta') or 'declination' in k), None)
        if ra is not None and dec is not None and -90 <= dec <= 90:
            out.append({'ra': ra % 360.0, 'dec': dec})
    return out


def _v28_find_cached_coord_file(cache, *needles):
    needles=[n.lower() for n in needles]
    if not cache.exists(): return None
    best=[]
    for p in cache.rglob('*'):
        if not p.is_file(): continue
        s=str(p).lower()
        if any(n in s for n in needles) and not any(x in s for x in ['random','mask']):
            if p.suffix.lower() in ['.csv','.txt','.tsv','.dat','']:
                best.append(p)
    best.sort(key=lambda p: p.stat().st_size if p.exists() else 0, reverse=True)
    return str(best[0]) if best else None


def _v28_random_catalogue_for_coords(coords, out_path, seed=28030, multiplier=5, n_max=200000):
    if not coords or len(coords) < 10:
        return {'created': False, 'reason': 'too_few_data_coords', 'n_data': len(coords or [])}
    ra_vals=[c['ra'] for c in coords]; dec_vals=[c['dec'] for c in coords]
    ra_min, ra_max = min(ra_vals), max(ra_vals)
    dec_min, dec_max = min(dec_vals), max(dec_vals)
    # Avoid pathological wrap cases by using the observed rectangle; this is a diagnostic route random.
    n_random = min(max(len(coords)*multiplier, 5000), n_max)
    rng = _random_v28.Random(seed)
    out_path=_Path_v28(out_path); out_path.parent.mkdir(parents=True, exist_ok=True)
    with out_path.open('w', encoding='utf-8', newline='') as f:
        w=_csv_v28.writer(f); w.writerow(['ra','dec','weight','route','generation'])
        s0=_math_v28.sin(_math_v28.radians(dec_min)); s1=_math_v28.sin(_math_v28.radians(dec_max))
        for _ in range(n_random):
            ra=rng.uniform(ra_min, ra_max)
            dec=_math_v28.degrees(_math_v28.asin(rng.uniform(min(s0,s1), max(s0,s1))))
            w.writerow([f'{ra:.8f}', f'{dec:.8f}', '1.0', 'route_rect_sindec', 'v28'])
    return {'created': True, 'path': str(out_path), 'n_data': len(coords), 'n_random': n_random, 'ra_range': [ra_min, ra_max], 'dec_range': [dec_min, dec_max]}


def _v28_random_normalized_kappa_stat(kmap, data_coords, random_coords, args, density_nside=64, label='route'):
    try:
        import numpy as np
        import healpy as hp
    except Exception as e:
        return {'available': False, 'error': f'numpy/healpy unavailable: {e}'}
    if kmap is None:
        return {'available': False, 'error': 'missing kappa map'}
    if len(data_coords or []) < 50 or len(random_coords or []) < 200:
        return {'available': False, 'error': 'too few data/random coords', 'n_data': len(data_coords or []), 'n_random': len(random_coords or [])}
    arr=np.asarray(kmap, dtype=float)
    finite=np.isfinite(arr)
    nside_map=hp.get_nside(arr)
    def pix_for(coords, nside):
        ra=np.array([c['ra'] for c in coords], dtype=float); dec=np.array([c['dec'] for c in coords], dtype=float)
        theta=np.radians(90-dec); phi=np.radians(ra)
        return hp.ang2pix(nside, theta, phi), ra, dec
    dpix, dra, ddec = pix_for(data_coords, nside_map)
    in_mask=finite[dpix]
    if int(in_mask.sum()) < 50:
        return {'available': False, 'error': 'too few data coords in finite ACT mask', 'n_in_mask': int(in_mask.sum())}
    data=[data_coords[i] for i,ok in enumerate(in_mask) if ok]
    kval=arr[dpix[in_mask]]
    rpix, _, _ = pix_for(random_coords, nside_map)
    random_in=[random_coords[i] for i,ok in enumerate(finite[rpix]) if ok]
    if len(random_in) < 200:
        return {'available': False, 'error': 'too few random coords in finite ACT mask', 'n_random_in_mask': len(random_in)}
    d_dpix, _, _ = pix_for(data, density_nside)
    r_dpix, _, _ = pix_for(random_in, density_nside)
    nden=hp.nside2npix(density_nside)
    dcounts=np.bincount(d_dpix, minlength=nden).astype(float)
    rcounts=np.bincount(r_dpix, minlength=nden).astype(float)
    scale=len(data)/max(1.0, float(len(random_in)))
    expected=rcounts[d_dpix]*scale
    dens=(dcounts[d_dpix]+0.5)/(expected+0.5)-1.0
    lo_thr, hi_thr=np.quantile(dens, [0.25,0.75])
    lo_mask=dens <= lo_thr; hi_mask=dens >= hi_thr
    if lo_mask.sum() < 10 or hi_mask.sum() < 10:
        return {'available': False, 'error': 'too few high/low density samples', 'low_n': int(lo_mask.sum()), 'high_n': int(hi_mask.sum())}
    delta=float(np.nanmean(kval[hi_mask])-np.nanmean(kval[lo_mask]))
    rng=np.random.default_rng(getattr(args,'seed',12345))
    dens_null=[]
    for _ in range(128):
        kv=kval.copy(); rng.shuffle(kv)
        dens_null.append(float(np.nanmean(kv[hi_mask])-np.nanmean(kv[lo_mask])))
    jack=[]
    ra_data=np.array([c['ra'] for c in data], dtype=float)
    labels=np.digitize(ra_data, np.quantile(ra_data, [0.25,0.5,0.75]))
    for lab in sorted(set(labels)):
        m=labels != lab
        if m.sum() < 50: continue
        d2=dens[m]; k2=kval[m]
        l2,h2=np.quantile(d2,[0.25,0.75])
        jack.append(float(np.nanmean(k2[d2>=h2])-np.nanmean(k2[d2<=l2])))
    p_high=sum(1 for v in dens_null if v >= delta)/len(dens_null) if dens_null else None
    return {
        'available': True, 'label': label, 'density_definition': 'delta=N_data/N_random_scaled-1', 'density_nside': int(density_nside),
        'n_data_in_mask': len(data), 'n_random_in_mask': len(random_in), 'low_density_n': int(lo_mask.sum()), 'high_density_n': int(hi_mask.sum()),
        'delta_high_minus_low': delta, 'mean_kappa_high_density': float(np.nanmean(kval[hi_mask])), 'mean_kappa_low_density': float(np.nanmean(kval[lo_mask])),
        'density_shuffle_n': len(dens_null), 'density_shuffle_p_high': p_high, 'field_split_jackknife': jack,
        'jackknife_same_sign': bool(jack and all((x>0)==(delta>0) for x in jack)),
        'passes_route_positive': bool(delta > 0 and p_high is not None and p_high <= 0.05 and jack and all(x > 0 for x in jack)),
    }


def run_p30_maskrandom_freeze_v28(meta, args):
    base = _run_p30_v27_for_v28(meta, args)
    cache = _v28_cache_dir(args); cache.mkdir(parents=True, exist_ok=True)
    outputs = _v28_outputs_dir()

    # 1. P30-SDSS random-normalized rerun when data + ACT map are available.
    sdss_coords=[]; sdss_source=None
    try:
        sdss_obj=_v13_sdss_fallback_coords(meta, args) if '_v13_sdss_fallback_coords' in globals() else {}
        sdss_coords=[{'ra': float(r['ra'])%360.0, 'dec': float(r['dec'])} for r in sdss_obj.get('sample', []) if 'ra' in r and 'dec' in r]
        sdss_source='v13_sdss_fallback_coords'
    except Exception as e:
        sdss_source=f'sdss_fetch_error:{str(e)[:120]}'
    if not sdss_coords:
        f=_v28_find_cached_coord_file(cache, 'sdss', 'specobj')
        if f:
            sdss_coords=_v28_coord_rows_from_dicts(_v28_safe_rows_from_csv(f)); sdss_source=f
    sdss_random=_v28_random_catalogue_for_coords(sdss_coords, cache/'p30_sdss_random_catalogue_v28.csv', seed=28031)
    sdss_rand_coords=[]
    if sdss_random.get('created'):
        sdss_rand_coords=_v28_coord_rows_from_dicts(_v28_safe_rows_from_csv(sdss_random['path']))
    kmap=None; map_probe=None
    if getattr(args, 'allow_large', False) and not getattr(args, 'quick', False):
        try:
            _, kmap, map_probe = _v18_get_act_map(meta, args, nside=int(meta.get('sample_nside', 256)))
        except Exception as e:
            map_probe={'error': str(e)[:200]}
    stat=_v28_random_normalized_kappa_stat(kmap, sdss_coords, sdss_rand_coords, args, density_nside=64, label='P30-SDSS-v28') if kmap is not None else {'available': False, 'error': 'run with --allow-large to recompute ACT kappa random-normalized route', 'map_probe': map_probe}
    base['p30_sdss_random_normalized_route_v28'] = {
        'coord_source': sdss_source, 'n_sdss_coords': len(sdss_coords), 'random_catalogue': sdss_random,
        'kappa_stat': stat, 'claim_scope': 'route_specific_candidate_only_until_same_split_variants_and_curl_pass'
    }
    _v28_write_json(outputs/'p30_sdss_random_normalized_route_v28.json', base['p30_sdss_random_normalized_route_v28'])

    # 2/3. Same-split ACT variants/curl: enforce identical split policy and expose pass/fail.
    variant_stats=base.get('act_variant_stats_v17') or {}
    variant_rows=[]
    for name, blob in variant_stats.items():
        st=(blob or {}).get('stat') or {}
        d=_v28_float(st.get('delta_high_minus_low'))
        variant_rows.append({'variant': name, 'delta_high_minus_low': d, 'positive': d is not None and d>0, 'density_p': st.get('density_bin_shuffle_p_high'), 'sky_p': st.get('sky_shuffle_p_high'), 'jackknife_same_sign': st.get('jackknife_same_sign'), 'same_split_recomputed': False})
    sci=[v for v in variant_rows if 'curl' not in v['variant'].lower()]
    curl=next((v for v in variant_rows if 'curl' in v['variant'].lower()), None)
    pos_sci=[v for v in sci if v['positive'] and (v.get('density_p') is not None and v['density_p'] <= 0.05)]
    base['p30_same_split_variant_rerun_v28'] = {
        'variants': variant_rows, 'same_split_density_source': 'p30_sdss_random_normalized_route_v28',
        'same_split_recomputed': False,
        'why_not_confirm': 'v28 records the required split and previous variant signs; promotion requires recomputing every ACT variant using the same random-normalized SDSS density split.',
        'n_previous_positive_science_variants': len(pos_sci), 'curl_previous': curl,
    }
    base['p30_curl_control_gate_v28'] = _v28_gate(
        curl_available=bool(curl and curl.get('delta_high_minus_low') is not None),
        same_split_recomputed=False,
        curl_null_or_weaker=False,
    )

    # 4/5. Euclid repair hooks: specific cuts and route separation.
    base['p30_euclid_repair_v28'] = {
        'current_route_status': (base.get('p30_independent_route_claims_v26') or {}).get('euclid'),
        'required_repairs': ['photo_z_or_redshift_column', 'depth_or_flag_quality_split', 'field_level_random_catalogue', 'same_ACT_mask_as_SDSS', 'same_random_normalized_density_definition'],
        'suggested_euclid_adql_columns': ['right_ascension','declination','gaia_id','extended_flag','point_like_flag','spurious_prob','extended_prob','fwhm','semimajor_axis','ellipticity','to_be_published'],
        'promotion_policy': 'Euclid remains tension/mixed until repaired; do not merge with SDSS route.'
    }
    route_pass=bool(stat.get('passes_route_positive'))
    base['p30_route_specific_claims_v28'] = {
        'sdss': {'raw_candidate': True, 'random_normalized_candidate': route_pass, 'stat': stat},
        'euclid': {'raw_candidate': False, 'repair_required': True},
        'merge_allowed': False,
    }
    base['p30_publication_confirm_gate_v28'] = _v28_gate(
        p30_sdss_random_normalized_route=route_pass,
        same_split_science_variants=False,
        curl_control_pass=False,
        euclid_not_required_for_sdss_route=True,
        global_p30_requires_euclid_or_second_route=False,
    )
    base['p30_publication_confirm_gate_v28']['claim_policy'] = 'P30-SDSS can become a route-specific confirm only after random-normalized route + same-split variants + curl pass; global P30 requires a second repaired route.'
    base['status'] = 'density_kappa_diagnostic_only' if not route_pass else 'density_kappa_sdss_route_positive_candidate'
    return base


# P36 high-z source-specific object parsing.
def _v28_is_velocity_col(name):
    n=str(name).lower()
    if any(bad in n for bad in ['sig','sigma','disp','pa','angle','incl','err','error','e_','d_','ivar','weight']):
        return False
    return bool(_re_v28.search(r'(^|[_\-])(vrot|v_rot|vcirc|v_circ|vmax|v_max|rotvel|rotation_velocity|velocity_rot)($|[_\-])', n) or n in ['vrot','vcirc','vmax'])


def _v28_is_radius_col(name):
    n=str(name).lower()
    if any(bad in n for bad in ['err','error','pa','angle','ellip','sig','sigma']):
        return False
    return bool(_re_v28.search(r'(^|[_\-])(radius|r_kpc|rkpc|r50|reff|r_eff|rd|r_d|disk_radius|halpha_radius)($|[_\-])', n) or n in ['r','radius'])


def _v28_is_z_col(name):
    n=str(name).lower()
    return n in ['z','redshift','z_spec','zspec','zphot','z_photo'] or 'redshift' in n


def _v28_source_from_path(path):
    s=str(path).lower()
    for key in ['kmos3d','kges','kross','mosdef','sami','kmoss','kmos']:
        if key in s:
            return key.upper()
    return 'unknown'


def _v28_extract_object_rows_from_mapping(rows, source, max_rows=5000):
    out=[]; rejected=[]
    for row in rows[:max_rows]:
        if not isinstance(row, dict): continue
        keys=list(row.keys())
        vcol=next((k for k in keys if _v28_is_velocity_col(k)), None)
        rcol=next((k for k in keys if _v28_is_radius_col(k)), None)
        zcol=next((k for k in keys if _v28_is_z_col(k)), None)
        if not (vcol and rcol and zcol):
            badv=[k for k in keys if 'vel' in str(k).lower() or 'sig' in str(k).lower() or 'pa' in str(k).lower()]
            if badv: rejected.append({'source': source, 'columns': badv[:10], 'reason': 'no_strict_vrot_radius_z_triple'})
            continue
        v=_v28_float(row.get(vcol)); r=_v28_float(row.get(rcol)); z=_v28_float(row.get(zcol))
        if v is None or r is None or z is None or r <= 0 or not (0 <= z <= 5) or not (5 <= abs(v) <= 600):
            continue
        a=(v*1000.0)**2/(r*3.085677581491367e19)
        oid=row.get('object_id') or row.get('id') or row.get('ID') or row.get('name') or row.get('galaxy')
        out.append({'source': source, 'object_id': oid, 'z': z, 'vrot_km_s': abs(v), 'radius_kpc': r, 'a_m_s2': a, 'unit_provenance': f'v28 strict columns: {vcol},{rcol},{zcol}'})
    return out, rejected


def _v28_scan_cache_for_highz_objects(cache, max_files=200):
    rows=[]; rejected=[]; scanned=[]
    if not cache.exists():
        return rows, rejected, scanned
    files=[]
    for p in cache.rglob('*'):
        if not p.is_file(): continue
        s=str(p).lower()
        if any(k in s for k in ['kmos','kges','kross','mosdef','sami']) and p.suffix.lower() in ['.csv','.txt','.tsv','.dat','.fits','.fit','.json']:
            files.append(p)
    files=sorted(files, key=lambda p: p.stat().st_size if p.exists() else 0)[:max_files]
    for p in files:
        src=_v28_source_from_path(p)
        scanned.append(str(p))
        if p.suffix.lower() in ['.csv','.txt','.tsv','.dat']:
            rr=_v28_safe_rows_from_csv(p, max_rows=20000)
            got, rej=_v28_extract_object_rows_from_mapping(rr, src)
            rows.extend(got); rejected.extend(rej)
        elif p.suffix.lower() == '.json':
            try:
                obj=_json_v28.loads(p.read_text(encoding='utf-8', errors='ignore'))
                rr=obj if isinstance(obj, list) else obj.get('rows') if isinstance(obj, dict) else []
                got, rej=_v28_extract_object_rows_from_mapping(rr or [], src)
                rows.extend(got); rejected.extend(rej)
            except Exception:
                pass
        elif p.suffix.lower() in ['.fits','.fit']:
            try:
                from astropy.io import fits
                with fits.open(p, memmap=True) as hdul:
                    for hdu in hdul:
                        if not hasattr(hdu, 'columns') or hdu.data is None: continue
                        cols=[c.name for c in hdu.columns]
                        if not any(_v28_is_velocity_col(c) for c in cols):
                            if any('sig' in c.lower() or 'vel' in c.lower() for c in cols):
                                rejected.append({'source': src, 'path': str(p), 'columns': cols[:20], 'reason': 'fits_table_without_strict_vrot'})
                            continue
                        sample=[]
                        data=hdu.data
                        for i in range(min(len(data), 5000)):
                            sample.append({c: data[c][i].item() if hasattr(data[c][i], 'item') else data[c][i] for c in cols})
                        got, rej=_v28_extract_object_rows_from_mapping(sample, src)
                        rows.extend(got); rejected.extend(rej)
            except Exception as e:
                rejected.append({'source': src, 'path': str(p), 'reason': 'fits_read_error', 'error': str(e)[:120]})
    return rows, rejected, scanned


def run_highz_unit_field_table_v28(meta, args):
    base = _run_highz_v27_for_v28(meta, args)
    cache=_v28_cache_dir(args)
    rows, rejected, scanned = _v28_scan_cache_for_highz_objects(cache)
    local_a0=9.55e-11
    # Merge any strict rows from v27 table if present.
    old_path=(base.get('highz_object_acceleration_table_v27') or {}).get('path')
    try:
        if old_path and _Path_v28(old_path).exists():
            old=_json_v28.loads(_Path_v28(old_path).read_text(encoding='utf-8'))
            for r in old.get('rows', []):
                if all(k in r for k in ['source','z','vrot_km_s','radius_kpc','a_m_s2']):
                    rows.append(r)
    except Exception:
        pass
    # de-duplicate coarsely
    seen=set(); uniq=[]
    for r in rows:
        key=(r.get('source'), r.get('object_id'), round(float(r.get('z',0)),4), round(float(r.get('vrot_km_s',0)),2), round(float(r.get('radius_kpc',0)),3))
        if key in seen: continue
        seen.add(key); uniq.append(r)
    rows=uniq
    sources=sorted({r.get('source') for r in rows if r.get('source')})
    frac_above=(sum(1 for r in rows if _v28_float(r.get('a_m_s2')) and r['a_m_s2']>local_a0)/len(rows)) if rows else None
    source_summary=[]
    for s in sources:
        vals=[r['a_m_s2'] for r in rows if r.get('source')==s and _v28_float(r.get('a_m_s2')) is not None]
        vals=sorted(vals)
        source_summary.append({'source': s, 'n_rows': len(vals), 'median_a_m_s2': vals[len(vals)//2] if vals else None, 'fraction_above_local': (sum(v>local_a0 for v in vals)/len(vals)) if vals else None})
    out_path=_v28_outputs_dir()/'p36_highz_object_acceleration_rows_v28.json'
    _v28_write_json(out_path, {'schema': ['source','object_id','z','vrot_km_s','radius_kpc','a_m_s2','unit_provenance'], 'n_rows': len(rows), 'n_sources': len(sources), 'source_summary': source_summary, 'rows': rows[:10000], 'rejected_examples': rejected[:200], 'scanned_files': scanned[:200]})
    leave_one=False
    if len(sources)>=2 and rows:
        leave=[]
        for s in sources:
            vals=[r['a_m_s2'] for r in rows if r.get('source') != s]
            leave.append({'held_out': s, 'n_remaining': len(vals), 'median_above_local': bool(vals and sorted(vals)[len(vals)//2] > local_a0)})
        leave_one=all(x['median_above_local'] for x in leave)
    else:
        leave=[]
    med=sorted([r['a_m_s2'] for r in rows])[len(rows)//2] if rows else None
    base['highz_source_specific_object_scan_v28']={'path': str(out_path), 'n_rows': len(rows), 'n_sources': len(sources), 'sources': sources, 'fraction_above_local_reference': frac_above, 'source_summary': source_summary, 'n_rejected_examples': len(rejected), 'n_scanned_files': len(scanned)}
    base['highz_objectlevel_confirm_gate_v28']=_v28_gate(
        object_rows_ge_30=len(rows)>=30,
        two_sources=len(sources)>=2,
        units_visible=bool(rows and all(r.get('unit_provenance') for r in rows[:min(30,len(rows))])),
        median_above_local=bool(med is not None and med>local_a0),
        leave_one_source_stable=leave_one,
    )
    base['highz_objectlevel_confirm_gate_v28']['leave_one_source']=leave
    base['highz_objectlevel_confirm_gate_v28']['promotion_rule']='v28 promotes P36 high-z only with strict source-specific object rows, visible units, median above local, and leave-one-source stability.'
    if base['highz_objectlevel_confirm_gate_v28']['eligible_for_confirm_like']:
        base['status']='highz_a0_objectlevel_publication_confirm_like'
    return base


def run_p33_density_bao_measured_scaffold_v28(meta, args):
    base=_run_p33_v27_for_v28(meta,args)
    cache=_v28_cache_dir(args)
    candidate_alpha=[]
    if cache.exists():
        for p in cache.rglob('*'):
            if not p.is_file(): continue
            s=str(p).lower()
            if 'p33' in s and ('alpha' in s or 'bao' in s) and p.suffix.lower() in ['.json','.csv','.txt']:
                candidate_alpha.append(str(p))
    # Accept user-provided measured alpha files if present in cache/outputs.
    measured=None
    for p in candidate_alpha:
        try:
            if p.endswith('.json'):
                obj=_json_v28.loads(_Path_v28(p).read_text(encoding='utf-8'))
                ah=_v28_float(obj.get('alpha_high_density')); al=_v28_float(obj.get('alpha_low_density'))
                if ah is not None and al is not None:
                    measured=obj; break
            else:
                rows=_v28_safe_rows_from_csv(p, max_rows=10)
                for r in rows:
                    ah=_v28_float(r.get('alpha_high_density') or r.get('alpha_high')); al=_v28_float(r.get('alpha_low_density') or r.get('alpha_low'))
                    if ah is not None and al is not None:
                        measured={'alpha_high_density': ah, 'alpha_low_density': al, 'source': p}; break
        except Exception:
            pass
        if measured: break
    result={
        'measurement_present': bool(measured), 'measured_input': measured,
        'candidate_alpha_inputs': candidate_alpha[:80],
        'required_columns': ['alpha_high_density','alpha_low_density','sigma_alpha_high','sigma_alpha_low','delta_alpha_high_minus_low','covariance_method','density_label_shuffle_p','sky_shuffle_p','redshift_jackknife_stable'],
    }
    if measured:
        result['delta_alpha_high_minus_low']=_v28_float(measured.get('delta_alpha_high_minus_low'))
        if result['delta_alpha_high_minus_low'] is None:
            result['delta_alpha_high_minus_low']=_v28_float(measured.get('alpha_high_density'))-_v28_float(measured.get('alpha_low_density'))
    out=_v28_outputs_dir()/'p33_density_split_alpha_result_v28.json'
    _v28_write_json(out,result)
    base['p33_density_split_alpha_result_v28']={'path': str(out), **result}
    base['p33_publication_confirm_gate_v28']=_v28_gate(
        alpha_high_low_measured=bool(measured),
        covariance_ready=bool(measured and measured.get('covariance_method')),
        density_label_shuffle_pass=bool(measured and _v28_float(measured.get('density_label_shuffle_p')) is not None and _v28_float(measured.get('density_label_shuffle_p')) <= 0.05),
        sky_shuffle_pass=bool(measured and _v28_float(measured.get('sky_shuffle_p')) is not None and _v28_float(measured.get('sky_shuffle_p')) <= 0.05),
        redshift_jackknife_stable=bool(measured and measured.get('redshift_jackknife_stable')),
    )
    base['status']='p33_density_bao_measurement_ready_not_confirmed' if not base['p33_publication_confirm_gate_v28']['eligible_for_confirm_like'] else 'p33_density_bao_alpha_confirm_like'
    return base


def run_p41_structured_cp_v28(meta,args):
    base=_run_p41_v27_for_v28(meta,args)
    # Convert row counts into an explicit likelihood-ready artifact. If user-provided likelihood rows exist, consume them.
    cache=_v28_cache_dir(args)
    likelihood=None; candidates=[]
    for root in [cache, _v28_outputs_dir()]:
        if root.exists():
            for p in root.rglob('*'):
                s=str(p).lower()
                if p.is_file() and ('p41' in s or 'lhcb' in s or 'bsll' in s) and ('likelihood' in s or 'wilson' in s or 'q2' in s) and p.suffix.lower() in ['.json','.csv','.txt']:
                    candidates.append(str(p))
    for p in candidates:
        try:
            if p.endswith('.json'):
                obj=_json_v28.loads(_Path_v28(p).read_text(encoding='utf-8'))
                if any(k in obj for k in ['delta_chi2_sm_minus_wilson','loglike_sm','loglike_wilson','wilson_fit']):
                    likelihood=obj; break
        except Exception:
            pass
    cp = base.get('p41_q2_cp_rows_v27') or {}
    cp_n=int(cp.get('n_cp_control_rows') or 0); noncp_n=int(cp.get('n_noncp_rows') or 0); unc_n=int(cp.get('n_uncertainty_like_rows') or 0)
    like_delta=_v28_float((likelihood or {}).get('delta_chi2_sm_minus_wilson'))
    out=_v28_outputs_dir()/'p41_wilson_sm_likelihood_v28.json'
    _v28_write_json(out, {'likelihood_present': bool(likelihood), 'likelihood': likelihood, 'candidate_inputs': candidates[:80], 'current_counts': {'cp_control_rows': cp_n, 'noncp_rows': noncp_n, 'uncertainty_rows': unc_n}, 'required': ['q2_low','q2_high','observable','value','error','cp_label','sm_prediction','wilson_prediction','loglike']})
    base['p41_wilson_sm_likelihood_v28']={'path': str(out), 'likelihood_present': bool(likelihood), 'delta_chi2_sm_minus_wilson': like_delta, 'candidate_inputs': candidates[:30]}
    base['p41_major_claim_gate_v28']=_v28_gate(
        q2_numeric_rows=(cp_n+noncp_n)>=20,
        cp_control_rows=cp_n>=3,
        noncp_observable_rows=noncp_n>=10,
        uncertainty_rows=unc_n>=10,
        wilson_sm_likelihood=bool(likelihood),
        delta_chi2_attention=bool(like_delta is not None and like_delta>=4.0),
        cp_controls_null_or_weak=bool(likelihood and likelihood.get('cp_controls_null_or_weak')),
    )
    base['p41_major_claim_gate_v28']['promotion_rule']='Major P41 confirm requires q² rows, CP controls, and numerical SM/Wilson likelihood with CP controls null/weak.'
    if not base['p41_major_claim_gate_v28']['eligible_for_confirm_like']:
        base['claim_scope_v28']='structured_proxy_confirm_like_until_v28_likelihood_gate_passes'
    return base


def run_ringdown_strain_plan_v28(meta,args):
    base=_run_ringdown_v27_for_v28(meta,args)
    cache=_v28_cache_dir(args)
    found=[]
    if cache.exists():
        for p in cache.rglob('*'):
            s=str(p).lower()
            if p.is_file() and any(k in s for k in ['gwosc','gw150914','gw190521','strain','ringdown']) and p.suffix.lower() in ['.hdf5','.h5','.gwf','.json','.txt']:
                found.append(str(p))
    manifest={
        'found_candidate_files': found[:80],
        'executable_steps': ['event_json_loaded','strain_downloaded','psd_estimated','gr_ringdown_fit','ccdr_residual_template_fit','injection_nulls','detector_split','leave_one_event_out'],
        'implemented_consumption_policy': 'If all output JSON products exist in cache/outputs, v28 gate can pass; otherwise this remains execution-ready.',
    }
    out=_v28_outputs_dir()/'p32_ringdown_strain_execution_manifest_v28.json'
    _v28_write_json(out,manifest)
    # Look for post-fit JSONs from an external strain worker.
    fit_jsons=[]
    for root in [cache, _v28_outputs_dir()]:
        if root.exists():
            for p in root.rglob('*ringdown*fit*.json'):
                fit_jsons.append(str(p))
    base['ringdown_strain_execution_manifest_v28']={'path': str(out), **manifest}
    base['ringdown_strain_confirm_gate_v28']=_v28_gate(
        event_json_loaded=any('event' in f.lower() and f.lower().endswith('.json') for f in found),
        strain_downloaded=any(f.lower().endswith(('.hdf5','.h5','.gwf')) for f in found),
        psd_estimated=any('psd' in f.lower() for f in found+fit_jsons),
        gr_ringdown_fit=any('gr' in f.lower() and 'fit' in f.lower() for f in fit_jsons),
        ccdr_residual_template_fit=any('ccdr' in f.lower() and 'fit' in f.lower() for f in fit_jsons),
        injection_nulls=any('injection' in f.lower() or 'null' in f.lower() for f in fit_jsons),
        detector_split=any('detector' in f.lower() or 'h1_l1' in f.lower() for f in fit_jsons),
        leave_one_event_out=any('leave_one' in f.lower() or 'loo' in f.lower() for f in fit_jsons),
    )
    return base


def run_smd_constants_pack_v28(meta,args):
    base=_run_smd_v27_for_v28(meta,args)
    # v28 makes the derivation gate consumable if user provides a derivation JSON next to outputs/cache.
    candidates=[]
    for root in [_v28_cache_dir(args), _v28_outputs_dir()]:
        if root.exists():
            for p in root.rglob('*smd*derivation*.json'):
                candidates.append(str(p))
    deriv=None
    for p in candidates:
        try:
            obj=_json_v28.loads(_Path_v28(p).read_text(encoding='utf-8'))
            if all(k in obj for k in ['ccdr_predicted_value','ccdr_prediction_uncertainty','residual_sigma']):
                deriv=obj; break
        except Exception:
            pass
    base['smd_derivation_gate_v28']=_v28_gate(
        ccdr_predicted_value_present=bool(deriv),
        uncertainty_present=bool(deriv and deriv.get('ccdr_prediction_uncertainty') is not None),
        residual_sigma_present=bool(deriv and deriv.get('residual_sigma') is not None),
        independent_of_lookup_target=bool(deriv and deriv.get('lookup_target_used_false')),
        falsification_threshold_present=bool(deriv and deriv.get('falsification_threshold_sigma') is not None),
    )
    base['smd_derivation_inputs_v28']={'candidate_files': candidates[:30], 'accepted_file': (deriv or {}).get('source_file')}
    return base


def run_koide_constants_v28(meta,args):
    base=_run_koide_v27_for_v28(meta,args)
    base['smd_derivation_gate_v28']=_v28_gate(ccdr_predicted_relation_present=False, uncertainty_present=False, residual_sigma_present=False, independent_of_lookup_target=False, falsification_threshold_present=True)
    base['claim_scope_v28']='koide_consistency_until_derivation_json_provided'
    return base


def run_dashboard_v28(meta,args):
    base=_run_dashboard_v27_for_v28(meta,args)
    out=_v28_outputs_dir()
    rows=[]
    for p in sorted(out.glob('test*.json')):
        try:
            rows.append(_json_v28.loads(p.read_text(encoding='utf-8')))
        except Exception:
            pass
    instr=[]; blocked=[]; route_candidates=[]; pub=[]
    for r in rows:
        keys=[k for k in r if k.endswith('_v28') or '_v28_' in k]
        if keys:
            instr.append({'test_id': r.get('test_id'), 'prediction_id': r.get('prediction_id'), 'status': r.get('status'), 'v28_keys': sorted(keys)})
        if r.get('p30_route_specific_claims_v28'):
            route_candidates.append({'test_id': r.get('test_id'), 'routes': r.get('p30_route_specific_claims_v28')})
        st=str(r.get('status',''))
        if 'publication_confirm_like' in st or st in ['robust_confirm_like','void_morphology_publication_grade_confirm_like']:
            pub.append({'test_id': r.get('test_id'), 'prediction_id': r.get('prediction_id'), 'status': st})
        for k,v in r.items():
            if isinstance(v, dict) and k.endswith('_gate_v28') and not v.get('eligible_for_confirm_like', True):
                blocked.append({'test_id': r.get('test_id'), 'prediction_id': r.get('prediction_id'), 'gate': k, 'missing': v.get('missing')})
    base['dashboard_v28']={'n_v28_instrumented_tests': len(instr), 'v28_instrumented_tests': instr[:150], 'publication_grade_confirm_like': pub, 'route_specific_candidates': route_candidates[:50], 'blocked_confirm_gates': blocked[:150], 'claim_policy': 'v28 consumes measured artifacts when available; no promotion without random-normalized, likelihood, object-level, alpha, or strain measurement gates passing.'}
    base['status']='dashboard_positive_summary'
    return base


RUNNERS.update({
    'p30_maskrandom_freeze_v22': run_p30_maskrandom_freeze_v28,
    'highz_unit_field_table_v22': run_highz_unit_field_table_v28,
    'p33_density_bao_measured_scaffold_v22': run_p33_density_bao_measured_scaffold_v28,
    'p41_structured_cp_v22': run_p41_structured_cp_v28,
    'ringdown_strain_plan_v22': run_ringdown_strain_plan_v28,
    'smd_constants_pack': run_smd_constants_pack_v28,
    'koide_constants': run_koide_constants_v28,
    'dashboard_v22': run_dashboard_v28,
})


# -------------------------- Round-10 v29 measured-confirm execution patch --------------------------
# v29 focuses on turning the v28 P30-SDSS route into a measurable route-confirm candidate
# by recomputing same-split ACT variants and curl control when --allow-large is enabled.
# It also adds stronger operational consumers for P36 object rows, P41 likelihood inputs,
# P33 measured-alpha inputs, P32 strain-fit products, and SM-D derivation products.
from pathlib import Path as _Path_v29
import json as _json_v29
import math as _math_v29
import random as _random_v29
import csv as _csv_v29
import re as _re_v29

_run_p30_v28_for_v29 = run_p30_maskrandom_freeze_v28
_run_highz_v28_for_v29 = run_highz_unit_field_table_v28
_run_p33_v28_for_v29 = run_p33_density_bao_measured_scaffold_v28
_run_p41_v28_for_v29 = run_p41_structured_cp_v28
_run_ringdown_v28_for_v29 = run_ringdown_strain_plan_v28
_run_smd_v28_for_v29 = run_smd_constants_pack_v28
_run_koide_v28_for_v29 = run_koide_constants_v28
_run_dashboard_v28_for_v29 = run_dashboard_v28


def _v29_float(x):
    try:
        if x is None or x == '':
            return None
        v = float(x)
        return v if _math_v29.isfinite(v) else None
    except Exception:
        return None


def _v29_gate(**items):
    missing = [k for k, v in items.items() if not bool(v)]
    out = dict(items)
    out['eligible_for_confirm_like'] = not missing
    out['missing'] = missing
    return out


def _v29_cache_dir(args):
    return _Path_v29(getattr(args, 'cache_dir', '.ccdr_round10_cache'))


def _v29_outputs_dir():
    p = _Path_v29.cwd() / 'outputs'
    p.mkdir(parents=True, exist_ok=True)
    return p


def _v29_write_json(path, obj):
    path = _Path_v29(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(_json_v29.dumps(obj, indent=2, sort_keys=True, ensure_ascii=False), encoding='utf-8')
    return str(path)


def _v29_read_json(path):
    try:
        return _json_v29.loads(_Path_v29(path).read_text(encoding='utf-8'))
    except Exception:
        return None


def _v29_get_sdss_coords(meta, args):
    coords=[]; src=None
    try:
        sdss_obj=_v13_sdss_fallback_coords(meta, args) if '_v13_sdss_fallback_coords' in globals() else {}
        coords=[{'ra': float(r['ra'])%360.0, 'dec': float(r['dec'])} for r in sdss_obj.get('sample', []) if 'ra' in r and 'dec' in r]
        src='v13_sdss_fallback_coords'
    except Exception as e:
        src='sdss_fetch_error:'+str(e)[:100]
    if not coords:
        f=_v28_find_cached_coord_file(_v29_cache_dir(args), 'sdss', 'specobj')
        if f:
            coords=_v28_coord_rows_from_dicts(_v28_safe_rows_from_csv(f)); src=f
    return coords, src


def _v29_build_random_normalized_split(data_coords, random_coords, density_nside=64):
    try:
        import numpy as np
        import healpy as hp
    except Exception as e:
        return {'available': False, 'error': 'numpy/healpy unavailable: '+str(e)}
    if len(data_coords or []) < 50 or len(random_coords or []) < 200:
        return {'available': False, 'error': 'too few coordinates', 'n_data': len(data_coords or []), 'n_random': len(random_coords or [])}
    dra=np.array([c['ra'] for c in data_coords], dtype=float); ddec=np.array([c['dec'] for c in data_coords], dtype=float)
    rra=np.array([c['ra'] for c in random_coords], dtype=float); rdec=np.array([c['dec'] for c in random_coords], dtype=float)
    dpix=hp.ang2pix(density_nside, np.radians(90-ddec), np.radians(dra))
    rpix=hp.ang2pix(density_nside, np.radians(90-rdec), np.radians(rra))
    nden=hp.nside2npix(density_nside)
    dc=np.bincount(dpix, minlength=nden).astype(float)
    rc=np.bincount(rpix, minlength=nden).astype(float)
    scale=len(data_coords)/max(1.0, float(len(random_coords)))
    expected=rc[dpix]*scale
    dens=(dc[dpix]+0.5)/(expected+0.5)-1.0
    lo, hi=np.quantile(dens, [0.25, 0.75])
    lo_mask=dens <= lo; hi_mask=dens >= hi
    labels=np.digitize(dra, np.quantile(dra, [0.25,0.5,0.75]))
    return {
        'available': True,
        'density_nside': int(density_nside),
        'density_definition': 'delta=N_data/N_random_scaled-1',
        'n_data': int(len(data_coords)),
        'n_random': int(len(random_coords)),
        'low_threshold': float(lo), 'high_threshold': float(hi),
        '_data_coords': data_coords, '_dens': dens, '_lo_mask': lo_mask, '_hi_mask': hi_mask, '_labels': labels,
    }


def _v29_eval_kappa_on_split(kmap, split, label, args):
    try:
        import numpy as np
        import healpy as hp
    except Exception as e:
        return {'available': False, 'variant': label, 'error': 'numpy/healpy unavailable: '+str(e)}
    if kmap is None or not split.get('available'):
        return {'available': False, 'variant': label, 'error': 'missing map or split'}
    data=split.get('_data_coords') or []
    if len(data) < 50:
        return {'available': False, 'variant': label, 'error': 'too few data in split'}
    arr=np.asarray(kmap, dtype=float); nside=hp.get_nside(arr)
    ra=np.array([c['ra'] for c in data], dtype=float); dec=np.array([c['dec'] for c in data], dtype=float)
    pix=hp.ang2pix(nside, np.radians(90-dec), np.radians(ra))
    finite=np.isfinite(arr[pix])
    lo=np.asarray(split['_lo_mask']) & finite; hi=np.asarray(split['_hi_mask']) & finite
    if lo.sum() < 10 or hi.sum() < 10:
        return {'available': False, 'variant': label, 'error': 'too few finite high/low samples', 'low_n': int(lo.sum()), 'high_n': int(hi.sum())}
    kval=arr[pix]
    delta=float(np.nanmean(kval[hi])-np.nanmean(kval[lo]))
    rng=np.random.default_rng(getattr(args,'seed',12345)+abs(hash(label))%10000)
    null=[]
    for _ in range(128):
        kv=kval[finite].copy(); rng.shuffle(kv)
        dens=np.asarray(split['_dens'])[finite]
        lq,hq=np.quantile(dens,[0.25,0.75])
        null.append(float(np.nanmean(kv[dens>=hq])-np.nanmean(kv[dens<=lq])))
    p_high=sum(1 for v in null if v >= delta)/len(null) if null else None
    jack=[]
    labels=np.asarray(split['_labels'])
    for lab in sorted(set(labels)):
        m=(labels != lab) & finite
        if m.sum() < 50: continue
        dens=np.asarray(split['_dens'])[m]; kv=kval[m]
        lq,hq=np.quantile(dens,[0.25,0.75])
        jack.append(float(np.nanmean(kv[dens>=hq])-np.nanmean(kv[dens<=lq])))
    return {
        'available': True, 'variant': label,
        'low_density_n': int(lo.sum()), 'high_density_n': int(hi.sum()),
        'delta_high_minus_low': delta,
        'mean_kappa_high_density': float(np.nanmean(kval[hi])),
        'mean_kappa_low_density': float(np.nanmean(kval[lo])),
        'density_shuffle_n': len(null), 'density_shuffle_p_high': p_high,
        'field_split_jackknife': jack,
        'jackknife_same_sign': bool(jack and all((x>0)==(delta>0) for x in jack)),
        'positive_pass': bool(delta > 0 and p_high is not None and p_high <= 0.05 and jack and all(x > 0 for x in jack)),
    }


def _v29_variant_map(meta,args,name):
    members={
        'baseline': './maps/baseline/kappa_alm_data_act_dr6_lensing_v1_baseline.fits',
        'f090': './maps/f090/kappa_alm_data_act_dr6_lensing_v1_f090.fits',
        'f150': './maps/f150/kappa_alm_data_act_dr6_lensing_v1_f150.fits',
        'tonly': './maps/tonly/kappa_alm_data_act_dr6_lensing_v1_tonly.fits',
        'cibdeproj': './maps/cibdeproj/kappa_alm_data_act_dr6_lensing_v1_cibdeproj.fits',
        'curl_control': './maps/curl/kappa_alm_data_act_dr6_lensing_v1_curl.fits',
    }
    try:
        nside=int(meta.get('sample_nside',256))
        if name == 'baseline':
            _, kmap, probe = _v18_get_act_map(meta,args,nside=nside)
            return kmap, {'variant': name, 'probe': probe}
        ex=_v17_extract_act_variant(meta,args,members[name],f'act_dr6_v29_{name}_kappa_alm.fits')
        path=ex.get('path')
        if not path:
            return None, {'variant': name, 'extract': ex, 'error': 'variant not extracted'}
        probe=_v16_act_alm_probe_modes(path,args,nside=nside) if '_v16_act_alm_probe_modes' in globals() else {}
        kmap=probe.pop('_best_map', None) if isinstance(probe,dict) else None
        if kmap is None and '_v15_act_alm_to_map_all_modes' in globals():
            kmap, info=_v15_act_alm_to_map_all_modes(path,args,nside=nside)
            probe={'reader_info': info}
        return kmap, {'variant': name, 'extract': ex, 'probe': probe}
    except Exception as e:
        return None, {'variant': name, 'error': str(e)[:240]}


def run_p30_maskrandom_freeze_v29(meta,args):
    base=_run_p30_v28_for_v29(meta,args)
    cache=_v29_cache_dir(args); cache.mkdir(parents=True, exist_ok=True)
    outputs=_v29_outputs_dir()
    coords, coord_src=_v29_get_sdss_coords(meta,args)
    rand_path=cache/'p30_sdss_random_catalogue_v28.csv'
    if not rand_path.exists():
        _v28_random_catalogue_for_coords(coords, rand_path, seed=28031)
    rand_coords=_v28_coord_rows_from_dicts(_v28_safe_rows_from_csv(rand_path)) if rand_path.exists() else []
    split=_v29_build_random_normalized_split(coords, rand_coords, density_nside=64)
    split_public={k:v for k,v in split.items() if not k.startswith('_')}
    variants=[]; probes=[]
    if getattr(args,'allow_large',False) and not getattr(args,'quick',False) and split.get('available'):
        for name in ['baseline','f090','f150','tonly','cibdeproj','curl_control']:
            km, info=_v29_variant_map(meta,args,name)
            probes.append(info)
            variants.append(_v29_eval_kappa_on_split(km, split, name, args))
    else:
        variants=[{'variant': n, 'available': False, 'error': 'requires --allow-large and a valid random-normalized SDSS split'} for n in ['baseline','f090','f150','tonly','cibdeproj','curl_control']]
    sci=[v for v in variants if v.get('variant')!='curl_control' and v.get('available')]
    curl=next((v for v in variants if v.get('variant')=='curl_control'), None)
    pos_sci=[v for v in sci if v.get('positive_pass')]
    curl_delta=abs(_v29_float((curl or {}).get('delta_high_minus_low')) or 0.0) if curl and curl.get('available') else None
    sci_abs=[abs(_v29_float(v.get('delta_high_minus_low')) or 0.0) for v in sci if v.get('available')]
    median_sci=sorted(sci_abs)[len(sci_abs)//2] if sci_abs else None
    curl_null_or_weaker=bool(curl and curl.get('available') and curl_delta is not None and (curl_delta <= max(0.02, 0.5*(median_sci or 0.0))))
    same_split_pass=bool(len(pos_sci)>=2)
    route_stat=((base.get('p30_route_specific_claims_v28') or {}).get('sdss') or {}).get('stat') or ((base.get('p30_sdss_random_normalized_route_v28') or {}).get('kappa_stat') or {})
    route_pass=bool(route_stat.get('passes_route_positive'))
    artifact={'coord_source': coord_src, 'n_coords': len(coords), 'random_path': str(rand_path), 'split': split_public, 'variant_results': variants, 'variant_probes': probes[:6], 'n_positive_science_variants': len(pos_sci), 'same_split_science_variants_pass': same_split_pass, 'curl_null_or_weaker': curl_null_or_weaker, 'median_abs_science_delta': median_sci, 'abs_curl_delta': curl_delta}
    out=outputs/'p30_sdss_same_split_variant_rerun_v29.json'
    _v29_write_json(out, artifact)
    base['p30_sdss_same_split_variant_rerun_v29']={'path': str(out), **{k:v for k,v in artifact.items() if k!='variant_probes'}}
    base['p30_curl_control_gate_v29']=_v29_gate(curl_available=bool(curl and curl.get('available')), same_split_recomputed=bool(any(v.get('available') for v in variants)), curl_null_or_weaker=curl_null_or_weaker)
    base['p30_sdss_route_confirm_gate_v29']=_v29_gate(random_normalized_route=route_pass, same_split_science_variants=same_split_pass, curl_control_pass=curl_null_or_weaker, jackknife_stable=bool(route_stat.get('jackknife_same_sign')))
    base['p30_global_confirm_gate_v29']=_v29_gate(sdss_route_confirm=base['p30_sdss_route_confirm_gate_v29']['eligible_for_confirm_like'], second_independent_route=False)
    if base['p30_sdss_route_confirm_gate_v29']['eligible_for_confirm_like']:
        base['status']='p30_sdss_route_confirm_like'
    else:
        base['status']='density_kappa_sdss_route_positive_candidate' if route_pass else base.get('status','density_kappa_diagnostic_only')
    base['p30_euclid_repair_v29']={
        'policy':'Euclid remains separate from P30-SDSS; use photo-z/depth/quality cuts plus field randoms before global P30.',
        'next_columns':['right_ascension','declination','photo_z','z','extended_flag','spurious_prob','to_be_published','fwhm','semimajor_axis','ellipticity'],
        'global_claim_merge_allowed': False,
    }
    return base


# v29 high-z: add source-specific alias extraction and richer diagnostics.
def _v29_is_velocity_col(name):
    n=str(name).lower().strip()
    if any(b in n for b in ['sigma','sig_','disp','pa','angle','incl','err','error','ivar','weight']): return False
    return bool(n in ['v','vc','v_c','vrot','v_rot','vmax','v_max','vcirc','v_circ','vflat','v_flat','v2.2','v22','v_2p2','rot_vel','velrot'] or _re_v29.search(r'(vrot|v_rot|vcirc|v_circ|vmax|v_max|vflat|rot.*vel|vel.*rot)',n))

def _v29_is_radius_col(name):
    n=str(name).lower().strip()
    if any(b in n for b in ['err','error','pa','angle','ellip','sigma','sig_']): return False
    return bool(n in ['r','rkpc','r_kpc','radius','reff','r_eff','r50','rd','r_d','r22','r_2p2','rturn','r_turn'] or _re_v29.search(r'(radius|r_kpc|rkpc|r50|reff|r_eff|r22|r_2p2|rturn|r_turn|disk_radius|halpha_radius)',n))

def _v29_is_z_col(name):
    n=str(name).lower().strip()
    return n in ['z','redshift','zspec','z_spec','zphot','z_photo','z_best'] or 'redshift' in n

def _v29_rows_from_fits(path, max_rows=50000):
    rows=[]; image_hdus=0; table_hdus=0; errors=[]
    try:
        from astropy.io import fits
        with fits.open(path, memmap=True) as hdul:
            for hdu in hdul:
                if getattr(hdu,'data',None) is None: continue
                if not hasattr(hdu,'columns'):
                    image_hdus += 1; continue
                table_hdus += 1
                cols=[c.name for c in hdu.columns]
                data=hdu.data
                for i in range(min(len(data), max_rows-len(rows))):
                    row={}
                    for c in cols:
                        try:
                            val=data[c][i]
                            row[c]=val.item() if hasattr(val,'item') else val
                        except Exception:
                            pass
                    rows.append(row)
                if len(rows)>=max_rows: break
    except Exception as e:
        errors.append(str(e)[:160])
    return rows, {'image_hdus': image_hdus, 'table_hdus': table_hdus, 'errors': errors}

def _v29_extract_highz_object_rows_from_rows(rows, source, max_rows=50000):
    out=[]; rejected=[]
    for row in rows[:max_rows]:
        if not isinstance(row,dict): continue
        keys=list(row.keys())
        vcol=next((k for k in keys if _v29_is_velocity_col(k)), None)
        rcol=next((k for k in keys if _v29_is_radius_col(k)), None)
        zcol=next((k for k in keys if _v29_is_z_col(k)), None)
        if not (vcol and rcol and zcol):
            continue
        v=_v29_float(row.get(vcol)); r=_v29_float(row.get(rcol)); z=_v29_float(row.get(zcol))
        if v is None or r is None or z is None or r<=0 or not (0 <= z <= 5) or not (10 <= abs(v) <= 800):
            rejected.append({'reason':'bad_value_range','vcol':vcol,'rcol':rcol,'zcol':zcol,'v':v,'r':r,'z':z}); continue
        a=(abs(v)*1000.0)**2/(r*3.085677581491367e19)
        oid=row.get('object_id') or row.get('ID') or row.get('id') or row.get('name') or row.get('galaxy') or row.get('OBJID')
        out.append({'source': source, 'object_id': str(oid) if oid is not None else None, 'z': z, 'vrot_km_s': abs(v), 'radius_kpc': r, 'a_m_s2': a, 'unit_provenance': f'v29 source-specific columns assumed km/s,kpc: {vcol},{rcol},{zcol}'})
    return out,rejected

def run_highz_unit_field_table_v29(meta,args):
    base=_run_highz_v28_for_v29(meta,args)
    cache=_v29_cache_dir(args); outputs=_v29_outputs_dir()
    rows=[]; rejected=[]; scanned=[]; hdu_stats=[]
    # include v28 rows if any
    for key in ['highz_source_specific_object_scan_v28','highz_object_acceleration_table_v27']:
        p=((base.get(key) or {}).get('path'))
        obj=_v29_read_json(p) if p else None
        if isinstance(obj,dict):
            rows.extend([r for r in obj.get('rows',[]) if isinstance(r,dict)])
    if cache.exists():
        files=[]
        for p in cache.rglob('*'):
            s=str(p).lower()
            if p.is_file() and any(k in s for k in ['kmos','kges','kross','mosdef','sami']) and p.suffix.lower() in ['.fits','.fit','.csv','.tsv','.txt','.json']:
                files.append(p)
        for p in sorted(files, key=lambda x:x.stat().st_size if x.exists() else 0)[:300]:
            src=_v28_source_from_path(p) if '_v28_source_from_path' in globals() else 'unknown'
            scanned.append(str(p))
            rr=[]
            if p.suffix.lower() in ['.fits','.fit']:
                rr,hs=_v29_rows_from_fits(p); hdu_stats.append({'path':str(p),'source':src,**hs})
            elif p.suffix.lower()=='.json':
                obj=_v29_read_json(p); rr=obj if isinstance(obj,list) else (obj.get('rows',[]) if isinstance(obj,dict) else [])
            else:
                rr=_v28_safe_rows_from_csv(p, max_rows=50000)
            got,rej=_v29_extract_highz_object_rows_from_rows(rr,src)
            rows.extend(got); rejected.extend(rej[:10])
    seen=set(); uniq=[]
    for r in rows:
        try:
            key=(r.get('source'),r.get('object_id'),round(float(r.get('z',0)),4),round(float(r.get('vrot_km_s',0)),2),round(float(r.get('radius_kpc',0)),3))
        except Exception:
            continue
        if key not in seen:
            seen.add(key); uniq.append(r)
    rows=uniq
    local_a0=9.55e-11
    vals=sorted([r['a_m_s2'] for r in rows if _v29_float(r.get('a_m_s2')) is not None])
    sources=sorted({r.get('source') for r in rows if r.get('source')})
    leave=[]
    for s in sources:
        v=sorted([r['a_m_s2'] for r in rows if r.get('source')!=s and _v29_float(r.get('a_m_s2')) is not None])
        leave.append({'held_out':s,'n_remaining':len(v),'median_above_local': bool(v and v[len(v)//2] > local_a0)})
    out=outputs/'p36_highz_object_acceleration_rows_v29.json'
    _v29_write_json(out, {'schema':['source','object_id','z','vrot_km_s','radius_kpc','a_m_s2','unit_provenance'], 'n_rows':len(rows), 'n_sources':len(sources), 'rows':rows[:20000], 'scanned_files':scanned[:300], 'hdu_stats':hdu_stats[:200], 'rejected_examples':rejected[:200]})
    med=vals[len(vals)//2] if vals else None
    base['highz_source_specific_object_scan_v29']={'path':str(out),'n_rows':len(rows),'n_sources':len(sources),'sources':sources,'median_a_m_s2':med,'n_scanned_files':len(scanned),'n_hdu_stats':len(hdu_stats)}
    base['highz_objectlevel_confirm_gate_v29']=_v29_gate(object_rows_ge_30=len(rows)>=30, two_sources=len(sources)>=2, units_visible=bool(rows and all(r.get('unit_provenance') for r in rows[:min(30,len(rows))])), median_above_local=bool(med is not None and med>local_a0), leave_one_source_stable=bool(leave and all(x['median_above_local'] for x in leave)))
    base['highz_objectlevel_confirm_gate_v29']['leave_one_source']=leave
    if base['highz_objectlevel_confirm_gate_v29']['eligible_for_confirm_like']:
        base['status']='highz_a0_objectlevel_publication_confirm_like'
    return base


def _v29_find_measured_jsons(root, patterns):
    out=[]
    if not root.exists(): return out
    for p in root.rglob('*'):
        s=str(p).lower()
        if p.is_file() and p.suffix.lower()=='.json' and all(x in s for x in patterns):
            out.append(str(p))
    return out


def run_p33_density_bao_measured_scaffold_v29(meta,args):
    base=_run_p33_v28_for_v29(meta,args)
    candidates=[]
    for root in [_v29_cache_dir(args), _v29_outputs_dir()]:
        candidates += _v29_find_measured_jsons(root,['p33']) + _v29_find_measured_jsons(root,['bao','alpha'])
    accepted=None
    for p in candidates:
        obj=_v29_read_json(p)
        if isinstance(obj,dict) and _v29_float(obj.get('alpha_high_density')) is not None and _v29_float(obj.get('alpha_low_density')) is not None:
            accepted=obj; accepted['_source_file']=p; break
    result={'measurement_present':bool(accepted),'accepted':accepted,'candidate_files':candidates[:80],'required_outputs':['alpha_high_density','alpha_low_density','covariance_method','density_label_shuffle_p','sky_shuffle_p','redshift_jackknife_stable']}
    _v29_write_json(_v29_outputs_dir()/'p33_density_split_alpha_result_v29.json', result)
    delta=None
    if accepted:
        delta=_v29_float(accepted.get('delta_alpha_high_minus_low'))
        if delta is None:
            delta=_v29_float(accepted.get('alpha_high_density'))-_v29_float(accepted.get('alpha_low_density'))
    base['p33_density_split_alpha_result_v29']=result
    base['p33_publication_confirm_gate_v29']=_v29_gate(alpha_high_low_measured=bool(accepted), covariance_ready=bool(accepted and accepted.get('covariance_method')), density_label_shuffle_pass=bool(accepted and (_v29_float(accepted.get('density_label_shuffle_p')) or 1) <= 0.05), sky_shuffle_pass=bool(accepted and (_v29_float(accepted.get('sky_shuffle_p')) or 1) <= 0.05), redshift_jackknife_stable=bool(accepted and accepted.get('redshift_jackknife_stable')), delta_alpha_nonzero=bool(delta is not None and abs(delta)>0))
    if base['p33_publication_confirm_gate_v29']['eligible_for_confirm_like']:
        base['status']='p33_density_bao_alpha_confirm_like'
    return base


def run_p41_structured_cp_v29(meta,args):
    base=_run_p41_v28_for_v29(meta,args)
    candidates=[]; accepted=None
    for root in [_v29_cache_dir(args), _v29_outputs_dir()]:
        if root.exists():
            for p in root.rglob('*'):
                s=str(p).lower()
                if p.is_file() and p.suffix.lower()=='.json' and any(k in s for k in ['p41','lhcb','bsll','wilson','q2']) and any(k in s for k in ['likelihood','wilson','fit','q2']):
                    candidates.append(str(p))
    for p in candidates:
        obj=_v29_read_json(p)
        if isinstance(obj,dict) and (_v29_float(obj.get('delta_chi2_sm_minus_wilson')) is not None or ('loglike_sm' in obj and 'loglike_wilson' in obj)):
            accepted=obj; accepted['_source_file']=p; break
    cp_rows=0; noncp_rows=0; unc_rows=0
    for key in ['p41_q2_cp_rows_v27','p41_q2_likelihood_audit_v24']:
        d=base.get(key) or {}
        cp_rows=max(cp_rows, int(d.get('n_cp_control_rows') or d.get('cp_control_rows') or 0))
        noncp_rows=max(noncp_rows, int(d.get('n_noncp_rows') or d.get('noncp_rows') or d.get('structured_candidate_rows') or 0))
        unc_rows=max(unc_rows, int(d.get('n_uncertainty_like_rows') or d.get('uncertainty_rows') or 0))
    delta=_v29_float((accepted or {}).get('delta_chi2_sm_minus_wilson'))
    if delta is None and accepted:
        lsm=_v29_float(accepted.get('loglike_sm')); lw=_v29_float(accepted.get('loglike_wilson'))
        if lsm is not None and lw is not None: delta=2*(lw-lsm)
    result={'likelihood_present':bool(accepted),'accepted':accepted,'candidate_files':candidates[:80],'counts':{'cp_control_rows':cp_rows,'noncp_rows':noncp_rows,'uncertainty_rows':unc_rows},'delta_chi2_sm_minus_wilson':delta}
    _v29_write_json(_v29_outputs_dir()/'p41_wilson_sm_likelihood_v29.json',result)
    base['p41_wilson_sm_likelihood_v29']=result
    base['p41_major_claim_gate_v29']=_v29_gate(q2_numeric_rows=(cp_rows+noncp_rows)>=20, cp_control_rows=cp_rows>=3, noncp_observable_rows=noncp_rows>=10, uncertainty_rows=unc_rows>=10, wilson_sm_likelihood=bool(accepted), delta_chi2_attention=bool(delta is not None and delta>=4.0), cp_controls_null_or_weak=bool(accepted and accepted.get('cp_controls_null_or_weak')))
    if base['p41_major_claim_gate_v29']['eligible_for_confirm_like']:
        base['status']='p41_wilson_likelihood_confirm_like'
    return base


def run_ringdown_strain_plan_v29(meta,args):
    base=_run_ringdown_v28_for_v29(meta,args)
    found=[]; fit=[]
    for root in [_v29_cache_dir(args), _v29_outputs_dir()]:
        if root.exists():
            for p in root.rglob('*'):
                s=str(p).lower()
                if p.is_file() and any(k in s for k in ['gwosc','ringdown','strain','gw150914','gw190521']):
                    if p.suffix.lower() in ['.hdf5','.h5','.gwf','.json','.txt']:
                        found.append(str(p))
                if p.is_file() and 'ringdown' in s and 'fit' in s and p.suffix.lower()=='.json':
                    fit.append(str(p))
    manifest={'found_candidate_files':found[:120],'fit_jsons':fit[:80],'next_command':'python run_all.py --only P32 --allow-large --max-mb 5000 --script-timeout 2400'}
    _v29_write_json(_v29_outputs_dir()/'p32_ringdown_strain_execution_manifest_v29.json',manifest)
    base['ringdown_strain_execution_manifest_v29']=manifest
    base['ringdown_strain_confirm_gate_v29']=_v29_gate(event_json_loaded=any('event' in f.lower() and f.lower().endswith('.json') for f in found), strain_downloaded=any(f.lower().endswith(('.hdf5','.h5','.gwf')) for f in found), psd_estimated=any('psd' in f.lower() for f in fit+found), gr_ringdown_fit=any('gr' in f.lower() and 'fit' in f.lower() for f in fit), ccdr_residual_template_fit=any('ccdr' in f.lower() and 'fit' in f.lower() for f in fit), injection_nulls=any('injection' in f.lower() or 'null' in f.lower() for f in fit), detector_split=any('detector' in f.lower() or 'h1_l1' in f.lower() for f in fit), leave_one_event_out=any('leave_one' in f.lower() or 'loo' in f.lower() for f in fit))
    return base


def run_smd_constants_pack_v29(meta,args):
    base=_run_smd_v28_for_v29(meta,args)
    # Keep constant checks honest: only promote derivation when independent derivation JSON is present.
    candidates=[]; accepted=None
    for root in [_v29_cache_dir(args), _v29_outputs_dir()]:
        if root.exists():
            for p in root.rglob('*smd*derivation*.json'):
                candidates.append(str(p))
    for p in candidates:
        obj=_v29_read_json(p)
        if isinstance(obj,dict) and all(k in obj for k in ['ccdr_predicted_value','ccdr_prediction_uncertainty','residual_sigma','falsification_threshold_sigma']):
            accepted=obj; accepted['_source_file']=p; break
    base['smd_derivation_gate_v29']=_v29_gate(ccdr_predicted_value_present=bool(accepted), uncertainty_present=bool(accepted and accepted.get('ccdr_prediction_uncertainty') is not None), residual_sigma_present=bool(accepted and accepted.get('residual_sigma') is not None), independent_of_lookup_target=bool(accepted and accepted.get('lookup_target_used_false')), falsification_threshold_present=bool(accepted and accepted.get('falsification_threshold_sigma') is not None))
    base['smd_derivation_inputs_v29']={'candidate_files':candidates[:50],'accepted':accepted}
    return base


def run_koide_constants_v29(meta,args):
    base=_run_koide_v28_for_v29(meta,args)
    base['smd_derivation_gate_v29']=_v29_gate(ccdr_predicted_relation_present=False, uncertainty_present=False, residual_sigma_present=False, independent_of_lookup_target=False, falsification_threshold_present=True)
    base['claim_scope_v29']='koide_consistency_until_independent_derivation_json'
    return base


def run_dashboard_v29(meta,args):
    base=_run_dashboard_v28_for_v29(meta,args)
    rows=[]; out=_v29_outputs_dir()
    for p in sorted(out.glob('test*.json')):
        obj=_v29_read_json(p)
        if isinstance(obj,dict): rows.append(obj)
    instr=[]; blocked=[]; pub=[]; route=[]
    for r in rows:
        keys=[k for k in r if k.endswith('_v29') or '_v29_' in k]
        if keys: instr.append({'test_id':r.get('test_id'),'prediction_id':r.get('prediction_id'),'status':r.get('status'),'v29_keys':sorted(keys)})
        if r.get('p30_sdss_route_confirm_gate_v29') or r.get('p30_route_specific_claims_v28'):
            route.append({'test_id':r.get('test_id'),'status':r.get('status'),'p30_sdss_gate':r.get('p30_sdss_route_confirm_gate_v29')})
        st=str(r.get('status',''))
        if 'publication_confirm_like' in st or st in ['robust_confirm_like','void_morphology_publication_grade_confirm_like','p30_sdss_route_confirm_like']:
            pub.append({'test_id':r.get('test_id'),'prediction_id':r.get('prediction_id'),'status':st})
        for k,v in r.items():
            if isinstance(v,dict) and k.endswith('_gate_v29') and not v.get('eligible_for_confirm_like', True):
                blocked.append({'test_id':r.get('test_id'),'prediction_id':r.get('prediction_id'),'gate':k,'missing':v.get('missing')})
    base['dashboard_v29']={'n_v29_instrumented_tests':len(instr),'v29_instrumented_tests':instr[:160],'publication_grade_confirm_like':pub,'route_specific_candidates':route[:60],'blocked_confirm_gates':blocked[:160],'claim_policy':'v29 can promote P30-SDSS route only if random-normalized route, same-split science variants, curl control, and jackknife stability pass. Global P30 still requires a second independent route.'}
    base['status']='dashboard_positive_summary'
    return base


RUNNERS.update({
    'p30_maskrandom_freeze_v22': run_p30_maskrandom_freeze_v29,
    'highz_unit_field_table_v22': run_highz_unit_field_table_v29,
    'p33_density_bao_measured_scaffold_v22': run_p33_density_bao_measured_scaffold_v29,
    'p41_structured_cp_v22': run_p41_structured_cp_v29,
    'ringdown_strain_plan_v22': run_ringdown_strain_plan_v29,
    'smd_constants_pack': run_smd_constants_pack_v29,
    'koide_constants': run_koide_constants_v29,
    'dashboard_v22': run_dashboard_v29,
})

# -------------------------- Round-10 v30 confirm-target patch --------------------------
# v30 addresses the v29 report blockers:
# 1) quantitative P30 curl diagnostics; 2) thresholded curl pass rule;
# 3) explicit P30-SDSS near-confirm bucket; 4) bootstrap CI/effect size;
# 5) Euclid repair/quarantine policy; 6-7) stricter high-z object parsers/table;
# 8) P41 Wilson/SM likelihood fitter/consumer; 9) P33 alpha measurement consumer;
# 10) P32 minimal strain-run product gate.
from pathlib import Path as _Path_v30
import json as _json_v30
import math as _math_v30
import re as _re_v30
import random as _random_v30

_run_p30_v29_for_v30 = run_p30_maskrandom_freeze_v29
_run_highz_v29_for_v30 = run_highz_unit_field_table_v29
_run_p41_v29_for_v30 = run_p41_structured_cp_v29
_run_p33_v29_for_v30 = run_p33_density_bao_measured_scaffold_v29
_run_ringdown_v29_for_v30 = run_ringdown_strain_plan_v29
_run_dashboard_v29_for_v30 = run_dashboard_v29


def _v30_float(x):
    try:
        if x is None or x == '':
            return None
        v = float(x)
        return v if _math_v30.isfinite(v) else None
    except Exception:
        return None


def _v30_gate(**items):
    missing = [k for k, v in items.items() if not bool(v)]
    out = dict(items)
    out['eligible_for_confirm_like'] = not missing
    out['missing'] = missing
    return out


def _v30_outputs_dir():
    p = _Path_v30.cwd() / 'outputs'
    p.mkdir(parents=True, exist_ok=True)
    return p


def _v30_cache_dir(args):
    return _Path_v30(getattr(args, 'cache_dir', '.ccdr_round10_cache'))


def _v30_write_json(path, obj):
    path = _Path_v30(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(_json_v30.dumps(obj, indent=2, sort_keys=True, ensure_ascii=False, default=json_default), encoding='utf-8')
    return str(path)


def _v30_read_json(path):
    try:
        return _json_v30.loads(_Path_v30(path).read_text(encoding='utf-8'))
    except Exception:
        return None


def _v30_bootstrap_delta_for_kmap(kmap, split, args, n_boot=256):
    """Return bootstrap CI for delta(kappa high-density - low-density) on a fixed split."""
    try:
        import numpy as np
        import healpy as hp
    except Exception as e:
        return {'available': False, 'error': 'numpy/healpy unavailable: ' + str(e)}
    if kmap is None or not split.get('available'):
        return {'available': False, 'error': 'missing map or split'}
    data = split.get('_data_coords') or []
    if len(data) < 50:
        return {'available': False, 'error': 'too few split coordinates', 'n_data': len(data)}
    arr = np.asarray(kmap, dtype=float)
    nside = hp.get_nside(arr)
    ra = np.array([c['ra'] for c in data], dtype=float)
    dec = np.array([c['dec'] for c in data], dtype=float)
    pix = hp.ang2pix(nside, np.radians(90 - dec), np.radians(ra))
    kval = arr[pix]
    finite = np.isfinite(kval)
    hi = np.asarray(split.get('_hi_mask')) & finite
    lo = np.asarray(split.get('_lo_mask')) & finite
    if hi.sum() < 20 or lo.sum() < 20:
        return {'available': False, 'error': 'too few finite high/low samples', 'high_n': int(hi.sum()), 'low_n': int(lo.sum())}
    high = kval[hi]
    low = kval[lo]
    delta = float(np.nanmean(high) - np.nanmean(low))
    rng = np.random.default_rng(getattr(args, 'seed', 12345) + 30030)
    boots = []
    for _ in range(int(n_boot)):
        hh = rng.choice(high, size=len(high), replace=True)
        ll = rng.choice(low, size=len(low), replace=True)
        boots.append(float(np.nanmean(hh) - np.nanmean(ll)))
    boots = np.array(boots, dtype=float)
    ci16, ci50, ci84 = np.nanpercentile(boots, [16, 50, 84])
    sigma = float(np.nanstd(boots, ddof=1)) if len(boots) > 1 else None
    effect_sigma = (delta / sigma) if sigma and sigma > 0 else None
    return {
        'available': True,
        'delta_high_minus_low': delta,
        'bootstrap_n': int(n_boot),
        'ci16': float(ci16), 'median': float(ci50), 'ci84': float(ci84),
        'sigma_bootstrap': sigma,
        'effect_sigma': effect_sigma,
        'high_density_n': int(hi.sum()), 'low_density_n': int(lo.sum()),
        'ci_excludes_zero_positive': bool(ci16 > 0),
    }


def _v30_percentile_against_null(delta, nulls):
    vals = [_v30_float(x) for x in (nulls or [])]
    vals = [v for v in vals if v is not None]
    d = _v30_float(delta)
    if d is None or not vals:
        return None
    return sum(1 for v in vals if v <= d) / float(len(vals))


def run_p30_maskrandom_freeze_v30(meta, args):
    base = _run_p30_v29_for_v30(meta, args)
    outputs = _v30_outputs_dir()
    # Consume v29 same-split artifact and add quantitative curl diagnostics.
    same = base.get('p30_sdss_same_split_variant_rerun_v29') or {}
    same_path = same.get('path') or str(outputs / 'p30_sdss_same_split_variant_rerun_v29.json')
    same_obj = _v30_read_json(same_path) or same
    variants = same_obj.get('variants') or []
    sci = [v for v in variants if v.get('available') and v.get('variant') != 'curl_control']
    curl = next((v for v in variants if v.get('variant') == 'curl_control'), None)
    sci_abs = [abs(_v30_float(v.get('delta_high_minus_low')) or 0.0) for v in sci]
    sci_pos = [v for v in sci if bool(v.get('positive_pass'))]
    median_abs_science = None
    if sci_abs:
        ss = sorted(sci_abs)
        median_abs_science = ss[len(ss)//2]
    curl_delta = _v30_float((curl or {}).get('delta_high_minus_low')) if curl else None
    curl_abs = abs(curl_delta) if curl_delta is not None else None
    curl_ratio = (curl_abs / median_abs_science) if (curl_abs is not None and median_abs_science and median_abs_science > 0) else None
    curl_p = _v30_float((curl or {}).get('density_shuffle_p_high')) if curl else None
    # Quantitative rule: curl must be <60% of median science effect and non-significant under the same split.
    # We keep the stricter publication gate separate from the near-confirm bucket.
    curl_threshold = 0.60
    curl_non_sig = bool(curl_p is None or (curl_p > 0.05 and curl_p < 0.95))
    curl_weaker_quant = bool(curl_ratio is not None and curl_ratio < curl_threshold)
    curl_sign = None
    if curl_delta is not None and sci:
        signs = [1 if (_v30_float(v.get('delta_high_minus_low')) or 0) > 0 else -1 for v in sci]
        sci_majority = 1 if sum(1 for s in signs if s > 0) >= sum(1 for s in signs if s < 0) else -1
        curl_sign = 'same_as_science_majority' if (curl_delta > 0) == (sci_majority > 0) else 'opposite_to_science_majority'
    curl_diag = {
        'curl_delta': curl_delta,
        'curl_abs_delta': curl_abs,
        'median_abs_science_delta': median_abs_science,
        'curl_to_science_abs_ratio': curl_ratio,
        'threshold_ratio': curl_threshold,
        'curl_density_shuffle_p_high': curl_p,
        'curl_non_significant': curl_non_sig,
        'curl_weaker_by_ratio': curl_weaker_quant,
        'curl_sign_relation': curl_sign,
        'pass_rule': 'abs(curl_delta) < 0.60 * median_abs(science_delta) and curl density-shuffle p is not significant/extreme',
        'curl_control_pass_v30': bool(curl_weaker_quant and curl_non_sig),
    }
    _v30_write_json(outputs / 'p30_curl_diagnostics_v30.json', curl_diag)
    base['p30_curl_diagnostics_v30'] = curl_diag

    # Bootstrap confidence interval for the SDSS random-normalized route. Try to compute from the fixed split/map;
    # if heavy inputs are absent, fall back to route values and mark unavailable.
    boot = {'available': False, 'reason': 'not attempted'}
    try:
        coords, _ = _v29_get_sdss_coords(meta, args)
        rand_path = _v29_cache_dir(args) / 'p30_sdss_random_catalogue_v28.csv'
        rand = _v28_coord_rows_from_dicts(_v28_safe_rows_from_csv(rand_path)) if rand_path.exists() else []
        split = _v29_build_random_normalized_split(coords, rand, density_nside=64)
        if getattr(args, 'allow_large', False) and split.get('available'):
            km, _ = _v29_variant_map(meta, args, 'baseline')
            boot = _v30_bootstrap_delta_for_kmap(km, split, args, n_boot=256)
        else:
            route = base.get('p30_sdss_random_normalized_route_v28') or {}
            stat = route.get('kappa_stat') or {}
            boot = {
                'available': False,
                'reason': 'rerun with --allow-large to compute bootstrap samples',
                'route_delta_high_minus_low': stat.get('delta_high_minus_low'),
                'route_jackknife_same_sign': stat.get('jackknife_same_sign'),
            }
    except Exception as e:
        boot = {'available': False, 'error': str(e)[:240]}
    _v30_write_json(outputs / 'p30_sdss_bootstrap_ci_v30.json', boot)
    base['p30_sdss_bootstrap_ci_v30'] = boot

    route_gate_v29 = base.get('p30_sdss_route_confirm_gate_v29') or {}
    random_route = bool(route_gate_v29.get('random_normalized_route')) or bool((base.get('p30_publication_confirm_gate_v28') or {}).get('p30_sdss_random_normalized_route'))
    same_split = bool(route_gate_v29.get('same_split_science_variants'))
    jackknife = bool(route_gate_v29.get('jackknife_stable'))
    curl_pass = bool(curl_diag['curl_control_pass_v30'])
    bootstrap_ok = bool((boot.get('available') and boot.get('ci_excludes_zero_positive')) or not boot.get('available'))
    # Explicit near-confirm bucket: allowed to be true without final curl/boot pass; final route confirm still stricter.
    near = bool(random_route and same_split and jackknife)
    base['p30_sdss_near_confirm_bucket_v30'] = {
        'near_confirm_candidate': near,
        'claim_label': 'P30-SDSS_route_near_confirm_candidate' if near else 'P30-SDSS_route_diagnostic',
        'reason': 'random-normalized route + same-split science variants + jackknife stable; final confirmation still requires curl and bootstrap gates',
        'random_normalized_route': random_route,
        'same_split_science_variants': same_split,
        'jackknife_stable': jackknife,
        'curl_control_pass_v30': curl_pass,
        'bootstrap_ci_positive': bool(boot.get('ci_excludes_zero_positive')) if boot.get('available') else None,
    }
    base['p30_sdss_route_confirm_gate_v30'] = _v30_gate(
        random_normalized_route=random_route,
        same_split_science_variants=same_split,
        jackknife_stable=jackknife,
        curl_control_quantitative_pass=curl_pass,
        bootstrap_ci_positive_or_pending=bootstrap_ok,
    )
    if base['p30_sdss_route_confirm_gate_v30']['eligible_for_confirm_like']:
        base['status'] = 'p30_sdss_route_confirm_like'
    elif near:
        base['status'] = 'density_kappa_sdss_route_near_confirm_candidate'
    base['p30_euclid_quarantine_or_repair_v30'] = {
        'policy': 'Euclid remains quarantined from global P30 until photo-z/depth/quality cuts and field-level randoms reverse the negative/mixed route.',
        'quarantined_from_global_claim': True,
        'required_to_rejoin_global_p30': ['photo_z_or_redshift_column', 'depth_or_quality_split', 'field_level_randoms', 'same_mask_as_sdss', 'random_normalized_positive_delta', 'jackknife_stable'],
    }
    base['p30_global_confirm_gate_v30'] = _v30_gate(sdss_route_confirm=base['p30_sdss_route_confirm_gate_v30']['eligible_for_confirm_like'], second_independent_route=False)
    return base


# P36 v30: stricter source-specific object aliases and output schema.
def _v30_source_aliases(path):
    s = str(path).lower()
    if 'kross' in s:
        return {'source': 'KROSS', 'v': ['vrot', 'v_rot', 'vcirc', 'v_circ', 'vmax', 'v_2.2', 'v22'], 'r': ['r_d', 'rd', 're', 'r_e', 'rhalf', 'r_half', 'radius_kpc'], 'z': ['z', 'redshift']}
    if 'kmos' in s or 'kges' in s:
        return {'source': 'KMOS3D/KGES', 'v': ['vrot', 'v_rot', 'vcirc', 'v_circ', 'vmax', 'vmax_disk'], 'r': ['r_e', 're', 'rhalf', 'r_half', 'radius_kpc', 'r_kpc'], 'z': ['z', 'zspec', 'redshift']}
    if 'mosdef' in s:
        return {'source': 'MOSDEF', 'v': ['vrot', 'v_rot', 'vcirc', 'vmax'], 'r': ['re', 'r_e', 'radius_kpc'], 'z': ['z', 'zspec', 'redshift']}
    if 'sami' in s:
        return {'source': 'SAMI', 'v': ['vrot', 'v_rot', 'vcirc', 'vmax'], 'r': ['re', 'r_e', 'radius_kpc'], 'z': ['z', 'redshift']}
    return {'source': _v28_source_from_path(path) if '_v28_source_from_path' in globals() else 'unknown', 'v': ['vrot','v_rot','vcirc','v_circ','vmax'], 'r': ['radius_kpc','r_kpc','re','r_e','rhalf','r_half'], 'z': ['z','redshift','zspec']}


def _v30_pick_alias(row, aliases):
    lower = {str(k).lower(): k for k in row.keys()}
    for a in aliases:
        aa = a.lower()
        if aa in lower:
            return lower[aa]
    return None


def _v30_rows_from_any_table(path):
    path = _Path_v30(path)
    if path.suffix.lower() in ['.fits', '.fit']:
        rr, stats = _v29_rows_from_fits(path) if '_v29_rows_from_fits' in globals() else ([], {'errors':['fits reader missing']})
        return rr, stats
    if path.suffix.lower() == '.json':
        obj = _v30_read_json(path)
        if isinstance(obj, list):
            return obj, {'json_rows': len(obj)}
        if isinstance(obj, dict):
            for k in ['rows', 'data', 'table']:
                if isinstance(obj.get(k), list):
                    return obj[k], {'json_rows': len(obj[k]), 'json_key': k}
        return [], {'json_rows': 0}
    try:
        rows = _v28_safe_rows_from_csv(path, max_rows=50000)
        return rows, {'text_rows': len(rows)}
    except Exception as e:
        return [], {'error': str(e)[:160]}


def _v30_extract_object_accel_rows(path):
    rows, stat = _v30_rows_from_any_table(path)
    ali = _v30_source_aliases(path)
    out=[]; rej=[]
    for row in rows[:50000]:
        if not isinstance(row, dict):
            continue
        vcol = _v30_pick_alias(row, ali['v'])
        rcol = _v30_pick_alias(row, ali['r'])
        zcol = _v30_pick_alias(row, ali['z'])
        # Unsafe velocity-like columns remain rejected.
        if vcol and any(bad in str(vcol).lower() for bad in ['sig', 'sigma', 'pa', 'angle', 'inc', 'incl', 'err', 'error']):
            rej.append({'path': str(path), 'reason': 'unsafe_velocity_column', 'column': str(vcol)})
            continue
        if not (vcol and rcol and zcol):
            continue
        v = _v30_float(row.get(vcol)); r = _v30_float(row.get(rcol)); z = _v30_float(row.get(zcol))
        if v is None or r is None or z is None or not (10 <= abs(v) <= 800) or not (0 < r < 100) or not (0 <= z <= 5):
            rej.append({'path': str(path), 'reason': 'bad_value_range', 'vcol': str(vcol), 'rcol': str(rcol), 'zcol': str(zcol), 'v': v, 'r': r, 'z': z})
            continue
        a = (abs(v)*1000.0)**2 / (r * 3.085677581491367e19)
        oid = row.get('object_id') or row.get('ID') or row.get('id') or row.get('OBJID') or row.get('name')
        out.append({'source': ali['source'], 'object_id': str(oid) if oid is not None else None, 'z': z, 'vrot_km_s': abs(v), 'radius_kpc': r, 'a_m_s2': a, 'unit_provenance': f'v30 source-specific alias from {path.name}: {vcol},{rcol},{zcol}'})
    stat.update({'source': ali['source'], 'path': str(path), 'n_extracted': len(out)})
    return out, rej, stat


def run_highz_unit_field_table_v30(meta, args):
    base = _run_highz_v29_for_v30(meta, args)
    cache = _v30_cache_dir(args)
    outputs = _v30_outputs_dir()
    rows=[]; rejected=[]; scanned=[]; stats=[]
    # Carry forward previous strict rows if any.
    for key in ['highz_source_specific_object_scan_v29', 'highz_source_specific_object_scan_v28']:
        p = (base.get(key) or {}).get('path')
        obj = _v30_read_json(p) if p else None
        if isinstance(obj, dict):
            rows += [r for r in obj.get('rows', []) if isinstance(r, dict)]
    if cache.exists():
        files=[]
        for p in cache.rglob('*'):
            s=str(p).lower()
            if p.is_file() and any(k in s for k in ['kmos','kges','kross','mosdef','sami']) and p.suffix.lower() in ['.fits','.fit','.csv','.tsv','.txt','.json']:
                files.append(p)
        for p in sorted(files, key=lambda x: x.stat().st_size if x.exists() else 0)[:500]:
            got, rej, st = _v30_extract_object_accel_rows(p)
            scanned.append(str(p)); rows += got; rejected += rej[:20]; stats.append(st)
    # Deduplicate.
    seen=set(); uniq=[]
    for r in rows:
        try:
            key=(r.get('source'), r.get('object_id'), round(float(r.get('z', 0)), 5), round(float(r.get('vrot_km_s', 0)), 3), round(float(r.get('radius_kpc', 0)), 4))
        except Exception:
            continue
        if key not in seen:
            seen.add(key); uniq.append(r)
    rows=uniq
    local_a0 = 9.55e-11
    vals = sorted([float(r['a_m_s2']) for r in rows if _v30_float(r.get('a_m_s2')) is not None])
    med = vals[len(vals)//2] if vals else None
    sources = sorted({r.get('source') for r in rows if r.get('source')})
    leave=[]
    for s in sources:
        vv = sorted([float(r['a_m_s2']) for r in rows if r.get('source') != s and _v30_float(r.get('a_m_s2')) is not None])
        leave.append({'held_out': s, 'n_remaining': len(vv), 'median_above_local': bool(vv and vv[len(vv)//2] > local_a0)})
    artifact = {'schema': ['source','object_id','z','vrot_km_s','radius_kpc','a_m_s2','unit_provenance'], 'n_rows': len(rows), 'n_sources': len(sources), 'sources': sources, 'rows': rows[:50000], 'scanned_files': scanned[:500], 'table_stats': stats[:300], 'rejected_examples': rejected[:300]}
    out = outputs / 'p36_highz_object_acceleration_rows_v30.json'
    _v30_write_json(out, artifact)
    base['highz_source_specific_object_scan_v30'] = {'path': str(out), 'n_rows': len(rows), 'n_sources': len(sources), 'median_a_m_s2': med, 'n_scanned_files': len(scanned), 'sources': sources}
    base['highz_objectlevel_confirm_gate_v30'] = _v30_gate(object_rows_ge_30=len(rows) >= 30, two_sources=len(sources) >= 2, units_visible=bool(rows and all(r.get('unit_provenance') for r in rows[:min(30, len(rows))])), median_above_local=bool(med is not None and med > local_a0), leave_one_source_stable=bool(leave and all(x['median_above_local'] for x in leave)))
    base['highz_objectlevel_confirm_gate_v30']['leave_one_source'] = leave
    if base['highz_objectlevel_confirm_gate_v30']['eligible_for_confirm_like']:
        base['status'] = 'highz_a0_objectlevel_publication_confirm_like'
    return base


# P41 v30: lightweight likelihood fitter/consumer for q2/value/error rows.
def _v30_recursive_rows(obj, out=None):
    if out is None: out=[]
    if isinstance(obj, list):
        for x in obj: _v30_recursive_rows(x, out)
    elif isinstance(obj, dict):
        if any(str(k).lower() in ['q2','q2_low','q2_min','q2max','q2_high'] for k in obj.keys()):
            out.append(obj)
        for v in obj.values():
            if isinstance(v, (dict, list)): _v30_recursive_rows(v, out)
    return out


def _v30_p41_extract_numeric_rows_from_json(path):
    obj = _v30_read_json(path)
    if obj is None: return []
    raw = _v30_recursive_rows(obj)
    rows=[]
    for r in raw:
        keys = {str(k).lower(): k for k in r.keys()}
        qk = next((keys[k] for k in keys if k in ['q2','q2_low','q2_min','q2max','q2_high']), None)
        vk = next((keys[k] for k in keys if k in ['value','val','measurement','central','central_value','obs']), None)
        ek = next((keys[k] for k in keys if k in ['error','err','sigma','uncertainty','total_error']), None)
        if not (qk and vk and ek): continue
        q = _v30_float(r.get(qk)); val = _v30_float(r.get(vk)); err = _v30_float(r.get(ek))
        if q is None or val is None or err is None or err <= 0: continue
        obs = str(r.get('observable') or r.get('name') or r.get('obs') or '')
        cp = bool(_re_v30.search(r'\bA[_A-Za-z]*CP|CP[-_ ]?asym', obs, _re_v30.I))
        rows.append({'q2': q, 'value': val, 'error': err, 'observable': obs, 'cp_control': cp, 'source_file': str(path)})
    return rows


def _v30_p41_fit_rows(rows):
    # Simple one-parameter shift model: SM predicts 0 residual, Wilson-like model fits weighted mean shift.
    vals=[]; cps=[]
    for r in rows:
        val=_v30_float(r.get('value')); err=_v30_float(r.get('error'))
        if val is None or err is None or err <= 0: continue
        vals.append((val, err, bool(r.get('cp_control'))))
        if r.get('cp_control'): cps.append((val, err))
    if len(vals) < 10:
        return {'likelihood_present': False, 'reason': 'too few numeric rows', 'n_rows': len(vals)}
    wsum=sum(1/(e*e) for v,e,c in vals)
    shift=sum(v/(e*e) for v,e,c in vals)/wsum if wsum else 0.0
    chi2_sm=sum((v/e)**2 for v,e,c in vals)
    chi2_w=sum(((v-shift)/e)**2 for v,e,c in vals)
    cp_weak=True
    if cps:
        cp_chi=sum((v/e)**2 for v,e in cps)
        cp_weak = cp_chi <= max(4.0, 2.0*len(cps))
    return {'likelihood_present': True, 'n_rows': len(vals), 'n_cp_rows': len(cps), 'best_wilson_shift_proxy': shift, 'chi2_sm': chi2_sm, 'chi2_wilson_proxy': chi2_w, 'delta_chi2_sm_minus_wilson': chi2_sm-chi2_w, 'cp_controls_null_or_weak': bool(cp_weak)}


def run_p41_structured_cp_v30(meta, args):
    base = _run_p41_v29_for_v30(meta, args)
    outputs=_v30_outputs_dir(); cache=_v30_cache_dir(args)
    rows=[]; candidates=[]
    for root in [outputs, cache]:
        if root.exists():
            for p in root.rglob('*.json'):
                s=str(p).lower()
                if any(k in s for k in ['p41','lhcb','bsll','q2','wilson']):
                    candidates.append(str(p)); rows += _v30_p41_extract_numeric_rows_from_json(p)
    fit = _v30_p41_fit_rows(rows)
    fit['candidate_files'] = candidates[:100]
    fit['n_extracted_numeric_rows'] = len(rows)
    fit['rows_sample'] = rows[:50]
    out=outputs/'p41_wilson_sm_likelihood_v30.json'
    _v30_write_json(out, fit)
    delta=_v30_float(fit.get('delta_chi2_sm_minus_wilson'))
    base['p41_wilson_sm_likelihood_v30']={'path': str(out), **{k:v for k,v in fit.items() if k != 'rows_sample'}}
    cp_rows=int(fit.get('n_cp_rows') or 0)
    base['p41_major_claim_gate_v30']=_v30_gate(q2_numeric_rows=len(rows)>=20, cp_control_rows=cp_rows>=3, likelihood_values=bool(fit.get('likelihood_present')), wilson_sm_delta_chi2=bool(delta is not None and delta>=4.0), cp_controls_null_or_weak=bool(fit.get('cp_controls_null_or_weak')))
    if base['p41_major_claim_gate_v30']['eligible_for_confirm_like']:
        base['status']='p41_wilson_likelihood_confirm_like'
    return base


# P33 v30: accept measured alpha products and compute gate; no fake measurement from compressed BAO alone.
def run_p33_density_bao_measured_scaffold_v30(meta, args):
    base = _run_p33_v29_for_v30(meta, args)
    outputs=_v30_outputs_dir(); cache=_v30_cache_dir(args)
    candidates=[]; accepted=None
    for root in [outputs, cache]:
        if root.exists():
            for p in root.rglob('*.json'):
                s=str(p).lower()
                if ('p33' in s or 'density' in s) and ('alpha' in s or 'bao' in s):
                    candidates.append(str(p))
    for p in candidates:
        obj=_v30_read_json(p)
        if isinstance(obj,dict) and _v30_float(obj.get('alpha_high_density')) is not None and _v30_float(obj.get('alpha_low_density')) is not None:
            accepted=obj; accepted['_source_file']=p; break
    delta=None
    if accepted:
        delta=_v30_float(accepted.get('delta_alpha_high_minus_low'))
        if delta is None:
            delta=_v30_float(accepted.get('alpha_high_density')) - _v30_float(accepted.get('alpha_low_density'))
    result={'measurement_present':bool(accepted), 'accepted':accepted, 'candidate_files':candidates[:100], 'delta_alpha_high_minus_low': delta, 'required_run_contract': ['alpha_high_density','alpha_low_density','covariance_method','density_label_shuffle_p','sky_shuffle_p','redshift_jackknife_stable']}
    _v30_write_json(outputs/'p33_density_split_alpha_result_v30.json', result)
    base['p33_density_split_alpha_result_v30']=result
    base['p33_publication_confirm_gate_v30']=_v30_gate(alpha_high_low_measured=bool(accepted), covariance_ready=bool(accepted and accepted.get('covariance_method')), density_label_shuffle_pass=bool(accepted and (_v30_float(accepted.get('density_label_shuffle_p')) or 1) <= 0.05), sky_shuffle_pass=bool(accepted and (_v30_float(accepted.get('sky_shuffle_p')) or 1) <= 0.05), redshift_jackknife_stable=bool(accepted and accepted.get('redshift_jackknife_stable')), delta_alpha_nonzero=bool(delta is not None and abs(delta)>0))
    if base['p33_publication_confirm_gate_v30']['eligible_for_confirm_like']:
        base['status']='p33_density_bao_alpha_confirm_like'
    return base


# P32 v30: minimal strain-run product gate/manifest.
def run_ringdown_strain_plan_v30(meta, args):
    base = _run_ringdown_v29_for_v30(meta, args)
    outputs=_v30_outputs_dir(); cache=_v30_cache_dir(args)
    files=[]; fits=[]
    for root in [outputs, cache]:
        if root.exists():
            for p in root.rglob('*'):
                s=str(p).lower()
                if p.is_file() and any(k in s for k in ['gw150914','gw190521','gwosc','ringdown','strain']):
                    files.append(str(p))
                if p.is_file() and p.suffix.lower()=='.json' and 'ringdown' in s and ('fit' in s or 'residual' in s):
                    fits.append(str(p))
    accepted_fit=None
    for p in fits:
        obj=_v30_read_json(p)
        if isinstance(obj,dict) and any(k in obj for k in ['delta_chi2_gr_minus_ccdr','injection_null_p','detector_split_pass','leave_one_event_out_pass']):
            accepted_fit=obj; accepted_fit['_source_file']=p; break
    manifest={'minimal_events':['GW150914','GW190521'], 'found_candidate_files':files[:150], 'fit_jsons':fits[:80], 'accepted_fit':accepted_fit, 'minimal_run_required_outputs':['event_id','detectors','psd_method','gr_ringdown_chi2','ccdr_residual_chi2','delta_chi2_gr_minus_ccdr','injection_null_p','detector_split_pass','leave_one_event_out_pass']}
    _v30_write_json(outputs/'p32_minimal_strain_run_manifest_v30.json', manifest)
    delta=_v30_float((accepted_fit or {}).get('delta_chi2_gr_minus_ccdr'))
    base['ringdown_minimal_strain_run_manifest_v30']=manifest
    base['ringdown_strain_confirm_gate_v30']=_v30_gate(strain_downloaded=any(f.lower().endswith(('.hdf5','.h5','.gwf')) for f in files), psd_estimated=bool(accepted_fit and accepted_fit.get('psd_method')), gr_ringdown_fit=bool(accepted_fit and accepted_fit.get('gr_ringdown_chi2') is not None), ccdr_residual_template_fit=bool(accepted_fit and accepted_fit.get('ccdr_residual_chi2') is not None), residual_improves_gr=bool(delta is not None and delta > 0), injection_nulls=bool(accepted_fit and (_v30_float(accepted_fit.get('injection_null_p')) or 1) <= 0.05), detector_split=bool(accepted_fit and accepted_fit.get('detector_split_pass')), leave_one_event_out=bool(accepted_fit and accepted_fit.get('leave_one_event_out_pass')))
    if base['ringdown_strain_confirm_gate_v30']['eligible_for_confirm_like']:
        base['status']='ringdown_strain_residual_confirm_like'
    return base


def run_dashboard_v30(meta, args):
    base = _run_dashboard_v29_for_v30(meta, args)
    rows=[]; out=_v30_outputs_dir()
    for p in sorted(out.glob('test*.json')):
        obj=_v30_read_json(p)
        if isinstance(obj,dict): rows.append(obj)
    instr=[]; blocked=[]; near=[]; pub=[]
    for r in rows:
        keys=[k for k in r if k.endswith('_v30') or '_v30_' in k]
        if keys:
            instr.append({'test_id':r.get('test_id'), 'prediction_id':r.get('prediction_id'), 'status':r.get('status'), 'v30_keys':sorted(keys)})
        if (r.get('p30_sdss_near_confirm_bucket_v30') or {}).get('near_confirm_candidate'):
            near.append({'test_id':r.get('test_id'), 'prediction_id':r.get('prediction_id'), 'bucket':r.get('p30_sdss_near_confirm_bucket_v30'), 'gate':r.get('p30_sdss_route_confirm_gate_v30')})
        st=str(r.get('status',''))
        if 'publication_confirm_like' in st or st in ['robust_confirm_like','void_morphology_publication_grade_confirm_like','p30_sdss_route_confirm_like']:
            pub.append({'test_id':r.get('test_id'), 'prediction_id':r.get('prediction_id'), 'status':st})
        for k,v in r.items():
            if isinstance(v,dict) and k.endswith('_gate_v30') and not v.get('eligible_for_confirm_like', True):
                blocked.append({'test_id':r.get('test_id'), 'prediction_id':r.get('prediction_id'), 'gate':k, 'missing':v.get('missing')})
    base['dashboard_v30']={'n_v30_instrumented_tests':len(instr), 'v30_instrumented_tests':instr[:200], 'publication_grade_confirm_like':pub, 'p30_near_confirm_candidates':near, 'blocked_confirm_gates':blocked[:200], 'claim_policy':'v30 adds quantitative curl ratio/percentile diagnostics, SDSS bootstrap CI, route near-confirm bucket, and strict P36/P41/P33/P32 measurement gates.'}
    base['status']='dashboard_positive_summary'
    return base


RUNNERS.update({
    'p30_maskrandom_freeze_v22': run_p30_maskrandom_freeze_v30,
    'highz_unit_field_table_v22': run_highz_unit_field_table_v30,
    'p41_structured_cp_v22': run_p41_structured_cp_v30,
    'p33_density_bao_measured_scaffold_v22': run_p33_density_bao_measured_scaffold_v30,
    'ringdown_strain_plan_v22': run_ringdown_strain_plan_v30,
    'dashboard_v22': run_dashboard_v30,
})


# -----------------------------------------------------------------------------
# Round 10 v31 confirm-target patch
# Focus: fix v30 P30 curl diagnostics population (variant_results vs variants),
# add stricter route-confirm logic, preserve/use bootstrap CI, and strengthen
# P36/P41/P33/P32 execution consumers without over-promoting proxy evidence.
from pathlib import Path as _Path_v31
import json as _json_v31
import math as _math_v31
import csv as _csv_v31
import re as _re_v31

_run_p30_v30_for_v31 = run_p30_maskrandom_freeze_v30
_run_highz_v30_for_v31 = run_highz_unit_field_table_v30
_run_p41_v30_for_v31 = run_p41_structured_cp_v30
_run_p33_v30_for_v31 = run_p33_density_bao_measured_scaffold_v30
_run_ringdown_v30_for_v31 = run_ringdown_strain_plan_v30
_run_dashboard_v30_for_v31 = run_dashboard_v30


def _v31_float(x):
    try:
        if x is None or x == '':
            return None
        v = float(x)
        return v if _math_v31.isfinite(v) else None
    except Exception:
        return None


def _v31_outputs_dir():
    p = _Path_v31.cwd() / 'outputs'
    p.mkdir(parents=True, exist_ok=True)
    return p


def _v31_cache_dir(args):
    return _Path_v31(getattr(args, 'cache_dir', '.ccdr_round10_cache'))


def _v31_write_json(path, obj):
    path = _Path_v31(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(_json_v31.dumps(obj, indent=2, sort_keys=True, ensure_ascii=False, default=json_default), encoding='utf-8')
    return str(path)


def _v31_read_json(path):
    try:
        return _json_v31.loads(_Path_v31(path).read_text(encoding='utf-8'))
    except Exception:
        return None


def _v31_gate(**items):
    missing = [k for k, v in items.items() if not bool(v)]
    out = dict(items)
    out['eligible_for_confirm_like'] = not missing
    out['missing'] = missing
    return out


def _v31_variant_results_from_same_artifact(base, outputs):
    same_ref = base.get('p30_sdss_same_split_variant_rerun_v29') or {}
    same_path = same_ref.get('path') or str(outputs / 'p30_sdss_same_split_variant_rerun_v29.json')
    same_obj = _v31_read_json(same_path) or same_ref or {}
    # v29 wrote "variant_results". v30 accidentally looked for "variants" only.
    variants = same_obj.get('variant_results') or same_obj.get('variants') or same_ref.get('variant_results') or same_ref.get('variants') or []
    return same_obj, variants, same_path


def _v31_compute_curl_diagnostics(same_obj, variants):
    sci = [v for v in (variants or []) if isinstance(v, dict) and v.get('available') and v.get('variant') != 'curl_control']
    curl = next((v for v in (variants or []) if isinstance(v, dict) and v.get('variant') == 'curl_control'), None)
    sci_abs = [abs(_v31_float(v.get('delta_high_minus_low')) or 0.0) for v in sci]
    median_abs_science = None
    if sci_abs:
        ss = sorted(sci_abs)
        # true median for even/odd lists
        mid = len(ss)//2
        median_abs_science = ss[mid] if len(ss) % 2 else 0.5*(ss[mid-1] + ss[mid])
    # Fallback to summary values written by v29 if variants were omitted.
    if median_abs_science is None:
        median_abs_science = _v31_float(same_obj.get('median_abs_science_delta'))
    curl_delta = _v31_float((curl or {}).get('delta_high_minus_low')) if curl else None
    if curl_delta is None:
        ac = _v31_float(same_obj.get('abs_curl_delta'))
        curl_delta = ac if ac is not None else None
    curl_abs = abs(curl_delta) if curl_delta is not None else None
    curl_p = _v31_float((curl or {}).get('density_shuffle_p_high')) if curl else None
    curl_ratio = (curl_abs / median_abs_science) if (curl_abs is not None and median_abs_science and median_abs_science > 0) else None
    threshold = 0.60
    # Non-significant in either tail. If p is absent, do not pass the final gate.
    curl_non_sig = bool(curl_p is not None and curl_p > 0.05 and curl_p < 0.95)
    curl_weaker = bool(curl_ratio is not None and curl_ratio < threshold)
    curl_sign = None
    if curl_delta is not None and sci:
        pos = sum(1 for v in sci if (_v31_float(v.get('delta_high_minus_low')) or 0.0) > 0)
        neg = sum(1 for v in sci if (_v31_float(v.get('delta_high_minus_low')) or 0.0) < 0)
        sci_majority = 1 if pos >= neg else -1
        curl_sign = 'same_as_science_majority' if (curl_delta > 0) == (sci_majority > 0) else 'opposite_to_science_majority'
    return {
        'source_artifact_schema': 'variant_results_or_variants',
        'variant_count': len(variants or []),
        'science_variant_count': len(sci),
        'curl_available': bool(curl and curl.get('available')) or curl_delta is not None,
        'curl_delta': curl_delta,
        'curl_abs_delta': curl_abs,
        'median_abs_science_delta': median_abs_science,
        'curl_to_science_abs_ratio': curl_ratio,
        'threshold_ratio': threshold,
        'curl_density_shuffle_p_high': curl_p,
        'curl_non_significant': curl_non_sig,
        'curl_weaker_by_ratio': curl_weaker,
        'curl_sign_relation': curl_sign,
        'pass_rule': 'curl_abs_delta / median_abs_science_delta < 0.60 AND 0.05 < curl_density_shuffle_p_high < 0.95 under the same SDSS random-normalized split',
        'curl_control_pass_v31': bool(curl_weaker and curl_non_sig),
    }


def run_p30_maskrandom_freeze_v31(meta, args):
    base = _run_p30_v30_for_v31(meta, args)
    outputs = _v31_outputs_dir()
    same_obj, variants, same_path = _v31_variant_results_from_same_artifact(base, outputs)
    curl_diag = _v31_compute_curl_diagnostics(same_obj, variants)
    curl_diag['same_split_artifact_path'] = str(same_path)
    _v31_write_json(outputs / 'p30_curl_diagnostics_v31.json', curl_diag)
    base['p30_curl_diagnostics_v31'] = curl_diag

    # Preserve existing bootstrap if v30 already computed one; otherwise expose a product-needed gate.
    boot_path = outputs / 'p30_sdss_bootstrap_ci_v30.json'
    boot = _v31_read_json(boot_path) or base.get('p30_sdss_bootstrap_ci_v30') or {}
    boot_ok = bool(boot.get('available') and boot.get('ci_excludes_zero_positive'))
    # If v30 has a positive route but no bootstrap because this was not --allow-large, report pending rather than pass.
    base['p30_sdss_bootstrap_ci_gate_v31'] = {
        'bootstrap_available': bool(boot.get('available')),
        'ci_excludes_zero_positive': boot_ok,
        'effect_sigma': boot.get('effect_sigma'),
        'ci16': boot.get('ci16'),
        'ci84': boot.get('ci84'),
        'required_for_route_confirm': True,
        'path': str(boot_path) if boot_path.exists() else None,
    }

    # Route gate: use the strongest available v29/v30 route signals.
    g29 = base.get('p30_sdss_route_confirm_gate_v29') or {}
    near30 = base.get('p30_sdss_near_confirm_bucket_v30') or {}
    same_split = bool(g29.get('same_split_science_variants') or near30.get('same_split_science_variants') or same_obj.get('same_split_science_variants_pass'))
    random_route = bool(g29.get('random_normalized_route') or near30.get('random_normalized_route') or (base.get('p30_publication_confirm_gate_v28') or {}).get('p30_sdss_random_normalized_route'))
    jackknife = bool(g29.get('jackknife_stable') or near30.get('jackknife_stable'))
    # If bootstrap product exists and is positive, use it; if not available, keep near-confirm only.
    curl_pass = bool(curl_diag.get('curl_control_pass_v31'))
    base['p30_sdss_near_confirm_bucket_v31'] = {
        'near_confirm_candidate': bool(random_route and same_split and jackknife),
        'claim_label': 'P30-SDSS_route_near_confirm_candidate' if bool(random_route and same_split and jackknife) else 'P30-SDSS_route_diagnostic',
        'random_normalized_route': random_route,
        'same_split_science_variants': same_split,
        'jackknife_stable': jackknife,
        'curl_control_pass_v31': curl_pass,
        'bootstrap_ci_positive': boot_ok,
        'note': 'v31 fixes curl diagnostic population from v29 variant_results; final route confirm requires curl and bootstrap gates.'
    }
    base['p30_sdss_route_confirm_gate_v31'] = _v31_gate(
        random_normalized_route=random_route,
        same_split_science_variants=same_split,
        jackknife_stable=jackknife,
        curl_control_quantitative_pass=curl_pass,
        bootstrap_ci_positive=boot_ok,
    )
    if base['p30_sdss_route_confirm_gate_v31']['eligible_for_confirm_like']:
        base['status'] = 'p30_sdss_route_confirm_like'
    elif base['p30_sdss_near_confirm_bucket_v31']['near_confirm_candidate']:
        base['status'] = 'density_kappa_sdss_route_near_confirm_candidate'
    base['p30_global_confirm_gate_v31'] = _v31_gate(
        sdss_route_confirm=base['p30_sdss_route_confirm_gate_v31']['eligible_for_confirm_like'],
        second_independent_route=False,
    )
    base['p30_euclid_quarantine_or_repair_v31'] = {
        'quarantined_from_global_claim': True,
        'reason': 'Euclid route is negative/mixed until photo-z/depth/quality cuts and field-level randoms pass.',
        'required_to_rejoin_global_p30': ['photo_z_or_redshift_column', 'depth_or_quality_split', 'field_level_randoms', 'same_mask_as_sdss', 'random_normalized_positive_delta', 'jackknife_stable'],
    }
    return base


# v31 P36: stronger object-table consumer. It can also consume a user-provided CSV/JSON product
# named p36_highz_object_acceleration_rows*.json/csv and will not count image maps or sigma-only products.
def _v31_rows_from_csv_like(path, max_rows=100000):
    rows=[]
    try:
        txt = _Path_v31(path).read_text(encoding='utf-8', errors='ignore')
        sample = txt[:4096]
        dialect = _csv_v31.Sniffer().sniff(sample, delimiters=',\t;| ')
        rdr = _csv_v31.DictReader(txt.splitlines(), dialect=dialect)
        for i,row in enumerate(rdr):
            if i >= max_rows: break
            rows.append(row)
    except Exception:
        try:
            with open(path, newline='', encoding='utf-8', errors='ignore') as f:
                for i,row in enumerate(_csv_v31.DictReader(f)):
                    if i >= max_rows: break
                    rows.append(row)
        except Exception:
            pass
    return rows


def _v31_consume_object_accel_product(path):
    p = _Path_v31(path)
    obj = _v31_read_json(p) if p.suffix.lower() == '.json' else None
    if isinstance(obj, dict):
        rows = obj.get('rows') or obj.get('object_rows') or obj.get('data') or []
    elif isinstance(obj, list):
        rows = obj
    else:
        rows = _v31_rows_from_csv_like(p)
    out=[]
    for r in rows or []:
        if not isinstance(r, dict):
            continue
        source = r.get('source') or r.get('survey') or r.get('catalogue')
        oid = r.get('object_id') or r.get('id') or r.get('ID') or r.get('name')
        z = _v31_float(r.get('z') or r.get('redshift') or r.get('zspec'))
        v = _v31_float(r.get('vrot_km_s') or r.get('vrot') or r.get('v_rot') or r.get('vcirc') or r.get('vmax'))
        rad = _v31_float(r.get('radius_kpc') or r.get('r_kpc') or r.get('re_kpc') or r.get('r_e'))
        a = _v31_float(r.get('a_m_s2'))
        if a is None and v is not None and rad is not None and rad > 0:
            a = (abs(v)*1000.0)**2 / (rad * 3.085677581491367e19)
        if source and z is not None and v is not None and rad is not None and a is not None and 10 <= abs(v) <= 800 and 0 < rad < 100 and 0 <= z <= 5:
            out.append({'source': str(source), 'object_id': str(oid) if oid is not None else None, 'z': z, 'vrot_km_s': abs(v), 'radius_kpc': rad, 'a_m_s2': a, 'unit_provenance': str(r.get('unit_provenance') or 'v31 consumed object-level product')})
    return out


def run_highz_unit_field_table_v31(meta, args):
    base = _run_highz_v30_for_v31(meta, args)
    outputs = _v31_outputs_dir(); cache = _v31_cache_dir(args)
    rows=[]; products=[]
    # Consume existing v30 output first.
    for p in [outputs/'p36_highz_object_acceleration_rows_v30.json', outputs/'p36_highz_object_acceleration_rows_v31.json']:
        if p.exists():
            got = _v31_consume_object_accel_product(p); rows += got; products.append(str(p))
    # Also consume explicitly named source-specific products if the user drops them into cache/outputs.
    for root in [outputs, cache]:
        if root.exists():
            for p in root.rglob('*'):
                s=str(p).lower()
                if p.is_file() and ('p36' in s or 'highz' in s or any(k in s for k in ['kmos','kges','kross','mosdef','sami'])) and ('object' in s or 'vrot' in s or 'acceleration' in s) and p.suffix.lower() in ['.json','.csv','.tsv','.txt']:
                    got = _v31_consume_object_accel_product(p)
                    if got:
                        rows += got; products.append(str(p))
    # Deduplicate.
    seen=set(); uniq=[]
    for r in rows:
        try:
            k=(r.get('source'), r.get('object_id'), round(float(r.get('z',0)),5), round(float(r.get('vrot_km_s',0)),3), round(float(r.get('radius_kpc',0)),4))
            if k not in seen:
                seen.add(k); uniq.append(r)
        except Exception:
            pass
    rows=uniq
    sources=sorted({r.get('source') for r in rows if r.get('source')})
    vals=sorted([float(r['a_m_s2']) for r in rows if _v31_float(r.get('a_m_s2')) is not None])
    med=vals[len(vals)//2] if vals else None
    local_a0=9.55e-11
    leave=[]
    for s in sources:
        vv=sorted([float(r['a_m_s2']) for r in rows if r.get('source') != s and _v31_float(r.get('a_m_s2')) is not None])
        leave.append({'held_out':s, 'n_remaining':len(vv), 'median_above_local': bool(vv and vv[len(vv)//2] > local_a0)})
    artifact={'schema':['source','object_id','z','vrot_km_s','radius_kpc','a_m_s2','unit_provenance'], 'n_rows':len(rows), 'n_sources':len(sources), 'sources':sources, 'median_a_m_s2':med, 'input_products':products[:100], 'rows':rows[:100000]}
    out=outputs/'p36_highz_object_acceleration_rows_v31.json'
    _v31_write_json(out, artifact)
    gate=_v31_gate(object_rows_ge_30=len(rows)>=30, two_sources=len(sources)>=2, units_visible=bool(rows and all(r.get('unit_provenance') for r in rows[:min(30,len(rows))])), median_above_local=bool(med is not None and med > local_a0), leave_one_source_stable=bool(leave and all(x['median_above_local'] for x in leave)))
    gate['leave_one_source']=leave
    base['highz_source_specific_object_scan_v31']={'path':str(out), 'n_rows':len(rows), 'n_sources':len(sources), 'sources':sources, 'median_a_m_s2':med, 'input_products':products[:20]}
    base['highz_objectlevel_confirm_gate_v31']=gate
    if gate['eligible_for_confirm_like']:
        base['status']='highz_a0_objectlevel_publication_confirm_like'
    return base


# v31 P41: consume JSON/CSV q2 tables and compute a conservative Wilson/SM proxy.
def _v31_extract_p41_rows_from_file(path):
    rows=[]; p=_Path_v31(path)
    if p.suffix.lower() == '.json':
        rows = _v30_p41_extract_numeric_rows_from_json(p) if '_v30_p41_extract_numeric_rows_from_json' in globals() else []
    elif p.suffix.lower() in ['.csv','.tsv','.txt']:
        for r in _v31_rows_from_csv_like(p):
            keys={str(k).lower():k for k in r.keys()}
            qk=next((keys[k] for k in keys if k in ['q2','q2_low','q2_min','q2max','q2_high','q2bin']), None)
            vk=next((keys[k] for k in keys if k in ['value','val','measurement','central','central_value','obs','observable_value']), None)
            ek=next((keys[k] for k in keys if k in ['error','err','sigma','uncertainty','total_error','stat_syst_error']), None)
            if qk and vk and ek:
                q=_v31_float(r.get(qk)); v=_v31_float(r.get(vk)); e=_v31_float(r.get(ek))
                if q is not None and v is not None and e is not None and e>0:
                    obs=str(r.get('observable') or r.get('name') or r.get('obs') or '')
                    cp=bool(_re_v31.search(r'\bA[_A-Za-z]*CP|CP[-_ ]?asym', obs, _re_v31.I))
                    rows.append({'q2':q,'value':v,'error':e,'observable':obs,'cp_control':cp,'source_file':str(p)})
    return rows


def run_p41_structured_cp_v31(meta, args):
    base=_run_p41_v30_for_v31(meta,args)
    outputs=_v31_outputs_dir(); cache=_v31_cache_dir(args)
    rows=[]; files=[]
    for root in [outputs, cache]:
        if root.exists():
            for p in root.rglob('*'):
                s=str(p).lower()
                if p.is_file() and p.suffix.lower() in ['.json','.csv','.tsv','.txt'] and any(k in s for k in ['p41','lhcb','bsll','q2','wilson']):
                    got=_v31_extract_p41_rows_from_file(p)
                    if got:
                        rows += got; files.append(str(p))
    fit=_v30_p41_fit_rows(rows) if '_v30_p41_fit_rows' in globals() else {'likelihood_present':False,'reason':'v30 fitter missing'}
    fit['n_extracted_numeric_rows']=len(rows); fit['candidate_files']=files[:120]; fit['rows_sample']=rows[:80]
    out=outputs/'p41_wilson_sm_likelihood_v31.json'; _v31_write_json(out, fit)
    delta=_v31_float(fit.get('delta_chi2_sm_minus_wilson'))
    cp_rows=int(fit.get('n_cp_rows') or 0)
    base['p41_wilson_sm_likelihood_v31']={'path':str(out), **{k:v for k,v in fit.items() if k!='rows_sample'}}
    base['p41_major_claim_gate_v31']=_v31_gate(q2_numeric_rows=len(rows)>=20, cp_control_rows=cp_rows>=3, likelihood_values=bool(fit.get('likelihood_present')), wilson_sm_delta_chi2=bool(delta is not None and delta>=4.0), cp_controls_null_or_weak=bool(fit.get('cp_controls_null_or_weak')))
    if base['p41_major_claim_gate_v31']['eligible_for_confirm_like']:
        base['status']='p41_wilson_likelihood_confirm_like'
    return base


# v31 P33: consume alpha products in JSON/CSV; no fake promotion from compressed BAO vectors.
def _v31_consume_alpha_file(path):
    p=_Path_v31(path)
    objs=[]
    if p.suffix.lower()=='.json':
        obj=_v31_read_json(p)
        if isinstance(obj, dict): objs=[obj]
        elif isinstance(obj, list): objs=[x for x in obj if isinstance(x,dict)]
    elif p.suffix.lower() in ['.csv','.tsv','.txt']:
        objs=_v31_rows_from_csv_like(p)
    for obj in objs:
        ah=_v31_float(obj.get('alpha_high_density') or obj.get('alpha_high') or obj.get('alpha_hi'))
        al=_v31_float(obj.get('alpha_low_density') or obj.get('alpha_low') or obj.get('alpha_lo'))
        if ah is not None and al is not None:
            out=dict(obj); out['alpha_high_density']=ah; out['alpha_low_density']=al
            out['delta_alpha_high_minus_low']=_v31_float(out.get('delta_alpha_high_minus_low'))
            if out['delta_alpha_high_minus_low'] is None: out['delta_alpha_high_minus_low']=ah-al
            out['_source_file']=str(p)
            return out
    return None


def run_p33_density_bao_measured_scaffold_v31(meta,args):
    base=_run_p33_v30_for_v31(meta,args)
    outputs=_v31_outputs_dir(); cache=_v31_cache_dir(args)
    candidates=[]; accepted=None
    for root in [outputs, cache]:
        if root.exists():
            for p in root.rglob('*'):
                s=str(p).lower()
                if p.is_file() and p.suffix.lower() in ['.json','.csv','.tsv','.txt'] and ('p33' in s or 'bao' in s or 'alpha' in s) and ('density' in s or 'alpha' in s):
                    candidates.append(str(p)); got=_v31_consume_alpha_file(p)
                    if got and accepted is None: accepted=got
    delta=_v31_float((accepted or {}).get('delta_alpha_high_minus_low'))
    result={'measurement_present':bool(accepted), 'accepted':accepted, 'candidate_files':candidates[:150], 'delta_alpha_high_minus_low':delta, 'required_run_contract':['alpha_high_density','alpha_low_density','covariance_method','density_label_shuffle_p','sky_shuffle_p','redshift_jackknife_stable']}
    _v31_write_json(outputs/'p33_density_split_alpha_result_v31.json', result)
    base['p33_density_split_alpha_result_v31']=result
    base['p33_publication_confirm_gate_v31']=_v31_gate(alpha_high_low_measured=bool(accepted), covariance_ready=bool(accepted and accepted.get('covariance_method')), density_label_shuffle_pass=bool(accepted and (_v31_float(accepted.get('density_label_shuffle_p')) or 1) <= 0.05), sky_shuffle_pass=bool(accepted and (_v31_float(accepted.get('sky_shuffle_p')) or 1) <= 0.05), redshift_jackknife_stable=bool(accepted and str(accepted.get('redshift_jackknife_stable')).lower() in ['true','1','yes']), delta_alpha_nonzero=bool(delta is not None and abs(delta)>0))
    if base['p33_publication_confirm_gate_v31']['eligible_for_confirm_like']:
        base['status']='p33_density_bao_alpha_confirm_like'
    return base


# v31 P32: consume minimal strain fit products and make missing steps explicit.
def run_ringdown_strain_plan_v31(meta,args):
    base=_run_ringdown_v30_for_v31(meta,args)
    outputs=_v31_outputs_dir(); cache=_v31_cache_dir(args)
    files=[]; fit_objs=[]
    for root in [outputs, cache]:
        if root.exists():
            for p in root.rglob('*'):
                s=str(p).lower()
                if p.is_file() and any(k in s for k in ['gw150914','gw190521','gwosc','ringdown','strain']): files.append(str(p))
                if p.is_file() and p.suffix.lower()=='.json' and ('ringdown' in s or 'strain' in s or 'gw150914' in s):
                    obj=_v31_read_json(p)
                    if isinstance(obj,dict): fit_objs.append(obj | {'_source_file':str(p)})
    accepted=None
    for obj in fit_objs:
        if any(k in obj for k in ['delta_chi2_gr_minus_ccdr','gr_ringdown_chi2','ccdr_residual_chi2','injection_null_p']):
            accepted=obj; break
    delta=_v31_float((accepted or {}).get('delta_chi2_gr_minus_ccdr'))
    inj=_v31_float((accepted or {}).get('injection_null_p'))
    manifest={'minimal_events':['GW150914','GW190521'], 'found_candidate_files':files[:200], 'fit_json_count':len(fit_objs), 'accepted_fit':accepted, 'missing_if_not_confirmed':['strain .hdf5/.h5/.gwf','PSD estimate','GR ringdown fit','CCDR residual fit','injection null','detector split','leave-one-event-out']}
    _v31_write_json(outputs/'p32_minimal_strain_run_manifest_v31.json', manifest)
    base['ringdown_minimal_strain_run_manifest_v31']=manifest
    base['ringdown_strain_confirm_gate_v31']=_v31_gate(strain_downloaded=any(f.lower().endswith(('.hdf5','.h5','.gwf')) for f in files), psd_estimated=bool(accepted and accepted.get('psd_method')), gr_ringdown_fit=bool(accepted and accepted.get('gr_ringdown_chi2') is not None), ccdr_residual_template_fit=bool(accepted and accepted.get('ccdr_residual_chi2') is not None), residual_improves_gr=bool(delta is not None and delta>0), injection_nulls=bool(inj is not None and inj <= 0.05), detector_split=bool(accepted and accepted.get('detector_split_pass')), leave_one_event_out=bool(accepted and accepted.get('leave_one_event_out_pass')))
    if base['ringdown_strain_confirm_gate_v31']['eligible_for_confirm_like']:
        base['status']='ringdown_strain_residual_confirm_like'
    return base


def run_dashboard_v31(meta,args):
    base=_run_dashboard_v30_for_v31(meta,args)
    outputs=_v31_outputs_dir(); rows=[]
    for p in sorted(outputs.glob('test*.json')):
        obj=_v31_read_json(p)
        if isinstance(obj,dict): rows.append(obj)
    instr=[]; p30_near=[]; route_conf=[]; blocked=[]; pub=[]
    for r in rows:
        keys=[k for k in r if k.endswith('_v31') or '_v31_' in k]
        if keys: instr.append({'test_id':r.get('test_id'), 'prediction_id':r.get('prediction_id'), 'status':r.get('status'), 'v31_keys':sorted(keys)})
        if (r.get('p30_sdss_near_confirm_bucket_v31') or {}).get('near_confirm_candidate'):
            p30_near.append({'test_id':r.get('test_id'), 'bucket':r.get('p30_sdss_near_confirm_bucket_v31'), 'gate':r.get('p30_sdss_route_confirm_gate_v31'), 'curl':r.get('p30_curl_diagnostics_v31')})
        if (r.get('p30_sdss_route_confirm_gate_v31') or {}).get('eligible_for_confirm_like'):
            route_conf.append({'test_id':r.get('test_id'), 'prediction_id':r.get('prediction_id'), 'status':r.get('status')})
        st=str(r.get('status',''))
        if 'publication_confirm_like' in st or st in ['robust_confirm_like','void_morphology_publication_grade_confirm_like','p30_sdss_route_confirm_like']:
            pub.append({'test_id':r.get('test_id'), 'prediction_id':r.get('prediction_id'), 'status':st})
        for k,v in r.items():
            if isinstance(v,dict) and k.endswith('_gate_v31') and not v.get('eligible_for_confirm_like', True):
                blocked.append({'test_id':r.get('test_id'), 'prediction_id':r.get('prediction_id'), 'gate':k, 'missing':v.get('missing')})
    base['dashboard_v31']={'n_v31_instrumented_tests':len(instr), 'v31_instrumented_tests':instr[:200], 'publication_grade_confirm_like':pub, 'p30_sdss_route_confirm_like':route_conf, 'p30_near_confirm_candidates':p30_near, 'blocked_confirm_gates':blocked[:200], 'claim_policy':'v31 fixes P30 curl diagnostic population and keeps route/global confirmation separated; P36/P41/P33/P32 require object/table/measurement/strain products.'}
    base['status']='dashboard_positive_summary'
    return base


RUNNERS.update({
    'p30_maskrandom_freeze_v22': run_p30_maskrandom_freeze_v31,
    'highz_unit_field_table_v22': run_highz_unit_field_table_v31,
    'p41_structured_cp_v22': run_p41_structured_cp_v31,
    'p33_density_bao_measured_scaffold_v22': run_p33_density_bao_measured_scaffold_v31,
    'ringdown_strain_plan_v22': run_ringdown_strain_plan_v31,
    'dashboard_v22': run_dashboard_v31,
})


# -------------------------- Round-10 v32 curl-remediation / confirm-target patch --------------------------
# v32 addresses the v31 report blockers:
# 1) diagnose significant curl, 2) curl permutation/rotation controls, 3) science/curl ratio uncertainty,
# 4) curl-subtracted science diagnostics, 5) split by frequency/systematic family, 6) route-specific promotion
# with curl remediation (still not global P30), 7) P36 object parser manifest, 8) P41 Wilson/SM gate,
# 9) P33 alpha measurement gate, 10) P32 minimal strain gate.
from pathlib import Path as _Path_v32
import json as _json_v32
import math as _math_v32
import csv as _csv_v32
import re as _re_v32

_run_p30_v31_for_v32 = run_p30_maskrandom_freeze_v31
_run_highz_v31_for_v32 = run_highz_unit_field_table_v31
_run_p41_v31_for_v32 = run_p41_structured_cp_v31
_run_p33_v31_for_v32 = run_p33_density_bao_measured_scaffold_v31
_run_ringdown_v31_for_v32 = run_ringdown_strain_plan_v31
_run_dashboard_v31_for_v32 = run_dashboard_v31


def _v32_float(x):
    try:
        if x is None or x == '':
            return None
        v = float(x)
        return v if _math_v32.isfinite(v) else None
    except Exception:
        return None


def _v32_outputs_dir():
    p = _Path_v32.cwd() / 'outputs'
    p.mkdir(parents=True, exist_ok=True)
    return p


def _v32_cache_dir(args):
    return _Path_v32(getattr(args, 'cache_dir', '.ccdr_round10_cache'))


def _v32_write_json(path, obj):
    path = _Path_v32(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(_json_v32.dumps(obj, indent=2, sort_keys=True, ensure_ascii=False, default=json_default), encoding='utf-8')
    return str(path)


def _v32_read_json(path):
    try:
        return _json_v32.loads(_Path_v32(path).read_text(encoding='utf-8'))
    except Exception:
        return None


def _v32_gate(**items):
    missing = [k for k, v in items.items() if not bool(v)]
    out = dict(items)
    out['eligible_for_confirm_like'] = not missing
    out['missing'] = missing
    return out


def _v32_rows_csv(path, max_rows=100000):
    rows=[]
    try:
        txt=_Path_v32(path).read_text(encoding='utf-8', errors='ignore')
        try:
            dialect=_csv_v32.Sniffer().sniff(txt[:4096], delimiters=',\t;| ')
        except Exception:
            dialect='excel'
        for i,row in enumerate(_csv_v32.DictReader(txt.splitlines(), dialect=dialect)):
            if i>=max_rows: break
            rows.append(row)
    except Exception:
        pass
    return rows


def _v32_same_split_artifact(base, outputs):
    ref = base.get('p30_sdss_same_split_variant_rerun_v29') or {}
    path = ref.get('path') or str(outputs / 'p30_sdss_same_split_variant_rerun_v29.json')
    obj = _v32_read_json(path) or ref or {}
    variants = obj.get('variant_results') or obj.get('variants') or ref.get('variant_results') or ref.get('variants') or []
    return obj, variants, path


def _v32_science_and_curl(variants):
    sci=[v for v in (variants or []) if isinstance(v, dict) and v.get('available') and v.get('variant')!='curl_control']
    curl=next((v for v in (variants or []) if isinstance(v, dict) and v.get('available') and v.get('variant')=='curl_control'), None)
    return sci, curl


def _v32_basic_curl_diagnostics(base, same_obj, variants):
    # Start with v31 if present; add robust fallbacks from v29 artifact.
    old = dict(base.get('p30_curl_diagnostics_v31') or {})
    sci, curl = _v32_science_and_curl(variants)
    sci_deltas=[_v32_float(v.get('delta_high_minus_low')) for v in sci]
    sci_deltas=[x for x in sci_deltas if x is not None]
    sci_abs=sorted(abs(x) for x in sci_deltas)
    med = None
    if sci_abs:
        mid=len(sci_abs)//2
        med=sci_abs[mid] if len(sci_abs)%2 else 0.5*(sci_abs[mid-1]+sci_abs[mid])
    if med is None:
        med=_v32_float(same_obj.get('median_abs_science_delta') or old.get('median_abs_science_delta'))
    cd = _v32_float((curl or {}).get('delta_high_minus_low'))
    if cd is None:
        # v29 stored absolute curl only. Preserve sign as unknown if no variant result is present.
        ac=_v32_float(same_obj.get('abs_curl_delta') or old.get('curl_abs_delta'))
        cd=ac if ac is not None else None
    cp = _v32_float((curl or {}).get('density_shuffle_p_high'))
    if cp is None: cp=_v32_float(old.get('curl_density_shuffle_p_high'))
    cabs=abs(cd) if cd is not None else None
    ratio=(cabs/med) if (cabs is not None and med and med>0) else None
    sci_pos=sum(1 for x in sci_deltas if x>0)
    sci_neg=sum(1 for x in sci_deltas if x<0)
    signrel=None
    if cd is not None and sci_deltas:
        maj=1 if sci_pos>=sci_neg else -1
        signrel='same_as_science_majority' if (cd>0)==(maj>0) else 'opposite_to_science_majority'
    return {
        'curl_delta': cd,
        'curl_abs_delta': cabs,
        'median_abs_science_delta': med,
        'curl_to_science_abs_ratio': ratio,
        'curl_density_shuffle_p_high': cp,
        'curl_weaker_by_ratio_0p60': bool(ratio is not None and ratio < 0.60),
        'curl_weaker_by_ratio_0p50': bool(ratio is not None and ratio < 0.50),
        'curl_non_significant_5_95': bool(cp is not None and 0.05 < cp < 0.95),
        'curl_sign_relation': signrel,
        'science_variant_count': len(sci),
        'science_positive_delta_count': sci_pos,
        'science_negative_delta_count': sci_neg,
    }


def _v32_ratio_uncertainty_from_bootstrap(base, curl_delta, median_sci):
    outputs=_v32_outputs_dir()
    boot = _v32_read_json(outputs/'p30_sdss_bootstrap_ci_v30.json') or base.get('p30_sdss_bootstrap_ci_v30') or {}
    cabs = abs(curl_delta) if curl_delta is not None else None
    # This is a conservative product-level CI: curl is held fixed, science uses route bootstrap CI when available.
    if cabs is None or not boot.get('available'):
        return {'available': False, 'reason': 'requires curl_delta and available P30-SDSS bootstrap samples/product', 'bootstrap_path': str(outputs/'p30_sdss_bootstrap_ci_v30.json')}
    ci16=_v32_float(boot.get('ci16')); ci84=_v32_float(boot.get('ci84')); med=_v32_float(boot.get('median')) or _v32_float(boot.get('delta_high_minus_low')) or median_sci
    if not (ci16 and ci84 and med and ci16>0):
        return {'available': False, 'reason': 'bootstrap CI missing or crosses zero', 'bootstrap': boot}
    return {
        'available': True,
        'method': 'curl fixed, science route bootstrap CI from p30_sdss_bootstrap_ci_v30',
        'curl_abs_delta': cabs,
        'science_bootstrap_median': med,
        'science_ci16': ci16,
        'science_ci84': ci84,
        'ratio_at_median': cabs/abs(med),
        'ratio_ci_low_conservative': cabs/abs(ci84),
        'ratio_ci_high_conservative': cabs/abs(ci16),
        'ratio_ci_high_below_0p60': bool((cabs/abs(ci16)) < 0.60),
        'ratio_ci_high_below_0p50': bool((cabs/abs(ci16)) < 0.50),
    }


def _v32_curl_subtracted_diagnostics(sci, curl_delta):
    out=[]
    if curl_delta is None:
        return {'available': False, 'reason': 'missing curl_delta', 'variant_rows': []}
    for v in sci:
        d=_v32_float(v.get('delta_high_minus_low'))
        if d is None: continue
        row={
            'variant': v.get('variant'),
            'science_delta': d,
            'curl_delta': curl_delta,
            'science_minus_curl': d-curl_delta,
            'science_minus_abs_curl': d-abs(curl_delta),
            'remains_positive_after_signed_subtraction': bool((d-curl_delta)>0),
            'remains_positive_after_abs_subtraction': bool((d-abs(curl_delta))>0),
            'density_shuffle_p_high': v.get('density_shuffle_p_high'),
            'jackknife_same_sign': v.get('jackknife_same_sign'),
        }
        out.append(row)
    return {
        'available': bool(out),
        'n_variants': len(out),
        'n_positive_after_signed_subtraction': sum(1 for r in out if r['remains_positive_after_signed_subtraction']),
        'n_positive_after_abs_subtraction': sum(1 for r in out if r['remains_positive_after_abs_subtraction']),
        'variant_rows': out,
        'pass_suggestive_not_confirmatory': bool(out and sum(1 for r in out if r['remains_positive_after_abs_subtraction']) >= 2),
        'claim_note': 'curl-subtraction is diagnostic only; it cannot by itself create a confirmation.',
    }


def _v32_frequency_systematic_split(sci, curl_delta):
    families={
        'frequency': ['f090','f150'],
        'temperature_or_baseline': ['baseline','tonly'],
        'foreground_deprojection': ['cibdeproj'],
    }
    rows=[]
    byname={v.get('variant'): v for v in sci}
    for fam,names in families.items():
        vals=[]; pos=[]; passp=[]
        for n in names:
            d=_v32_float((byname.get(n) or {}).get('delta_high_minus_low'))
            if d is not None:
                vals.append(d); pos.append(d>0)
                passp.append(bool((byname.get(n) or {}).get('positive_pass')))
        if vals:
            rows.append({
                'family': fam,
                'variants': names,
                'n_available': len(vals),
                'mean_delta': sum(vals)/len(vals),
                'all_positive_delta': all(pos),
                'n_positive_pass': sum(1 for x in passp if x),
                'mean_delta_minus_curl': (sum(vals)/len(vals)-curl_delta) if curl_delta is not None else None,
            })
    return {
        'available': bool(rows),
        'families': rows,
        'n_families_positive': sum(1 for r in rows if r.get('all_positive_delta')),
        'interpretation': 'Checks whether signal is broad across frequency/systematic families or concentrated in one map family.',
    }


def _v32_try_heavy_curl_controls(meta, args, split_obj):
    # Optional heavy remediation: if --allow-large is present, recompute curl controls with shuffled labels and sky rotations.
    if not getattr(args, 'allow_large', False) or getattr(args, 'quick', False):
        return {'available': False, 'reason': 'rerun P30 with --allow-large to compute curl permutation/rotation controls'}
    try:
        import numpy as np
        import healpy as hp
    except Exception as e:
        return {'available': False, 'reason': 'numpy/healpy unavailable: '+str(e)}
    try:
        coords, coord_src = _v29_get_sdss_coords(meta, args)
        rand_path = _v29_cache_dir(args) / 'p30_sdss_random_catalogue_v28.csv'
        rand = _v28_coord_rows_from_dicts(_v28_safe_rows_from_csv(rand_path)) if rand_path.exists() else []
        split = _v29_build_random_normalized_split(coords, rand, density_nside=64)
        if not split.get('available'):
            return {'available': False, 'reason': 'random-normalized split unavailable'}
        kmap, info = _v29_variant_map(meta, args, 'curl_control')
        if kmap is None:
            return {'available': False, 'reason': 'curl map unavailable', 'info': info}
        arr=np.asarray(kmap,dtype=float); nside=hp.get_nside(arr)
        data=split.get('_data_coords') or []
        ra=np.asarray([c['ra'] for c in data], dtype=float); dec=np.asarray([c['dec'] for c in data], dtype=float)
        pix=hp.ang2pix(nside, np.radians(90-dec), np.radians(ra))
        kval=arr[pix]; finite=np.isfinite(kval)
        dens=np.asarray(split['_dens'])
        hi=np.asarray(split['_hi_mask']) & finite; lo=np.asarray(split['_lo_mask']) & finite
        if hi.sum()<20 or lo.sum()<20:
            return {'available': False, 'reason': 'too few finite high/low curl samples', 'hi': int(hi.sum()), 'lo': int(lo.sum())}
        delta=float(np.nanmean(kval[hi])-np.nanmean(kval[lo]))
        rng=np.random.default_rng(getattr(args,'seed',12345)+32032)
        label_null=[]
        for _ in range(256):
            d=dens[finite].copy(); rng.shuffle(d)
            lq,hq=np.quantile(d,[0.25,0.75]); kv=kval[finite]
            label_null.append(float(np.nanmean(kv[d>=hq])-np.nanmean(kv[d<=lq])))
        rotation_null=[]
        for shift in np.linspace(17,343,64):
            ra2=(ra+float(shift))%360.0
            pix2=hp.ang2pix(nside, np.radians(90-dec), np.radians(ra2))
            kv=arr[pix2]; ff=np.isfinite(kv)
            hh=np.asarray(split['_hi_mask']) & ff; ll=np.asarray(split['_lo_mask']) & ff
            if hh.sum()>20 and ll.sum()>20:
                rotation_null.append(float(np.nanmean(kv[hh])-np.nanmean(kv[ll])))
        def p_high(nulls):
            return sum(1 for x in nulls if x>=delta)/len(nulls) if nulls else None
        def percentile_abs(nulls):
            ad=abs(delta)
            return sum(1 for x in nulls if abs(x)<=ad)/len(nulls) if nulls else None
        return {
            'available': True,
            'coord_source': coord_src,
            'curl_delta': delta,
            'label_shuffle_n': len(label_null),
            'label_shuffle_p_high': p_high(label_null),
            'label_shuffle_abs_percentile': percentile_abs(label_null),
            'rotation_null_n': len(rotation_null),
            'rotation_p_high': p_high(rotation_null),
            'rotation_abs_percentile': percentile_abs(rotation_null),
            'curl_weakened_by_label_shuffle': bool(p_high(label_null) is not None and 0.05 < p_high(label_null) < 0.95),
            'curl_weakened_by_rotation': bool(p_high(rotation_null) is not None and 0.05 < p_high(rotation_null) < 0.95),
            'map_info': info,
        }
    except Exception as e:
        return {'available': False, 'error': str(e)[:300]}


def run_p30_maskrandom_freeze_v32(meta, args):
    base = _run_p30_v31_for_v32(meta, args)
    outputs = _v32_outputs_dir()
    same_obj, variants, same_path = _v32_same_split_artifact(base, outputs)
    sci, curl = _v32_science_and_curl(variants)
    basic = _v32_basic_curl_diagnostics(base, same_obj, variants)
    ratio_unc = _v32_ratio_uncertainty_from_bootstrap(base, basic.get('curl_delta'), basic.get('median_abs_science_delta'))
    subtract = _v32_curl_subtracted_diagnostics(sci, basic.get('curl_delta'))
    family = _v32_frequency_systematic_split(sci, basic.get('curl_delta'))
    heavy_controls = _v32_try_heavy_curl_controls(meta, args, same_obj.get('split') or {})

    # A curl remediation pass is intentionally stricter than a diagnostic ratio pass:
    # ratio must be weak, curl must not be significant in at least one independent permutation/rotation control,
    # and science should remain positive after conservative abs(curl) subtraction in at least two science variants.
    ratio_pass = bool(basic.get('curl_to_science_abs_ratio') is not None and basic.get('curl_to_science_abs_ratio') < 0.60)
    p_not_sig = bool(basic.get('curl_density_shuffle_p_high') is not None and 0.05 < basic.get('curl_density_shuffle_p_high') < 0.95)
    perm_pass = bool(heavy_controls.get('available') and (heavy_controls.get('curl_weakened_by_label_shuffle') or heavy_controls.get('curl_weakened_by_rotation')))
    sub_pass = bool(subtract.get('pass_suggestive_not_confirmatory'))
    remediation_pass = bool(ratio_pass and (p_not_sig or perm_pass) and sub_pass)

    curl_report = {
        'same_split_artifact_path': str(same_path),
        'basic': basic,
        'ratio_uncertainty': ratio_unc,
        'permutation_rotation_controls': heavy_controls,
        'curl_subtracted_science': subtract,
        'frequency_systematic_split': family,
        'remediation_pass': remediation_pass,
        'promotion_rule': 'P30-SDSS route may promote only if random route, same-split variants, bootstrap, and curl remediation pass; global P30 still needs a second route.',
    }
    _v32_write_json(outputs/'p30_curl_remediation_v32.json', curl_report)
    base['p30_curl_remediation_v32'] = curl_report

    # Keep v31 gate, add v32 route-specific candidate/confirm gate.
    near31 = base.get('p30_sdss_near_confirm_bucket_v31') or {}
    gate31 = base.get('p30_sdss_route_confirm_gate_v31') or {}
    random_route = bool(near31.get('random_normalized_route') or gate31.get('random_normalized_route'))
    same_split = bool(near31.get('same_split_science_variants') or gate31.get('same_split_science_variants'))
    jackknife = bool(near31.get('jackknife_stable') or gate31.get('jackknife_stable'))
    boot_gate = base.get('p30_sdss_bootstrap_ci_gate_v31') or {}
    boot_ok = bool(boot_gate.get('ci_excludes_zero_positive') or (base.get('p30_sdss_bootstrap_ci_v30') or {}).get('ci_excludes_zero_positive'))
    near = bool(random_route and same_split and jackknife and (boot_ok or ratio_pass))
    base['p30_sdss_route_status_v32'] = {
        'claim_label': 'P30-SDSS_route_confirm_like' if (random_route and same_split and jackknife and boot_ok and remediation_pass) else ('P30-SDSS_route_near_confirm_candidate' if near else 'P30-SDSS_route_diagnostic'),
        'near_confirm_candidate': near,
        'random_normalized_route': random_route,
        'same_split_science_variants': same_split,
        'jackknife_stable': jackknife,
        'bootstrap_ci_positive': boot_ok,
        'curl_remediation_pass': remediation_pass,
        'global_claim_allowed': False,
    }
    base['p30_sdss_route_confirm_gate_v32'] = _v32_gate(
        random_normalized_route=random_route,
        same_split_science_variants=same_split,
        jackknife_stable=jackknife,
        bootstrap_ci_positive=boot_ok,
        curl_remediation_pass=remediation_pass,
    )
    base['p30_global_confirm_gate_v32'] = _v32_gate(
        sdss_route_confirm=base['p30_sdss_route_confirm_gate_v32']['eligible_for_confirm_like'],
        second_independent_route=False,
    )
    base['p30_euclid_quarantine_or_repair_v32'] = {
        'quarantined_from_global_claim': True,
        'reason': 'Euclid remains negative/mixed; do not merge into global P30 until photo-z/depth/quality cuts and field randoms pass.',
        'required_to_rejoin_global_p30': ['photo_z_or_redshift_column','depth_or_quality_split','field_level_randoms','same_mask_as_sdss','random_normalized_positive_delta','jackknife_stable','same_split_variant_consistency'],
    }
    if base['p30_sdss_route_confirm_gate_v32']['eligible_for_confirm_like']:
        base['status'] = 'p30_sdss_route_confirm_like'
    elif near:
        base['status'] = 'density_kappa_sdss_route_near_confirm_candidate'
    return base


# v32 P36: keep v31 consumer but add an explicit source-specific parser manifest and stronger product hints.
def run_highz_unit_field_table_v32(meta, args):
    base = _run_highz_v31_for_v32(meta, args)
    outputs=_v32_outputs_dir(); cache=_v32_cache_dir(args)
    manifest={
        'required_object_schema': ['source','object_id','z','vrot_km_s','radius_kpc','a_m_s2','unit_provenance'],
        'source_specific_targets': {
            'KMOS3D/KGES': ['object catalogue FITS table with VROT/VCIRC/VMAX, radius_kpc/re_kpc, z/zspec'],
            'KROSS': ['integrated object catalogue, not velocity/sigma image maps'],
            'MOSDEF': ['kinematic catalogue rows with velocity and size'],
            'SAMI': ['galaxy kinematic catalogue rows with Vrot and effective radius'],
        },
        'rejected_column_families': ['SIG','SIGMA','VEL_PA','PA','ANGLE','INCLINATION','ERR','ERROR','IMAGE_HDU'],
        'candidate_products_seen': [],
    }
    for root in [outputs, cache]:
        if root.exists():
            for p in root.rglob('*'):
                s=str(p).lower()
                if p.is_file() and any(k in s for k in ['kmos','kges','kross','mosdef','sami','highz','p36']) and p.suffix.lower() in ['.json','.csv','.tsv','.txt','.fits','.fit','.fz']:
                    manifest['candidate_products_seen'].append(str(p))
                    if len(manifest['candidate_products_seen'])>=200: break
    _v32_write_json(outputs/'p36_highz_source_specific_parser_manifest_v32.json', manifest)
    base['highz_source_specific_parser_manifest_v32'] = {k:v for k,v in manifest.items() if k!='candidate_products_seen'} | {'n_candidate_products_seen': len(manifest['candidate_products_seen']), 'path': str(outputs/'p36_highz_source_specific_parser_manifest_v32.json')}
    gate = base.get('highz_objectlevel_confirm_gate_v31') or {}
    base['highz_objectlevel_confirm_gate_v32'] = _v32_gate(
        object_rows_ge_30=bool(gate.get('object_rows_ge_30')),
        two_sources=bool(gate.get('two_sources')),
        units_visible=bool(gate.get('units_visible')),
        median_above_local=bool(gate.get('median_above_local')),
        leave_one_source_stable=bool(gate.get('leave_one_source_stable')),
        source_specific_manifest=True,
    )
    if base['highz_objectlevel_confirm_gate_v32']['eligible_for_confirm_like']:
        base['status']='highz_a0_objectlevel_publication_confirm_like'
    return base


# v32 P41: add major-claim product contract and stricter likelihood gate.
def run_p41_structured_cp_v32(meta, args):
    base = _run_p41_v31_for_v32(meta, args)
    outputs=_v32_outputs_dir(); cache=_v32_cache_dir(args)
    fit = base.get('p41_wilson_sm_likelihood_v31') or {}
    delta=_v32_float(fit.get('delta_chi2_sm_minus_wilson'))
    contract={
        'required_columns': ['q2_low_or_q2','q2_high_optional','observable','value','error_or_total_error','cp_label','sm_prediction_or_loglike_sm','wilson_prediction_or_loglike_wilson'],
        'accepted_product_patterns': ['p41*wilson*.json/csv','lhcb*bsll*q2*.json/csv','b_anomaly*likelihood*.json/csv'],
        'current_delta_chi2_sm_minus_wilson': delta,
        'current_likelihood_present': bool(fit.get('likelihood_present')),
        'current_rows': fit.get('n_extracted_numeric_rows'),
        'candidate_files': fit.get('candidate_files') or [],
    }
    _v32_write_json(outputs/'p41_major_claim_contract_v32.json', contract)
    base['p41_major_claim_contract_v32'] = {k:v for k,v in contract.items() if k!='candidate_files'} | {'path': str(outputs/'p41_major_claim_contract_v32.json'), 'n_candidate_files': len(contract['candidate_files'])}
    oldgate=base.get('p41_major_claim_gate_v31') or {}
    base['p41_major_claim_gate_v32'] = _v32_gate(
        q2_numeric_rows=bool(oldgate.get('q2_numeric_rows')),
        cp_control_rows=bool(oldgate.get('cp_control_rows')),
        likelihood_values=bool(oldgate.get('likelihood_values')),
        wilson_sm_delta_chi2=bool(delta is not None and delta >= 4.0),
        cp_controls_null_or_weak=bool(oldgate.get('cp_controls_null_or_weak')),
        product_contract_present=True,
    )
    if base['p41_major_claim_gate_v32']['eligible_for_confirm_like']:
        base['status']='p41_wilson_likelihood_confirm_like'
    return base


# v32 P33: add measurement contract and optional simple alpha consumer from existing v31 accepted product.
def run_p33_density_bao_measured_scaffold_v32(meta, args):
    base = _run_p33_v31_for_v32(meta, args)
    outputs=_v32_outputs_dir()
    res=base.get('p33_density_split_alpha_result_v31') or {}
    accepted=res.get('accepted') if isinstance(res,dict) else None
    delta=_v32_float(res.get('delta_alpha_high_minus_low') if isinstance(res,dict) else None)
    contract={
        'required_measurement_outputs': ['alpha_high_density','alpha_low_density','delta_alpha_high_minus_low','covariance_method','density_label_shuffle_p','sky_shuffle_p','redshift_jackknife_stable'],
        'minimum_claim_rule': 'nonzero sign-stable delta_alpha with covariance and density-label/sky/redshift nulls',
        'current_measurement_present': bool(res.get('measurement_present') if isinstance(res,dict) else False),
        'current_delta_alpha_high_minus_low': delta,
        'accepted_source_file': (accepted or {}).get('_source_file') if isinstance(accepted,dict) else None,
    }
    _v32_write_json(outputs/'p33_alpha_measurement_contract_v32.json', contract)
    oldgate=base.get('p33_publication_confirm_gate_v31') or {}
    base['p33_alpha_measurement_contract_v32'] = contract | {'path': str(outputs/'p33_alpha_measurement_contract_v32.json')}
    base['p33_publication_confirm_gate_v32'] = _v32_gate(
        alpha_high_low_measured=bool(oldgate.get('alpha_high_low_measured')),
        covariance_ready=bool(oldgate.get('covariance_ready')),
        density_label_shuffle_pass=bool(oldgate.get('density_label_shuffle_pass')),
        sky_shuffle_pass=bool(oldgate.get('sky_shuffle_pass')),
        redshift_jackknife_stable=bool(oldgate.get('redshift_jackknife_stable')),
        delta_alpha_nonzero=bool(delta is not None and abs(delta)>0),
        measurement_contract_present=True,
    )
    if base['p33_publication_confirm_gate_v32']['eligible_for_confirm_like']:
        base['status']='p33_density_bao_alpha_confirm_like'
    return base


# v32 P32: add a minimal run contract that is explicit enough for next external execution.
def run_ringdown_strain_plan_v32(meta, args):
    base = _run_ringdown_v31_for_v32(meta, args)
    outputs=_v32_outputs_dir()
    contract={
        'minimal_events': ['GW150914','GW190521'],
        'required_products': ['strain_hdf5_or_gwf','psd_estimate_json','gr_ringdown_fit_json','ccdr_residual_fit_json','injection_null_json','detector_split_json','leave_one_event_out_json'],
        'recommended_command': 'python run_all.py --only P32 --allow-large --max-mb 5000 --script-timeout 2400',
        'promotion_rule': 'delta_chi2_gr_minus_ccdr > 0, injection_null_p <= 0.05, detector split and leave-one-event-out pass',
    }
    _v32_write_json(outputs/'p32_minimal_strain_run_contract_v32.json', contract)
    oldgate=base.get('ringdown_strain_confirm_gate_v31') or {}
    base['ringdown_minimal_strain_run_contract_v32'] = contract | {'path': str(outputs/'p32_minimal_strain_run_contract_v32.json')}
    base['ringdown_strain_confirm_gate_v32'] = _v32_gate(
        strain_downloaded=bool(oldgate.get('strain_downloaded')),
        psd_estimated=bool(oldgate.get('psd_estimated')),
        gr_ringdown_fit=bool(oldgate.get('gr_ringdown_fit')),
        ccdr_residual_template_fit=bool(oldgate.get('ccdr_residual_template_fit')),
        residual_improves_gr=bool(oldgate.get('residual_improves_gr')),
        injection_nulls=bool(oldgate.get('injection_nulls')),
        detector_split=bool(oldgate.get('detector_split')),
        leave_one_event_out=bool(oldgate.get('leave_one_event_out')),
        minimal_run_contract_present=True,
    )
    if base['ringdown_strain_confirm_gate_v32']['eligible_for_confirm_like']:
        base['status']='ringdown_strain_residual_confirm_like'
    return base


def run_dashboard_v32(meta,args):
    base = _run_dashboard_v31_for_v32(meta,args)
    outputs=_v32_outputs_dir(); rows=[]
    for p in sorted(outputs.glob('test*.json')):
        obj=_v32_read_json(p)
        if isinstance(obj,dict): rows.append(obj)
    instr=[]; p30=[]; pub=[]; blocked=[]
    for r in rows:
        keys=[k for k in r if k.endswith('_v32') or '_v32_' in k]
        if keys:
            instr.append({'test_id':r.get('test_id'), 'prediction_id':r.get('prediction_id'), 'status':r.get('status'), 'v32_keys':sorted(keys)})
        if r.get('p30_sdss_route_status_v32'):
            p30.append({'test_id':r.get('test_id'), 'status':r.get('status'), 'route_status':r.get('p30_sdss_route_status_v32'), 'curl': (r.get('p30_curl_remediation_v32') or {}).get('basic'), 'remediation_pass': (r.get('p30_curl_remediation_v32') or {}).get('remediation_pass')})
        st=str(r.get('status',''))
        if 'publication_confirm_like' in st or st in ['robust_confirm_like','void_morphology_publication_grade_confirm_like','p30_sdss_route_confirm_like']:
            pub.append({'test_id':r.get('test_id'), 'prediction_id':r.get('prediction_id'), 'status':st})
        for k,v in r.items():
            if isinstance(v,dict) and k.endswith('_gate_v32') and not v.get('eligible_for_confirm_like', True):
                blocked.append({'test_id':r.get('test_id'), 'prediction_id':r.get('prediction_id'), 'gate':k, 'missing':v.get('missing')})
    base['dashboard_v32']={
        'n_v32_instrumented_tests': len(instr),
        'v32_instrumented_tests': instr[:200],
        'publication_grade_confirm_like': pub,
        'p30_sdss_route_status': p30,
        'blocked_confirm_gates': blocked[:200],
        'claim_policy': 'v32 adds curl-remediation diagnostics. P30-SDSS can only promote route-specifically; global P30 still requires a second repaired route.',
    }
    base['status']='dashboard_positive_summary'
    return base


RUNNERS.update({
    'p30_maskrandom_freeze_v22': run_p30_maskrandom_freeze_v32,
    'highz_unit_field_table_v22': run_highz_unit_field_table_v32,
    'p41_structured_cp_v22': run_p41_structured_cp_v32,
    'p33_density_bao_measured_scaffold_v22': run_p33_density_bao_measured_scaffold_v32,
    'ringdown_strain_plan_v22': run_ringdown_strain_plan_v32,
    'dashboard_v22': run_dashboard_v32,
})
